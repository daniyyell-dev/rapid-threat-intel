let MSPProcessEgress = "64.236.54.139"; // legit - excluded
let lookback = 30d;
union isfuzzy=true
( DeviceNetworkEvents | where Timestamp > ago(lookback)
  | where RemoteIP in (IOC_IPs) or LocalIP in (IOC_IPs)
     or tolower(RemoteUrl) has_any (IOC_Domains)
  | extend Hit=iff(RemoteIP in (IOC_IPs),RemoteIP,RemoteUrl), Src="DeviceNetworkEvents"
  | project Timestamp, Src, DeviceName, ActionType, Hit, RemoteIP, RemotePort, RemoteUrl, InitiatingProcessFileName, InitiatingProcessCommandLine ),
( DeviceEvents | where Timestamp > ago(lookback) | where ActionType == "DnsQueryResponse"
  | extend q=tolower(tostring(parse_json(AdditionalFields).DnsQueryString))
  | where q has_any (IOC_Domains)
  | project Timestamp, Src="DnsQuery", DeviceName, ActionType, Hit=q, InitiatingProcessFileName ),
( DeviceFileEvents | where Timestamp > ago(lookback)
  | where SHA256 in (IOC_SHA256) or SHA1 in (IOC_SHA1)
     or FileName =~ "README_BYOD_31.txt" or FileName matches regex @"(?i)^README_BYOD_.*\.txt$"
     or FileName in~ ("tac_agent.py","run_tac.sh","solidity-langsupport-runner.service","com.solidity.langsupport.runner.plist","iph.dat","5b4c8fea5cbcee273e8d830f52-temfp.js")
     or (FolderPath has @"\System32\wbem\" and FileName in~ ("ncobjapi.dll","wbemcomn.dll"))
  | extend Hit=coalesce(SHA256,SHA1,FileName), Src="DeviceFileEvents"
  | project Timestamp, Src, DeviceName, ActionType, Hit, FileName, FolderPath, SHA1, SHA256, InitiatingProcessFileName ),
( DeviceProcessEvents | where Timestamp > ago(lookback)
  | where SHA256 in (IOC_SHA256) or SHA1 in (IOC_SHA1)
  | project Timestamp, Src="DeviceProcessEvents", DeviceName, ActionType, Hit=SHA256, FileName, FolderPath, ProcessCommandLine ),
( DeviceImageLoadEvents | where Timestamp > ago(lookback)
  | where SHA1 in (IOC_SHA1) or SHA256 in (IOC_SHA256)   // Turla Cereal loaders inside EdgeTransport/WmiPrvSE
  | project Timestamp, Src="DeviceImageLoadEvents", DeviceName, Hit=SHA1, FileName, FolderPath, InitiatingProcessFileName ),
( CloudAppEvents | where Timestamp > ago(lookback)
  | where IPAddress in (IOC_IPs)
  | project Timestamp, Src="CloudAppEvents", Hit=IPAddress, ActionType, Application, AccountDisplayName, AccountObjectId ),
( AADSignInEventsBeta | where Timestamp > ago(lookback)
  | where IPAddress in (IOC_IPs)
  | project Timestamp, Src="AADSignInEventsBeta", Hit=IPAddress, AccountUpn, Application, ApplicationId, ErrorCode, LogonType ),
( AADSpnSignInEventsBeta | where Timestamp > ago(lookback)
  | where IPAddress in (IOC_IPs)
  | project Timestamp, Src="AADSpnSignInEventsBeta", Hit=IPAddress, ServicePrincipalName, ServicePrincipalId, ApplicationId, ErrorCode )
| order by Timestamp desc
;
