// BYOD ransomware / extortion
// Defender XDR advanced hunting - last 30 days
let Domains = dynamic(["byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad.onion"]);
union isfuzzy=true
