``` Threat: Lazarus Operation FlashHole: CrossWeb EX Abuse, GitHub-Issue C2 and Post-Quantum LPEClient
    Author: Daniel Jeremiah | Date: 2026-11-12
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Lazarus-Operation-FlashHole-CrossWeb-EX ```
| multisearch
  [ search `rti_dns(pythonapischool.com OR javadevhouse.co.kr)`
    | search query IN ("pythonapischool.com", "*.pythonapischool.com", "javadevhouse.co.kr", "*.javadevhouse.co.kr")
    | rex field=query "(?i)(?<ioc>(?:pythonapischool\.com|javadevhouse\.co\.kr))\.?$"
    | eval data_model="dns", ioc_type="domain", host=src, detail="DNS query ".query
  ]
  [ search `rti_web(pythonapischool.com OR javadevhouse.co.kr OR cubedesign.co.kr OR fp-news.co.kr OR k-wbc.co.kr OR rcsh.co.kr OR www.ksog.org)`
    | search url IN ("*://pythonapischool.com*", "*.pythonapischool.com*", "pythonapischool.com*", "*://javadevhouse.co.kr*", "*.javadevhouse.co.kr*", "javadevhouse.co.kr*", "*pythonapischool.com/api/detach*", "*javadevhouse.co.kr/ajax/libs/jquery/1.7.3/jquery.min.js*", "*cubedesign.co.kr/news*", "*cubedesign.co.kr/mobile/fashion*", "*fp-news.co.kr/shop/cart*", "*k-wbc.co.kr/skin/social/social_view.php*", "*rcsh.co.kr/modules/bbs/tiles/bbs_div/inputForm.php*", "*www.ksog.org/insert_file/handle.php*") OR dest IN ("pythonapischool.com", "*.pythonapischool.com", "javadevhouse.co.kr", "*.javadevhouse.co.kr")
    | rex field=url "(?i)(?<ioc>pythonapischool\.com/api/detach|javadevhouse\.co\.kr/ajax/libs/jquery/1\.7\.3/jquery\.min\.js|cubedesign\.co\.kr/news|cubedesign\.co\.kr/mobile/fashion|fp\-news\.co\.kr/shop/cart|k\-wbc\.co\.kr/skin/social/social_view\.php|rcsh\.co\.kr/modules/bbs/tiles/bbs_div/inputForm\.php|www\.ksog\.org/insert_file/handle\.php|pythonapischool\.com|javadevhouse\.co\.kr)"
    | eval ioc=coalesce(ioc, dest), data_model="web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
  ]
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_endpoint((INISAFECrossWebEXSvc OR fsquirt))`
    | where match(coalesce(parent_process_name, ""), "(?i)^INISAFECrossWebEXSvc\.exe$") OR (match(coalesce(process_name, ""), "(?i)^fsquirt\.exe$") AND NOT match(coalesce(parent_process_name, ""), "(?i)^(explorer|svchost|fsquirt)\.exe$"))
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="CrossWeb EX service starting fsquirt or a shell", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((mscoree.dll OR ActivationStore.dat OR msadc.inc OR desktops.ini OR Package.txt OR Dell1.tmp OR Dell3.tmp))`
    | where match(coalesce(file_path, ""), "(?i)\\(System32|ProgramData)\\(RasConv|DrvConh|Apple|ssh|qorestor|Dell)\\(mscoree\.dll|ActivationStore\.dat|Dell[13]\.tmp)$|\\Common Files\\System\\msadc\\msadc\.inc$|^C:\\ProgramData\\(desktops\.ini|Package\.txt)$")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="FlashHole side-loading DLL or payload file in odd folders", ioc_type="behaviour (alert)"
]

| append [
    search index=* ("\\System32\\RasConv\\" OR "\\System32\\DrvConh\\") (EventCode=7045 OR EventCode=13 OR Services)
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="Windows System / Sysmon"
    | eval ioc="Service pointing into System32 RasConv or DrvConh", ioc_type="behaviour (alert)"
]

| append [
    search index=* ("api.github.com" OR "api.dropboxapi.com" OR "content.dropboxapi.com") (fsquirt OR rundll32 OR dllhost OR regsvr32 OR INISAFECrossWebEXSvc)
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="proxy / EDR network"
    | eval ioc="Non-browser process calling GitHub or Dropbox APIs", ioc_type="behaviour (hunt)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
