``` Threat: GSocket Linux Web-Server C2
    Author: Daniel Jeremiah | Date: 2026-11-12
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/GSocket-Linux-Web-Server-C2 ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Endpoint.Processes
    WHERE Processes.process_hash IN ("*d94f75a70b5cabaf786ac57177ed841732e62bdcc9a29e06e5b41d9be567bcfa*", "*f95c4d029e6784e3849b4d1e2e2ae1a661187236ef7c5d487c71158a290a03b5*", "*55d141bb2f62c527c3fea3413b8429fed7d52633d0b123b5e611bfa42165229f*", "*12450bafc7a4398040e1ad3a16dbf4dbc79b6a8f83ef306c4f0f73f59886f06c*")
    BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.process_hash
| rename "Processes.*" AS *
| rex field=process_hash "(?i)(?<ioc>d94f75a70b5cabaf786ac57177ed841732e62bdcc9a29e06e5b41d9be567bcfa|f95c4d029e6784e3849b4d1e2e2ae1a661187236ef7c5d487c71158a290a03b5|55d141bb2f62c527c3fea3413b8429fed7d52633d0b123b5e611bfa42165229f|12450bafc7a4398040e1ad3a16dbf4dbc79b6a8f83ef306c4f0f73f59886f06c)"
| eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="process ".process_path." (parent ".parent_process_name.")"
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_hash IN ("*d94f75a70b5cabaf786ac57177ed841732e62bdcc9a29e06e5b41d9be567bcfa*", "*f95c4d029e6784e3849b4d1e2e2ae1a661187236ef7c5d487c71158a290a03b5*", "*55d141bb2f62c527c3fea3413b8429fed7d52633d0b123b5e611bfa42165229f*", "*12450bafc7a4398040e1ad3a16dbf4dbc79b6a8f83ef306c4f0f73f59886f06c*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.parent_process_hash
    | rename "Processes.*" AS *
    | rex field=parent_process_hash "(?i)(?<ioc>d94f75a70b5cabaf786ac57177ed841732e62bdcc9a29e06e5b41d9be567bcfa|f95c4d029e6784e3849b4d1e2e2ae1a661187236ef7c5d487c71158a290a03b5|55d141bb2f62c527c3fea3413b8429fed7d52633d0b123b5e611bfa42165229f|12450bafc7a4398040e1ad3a16dbf4dbc79b6a8f83ef306c4f0f73f59886f06c)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="parent process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_hash IN ("*d94f75a70b5cabaf786ac57177ed841732e62bdcc9a29e06e5b41d9be567bcfa*", "*f95c4d029e6784e3849b4d1e2e2ae1a661187236ef7c5d487c71158a290a03b5*", "*55d141bb2f62c527c3fea3413b8429fed7d52633d0b123b5e611bfa42165229f*", "*12450bafc7a4398040e1ad3a16dbf4dbc79b6a8f83ef306c4f0f73f59886f06c*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action Filesystem.file_hash
    | rename "Filesystem.*" AS *
    | rex field=file_hash "(?i)(?<ioc>d94f75a70b5cabaf786ac57177ed841732e62bdcc9a29e06e5b41d9be567bcfa|f95c4d029e6784e3849b4d1e2e2ae1a661187236ef7c5d487c71158a290a03b5|55d141bb2f62c527c3fea3413b8429fed7d52633d0b123b5e611bfa42165229f|12450bafc7a4398040e1ad3a16dbf4dbc79b6a8f83ef306c4f0f73f59886f06c)"
    | eval data_model="Endpoint.Filesystem", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="file ".action." ".file_path
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*d94f75a70b5cabaf786ac57177ed841732e62bdcc9a29e06e5b41d9be567bcfa*", "*f95c4d029e6784e3849b4d1e2e2ae1a661187236ef7c5d487c71158a290a03b5*", "*55d141bb2f62c527c3fea3413b8429fed7d52633d0b123b5e611bfa42165229f*", "*12450bafc7a4398040e1ad3a16dbf4dbc79b6a8f83ef306c4f0f73f59886f06c*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>d94f75a70b5cabaf786ac57177ed841732e62bdcc9a29e06e5b41d9be567bcfa|f95c4d029e6784e3849b4d1e2e2ae1a661187236ef7c5d487c71158a290a03b5|55d141bb2f62c527c3fea3413b8429fed7d52633d0b123b5e611bfa42165229f|12450bafc7a4398040e1ad3a16dbf4dbc79b6a8f83ef306c4f0f73f59886f06c)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process="*gsocket.io*" Processes.parent_process_name IN ("nginx", "httpd", "apache2", "php-fpm", "php", "java", "node", "tomcat", "python", "python3")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Web server retrieving GSocket from gsocket.io", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_path="*/dev/shm/.gs-*" OR Filesystem.file_name IN ("gs-netcat_mini-linux-x86_64", "gs-netcat_mini-linux-aarch64", ".gsn_ora")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="GSocket staging under /dev/shm or .gsn_ora", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name IN ("systemd-remount-d", "defunct.service", "defunct")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="GSocket persistence as systemd-remount-d or defunct", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name IN ("systemd-remount-d", "defunct") OR Processes.process="*defunct.service*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="GSocket persistence as systemd-remount-d or defunct", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process="*exec -a*" OR Processes.process="*[kaluad]*" OR (Processes.process_name IN ("chmod", "touch") AND Processes.process IN ("*defunct*", "*systemd-remount-d*"))
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="exec -a [kaluad] or timestomp of defunct", ioc_type="behaviour (hunt)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
