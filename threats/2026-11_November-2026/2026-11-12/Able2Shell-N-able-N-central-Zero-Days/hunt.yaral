// Threat: Able2Shell N-able N-central Zero-Days
// Author: Daniel Jeremiah | Date: 2026-11-12
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Able2Shell-N-able-N-central-Zero-Days
rule rti_able2shell_n_able_n_central_zero_days {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-12"
    description = "Able2Shell N-able N-central Zero-Days"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Able2Shell-N-able-N-central-Zero-Days"

  events:
    (
      $e.principal.ip = /^(?:5\.231\.45\.175|157\.20\.241\.16|3\.74\.48\.121)$/ or
      $e.target.ip = /^(?:5\.231\.45\.175|157\.20\.241\.16|3\.74\.48\.121)$/ or
      $e.network.dns.answers.data = /^(?:5\.231\.45\.175|157\.20\.241\.16|3\.74\.48\.121)$/ or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:5\.231\.45\.175:8097/a\.dtd|5\.231\.45\.175:8097/svc\.xml)`) nocase or
      re.regex($e.target.url, `dms/services/ServerUI|dms2/services2/ServerMMS2`) nocase or
      re.regex($e.network.http.user_agent, `N-central-sec-audit/1\.0`) or
      re.regex($e.target.file.full_path, `n-central/tmp/serverchild-|n-central/flag/flag_default\.json|CodeDropMeta\.xml`) nocase or
      re.regex($e.target.file.full_path, `Windows Software Probe.*(wsp\.exe|service\.cfg)|CodeDropTmp|ServiceBackup.*wsp\.exe`) nocase or
      re.regex($e.target.process.command_line, `wsp\.exe|Windows Software Probe`) nocase and re.regex($e.principal.process.command_line, `.+\.cmd`) nocase or
      $e.target.ip = "157.20.241.16" or re.regex($e.target.process.command_line, `157\.20\.241\.16`) nocase
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $target_url = array_distinct($e.target.url)

  condition:
    $e

  options:
    allow_zero_values = true
}
