``` Threat: BBNet: Multi-Architecture Linux Botnet with Divergent Scanners
    Author: Daniel Jeremiah | Date: 2026-11-12
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/BBNet-Linux-Botnet-Multi-Arch-Scanners ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Endpoint.Processes
    WHERE Processes.process_name IN ("wget", "curl", "busybox", "toybox", "ftp", "tftp") AND Processes.process="*infect.sh*"
    BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
| rename "Processes.*" AS *
| eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
| eval ioc="CVE-2025-55182 or CVE-2026-24061 exploitation, or infect.sh fetch", ioc_type="behaviour (hunt)"

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process="*/etc/crontab*" OR Processes.process="*/etc/rc.local*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail="crontab or rc.local: ".process, data_model="Endpoint.Processes"
    | eval ioc="crontab or rc.local persistence launching .bbnet", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_path IN ("/etc/crontab", "/etc/rc.local")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="crontab or rc.local persistence launching .bbnet", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name IN (".bbnet", ".bbnet.new", ".bbnet_scan_on", ".bbnet_scan.stats", ".b", "infect.sh") OR Filesystem.file_path="*.bbnet*"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="Hidden .bbnet ELF drops and scanner state files", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
