``` Threat: BBNet: Multi-Architecture Linux Botnet with Divergent Scanners
    Author: Daniel Jeremiah | Date: 2026-11-12
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/BBNet-Linux-Botnet-Multi-Arch-Scanners ```
search `rti_endpoint(wget OR curl OR busybox OR toybox OR ftp OR tftp OR infect.sh)`
| where match(coalesce(process_name, ""), "(?i)^(wget|curl|busybox|toybox|ftp|tftp)$") AND match(coalesce(process, ""), "(?i)infect\.sh")
| eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
| eval data_model="endpoint"
| eval ioc="CVE-2025-55182 or CVE-2026-24061 exploitation, or infect.sh fetch", ioc_type="behaviour (hunt)"

| append [
    search `rti_endpoint(("/etc/crontab" OR "/etc/rc.local" OR ".bbnet"))`
    | where match(coalesce(process, ""), "/etc/crontab|/etc/rc\.local") AND match(coalesce(process, ""), "(?i)(\.bbnet|@reboot)")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="crontab or rc.local persistence launching .bbnet", ioc_type="behaviour (alert)"
]
| append [
    search `rti_endpoint(crontab OR rc.local OR bbnet)`
    | where match(coalesce(file_path, ""), "^/etc/(crontab|rc\.local)$")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="crontab or rc.local persistence launching .bbnet", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((".bbnet" OR "infect.sh"))`
    | where match(coalesce(file_path, file_name, ""), "(?i)(\.bbnet|infect\.sh)")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Hidden .bbnet ELF drops and scanner state files", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
