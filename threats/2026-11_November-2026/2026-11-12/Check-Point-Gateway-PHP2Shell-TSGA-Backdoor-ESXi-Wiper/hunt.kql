// Threat: PHP2Shell on Check Point Gateways: TSGA Backdoor, TSProxy and destroy_v6 ESXi Wiper
// Author: Daniel Jeremiah | Date: 2026-11-12
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Check-Point-Gateway-PHP2Shell-TSGA-Backdoor-ESXi-Wiper
let Lookback = 30d;
let IPs = dynamic(["130.94.19.204", "130.94.19.168"]);
let SHA256s = dynamic(["edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3", "4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8", "d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63", "3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90", "c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237", "0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7", "ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7", "fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da"]);
union isfuzzy=true
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " port ", RemotePort))),
  (DeviceLogonEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceLogonEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", LogonType, " ", AccountName))),
  (EntraIdSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSignInEvents", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (AADSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSignInEventsBeta", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (EntraIdSpnSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSpnSignInEvents", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (AADSpnSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSpnSignInEventsBeta", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(AccountDisplayName), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ActionType))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(ActionType, " ", FolderPath))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(FolderPath, " ", ProcessCommandLine))),
  (DeviceImageLoadEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceImageLoadEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(FolderPath, " loaded by ", InitiatingProcessFileName))),
  (EmailAttachmentInfo
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "EmailAttachmentInfo", Entity = tostring(RecipientEmailAddress), Indicator = tostring(SHA256), Context = tostring(strcat(FileName, " from ", SenderFromAddress))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FolderPath has "/CPcvpn-" and FolderPath has "/tmp/" and FileName startswith "sess_"
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(ActionType, " by ", InitiatingProcessFileName))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where (FileName matches regex @"^zz[A-Za-z0-9_-]*\.tpl$") or FileName =~ "challenge_render.tpl" or FolderPath == "/tmp/.up.tpl"
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(ActionType, " by ", InitiatingProcessFileName, " | ", InitiatingProcessCommandLine))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName in~ ("CPconfigdaemon", "slot_CPconfigdaemon") or ProcessCommandLine has_any ("/tmp/CPconfigdaemon", "/tmp/.bd.log", "slot_CPconfigdaemon")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | ", AccountName))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FolderPath in ("/lib/libcpfwcommon.so", "/tmp/.p_sock", "/tmp/.bd.log", "/tmp/CPconfigdaemon")
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(ActionType, " by ", InitiatingProcessFileName))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where ActionType == "ListeningConnectionCreated" and LocalPort == 11072
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(LocalPort), Context = tostring(strcat("listener on 11072 by ", InitiatingProcessFileName, " | ", InitiatingProcessCommandLine))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FileName =~ "DREAM_ANNEXATION.txt" or FolderPath == "/tmp/des" or FileName in~ ("destroy_v6", "destory_v6")
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(ActionType, " by ", InitiatingProcessFileName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName in~ ("gogo", "destroy_v6", "destory_v6") or ProcessCommandLine has_any ("/tmp/des ", "DREAM_ANNEXATION")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | ", AccountName)))
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Hits = count(), Context = take_any(Context) by SourceTable, Entity, Indicator
| order by LastSeen desc
