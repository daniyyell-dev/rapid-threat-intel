      $e.target.process.file.sha256 = /^(?:edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3|4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8|d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63|3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90|c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237|0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7|ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7|fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da)$/ nocase or
      $e.principal.process.file.sha256 = /^(?:edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3|4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8|d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63|3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90|c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237|0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7|ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7|fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da)$/ nocase or
      $e.principal.process.parent_process.file.sha256 = /^(?:edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3|4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8|d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63|3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90|c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237|0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7|ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7|fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da)$/ nocase or
      re.regex($e.target.file.full_path, `(^|/)zz[A-Za-z0-9_-]*\.tpl$|challenge_render\.tpl$|^/tmp/\.up\.tpl$`) nocase or
      re.regex($e.target.process.command_line, `CPconfigdaemon|/tmp/\.bd\.log`) nocase or
      re.regex($e.target.file.full_path, `DREAM_ANNEXATION\.txt$|^/tmp/des$|destr?oy_v6$`) nocase
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $file_sha256 = array_distinct($e.target.file.sha256)
    $process_sha256 = array_distinct($e.target.process.file.sha256)
    $process_path = array_distinct($e.target.process.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
