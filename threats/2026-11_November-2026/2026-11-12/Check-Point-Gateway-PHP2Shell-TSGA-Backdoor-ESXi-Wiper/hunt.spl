``` Threat: PHP2Shell on Check Point Gateways: TSGA Backdoor, TSProxy and destroy_v6 ESXi Wiper
    Author: Daniel Jeremiah | Date: 2026-11-12
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Check-Point-Gateway-PHP2Shell-TSGA-Backdoor-ESXi-Wiper ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("130.94.19.204", "130.94.19.168")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("130.94.19.204", "130.94.19.168")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_hash IN ("*edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3*", "*4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8*", "*d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63*", "*3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90*", "*c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237*", "*0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7*", "*ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7*", "*fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.process_hash
    | rename "Processes.*" AS *
    | rex field=process_hash "(?i)(?<ioc>edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3|4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8|d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63|3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90|c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237|0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7|ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7|fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_hash IN ("*edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3*", "*4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8*", "*d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63*", "*3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90*", "*c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237*", "*0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7*", "*ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7*", "*fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.parent_process_hash
    | rename "Processes.*" AS *
    | rex field=parent_process_hash "(?i)(?<ioc>edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3|4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8|d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63|3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90|c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237|0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7|ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7|fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="parent process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_hash IN ("*edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3*", "*4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8*", "*d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63*", "*3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90*", "*c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237*", "*0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7*", "*ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7*", "*fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action Filesystem.file_hash
    | rename "Filesystem.*" AS *
    | rex field=file_hash "(?i)(?<ioc>edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3|4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8|d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63|3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90|c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237|0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7|ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7|fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da)"
    | eval data_model="Endpoint.Filesystem", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="file ".action." ".file_path
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3*", "*4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8*", "*d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63*", "*3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90*", "*c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237*", "*0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7*", "*ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7*", "*fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>edb3e92eb7bda7413a09edcc4b1ba3cbed4bcdf42808a8abce63b6e4c3fda2b3|4171b521fa6441382aa2fa014a08e18ff9a6e0ab6096c9144072bf46b37a2ec8|d7549671c7189979f0624ec52dad9ea6a707d23146e3585ab8f8c4720eca0c63|3b51080a909023f7d484e2443740b572307ce0054eb9e32d98f0a06bfcd2db90|c7d9477309fac6c638a1128442056a242de086996add8cb49cd6496c36003237|0522937c0c0337be54fe25493539e5f5f8ceb9742c980aaff1cfc9515f3a96f7|ee16e1695711b9d60c62925fcfb2fe1a29c18ae26565bc05410a14e16d2a39d7|fb1a6235eb6bce8c9ec8cd8bb85f17c9c2bde8ecb45b7a243a30ceadf26654da)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_path="*/CPcvpn-*/tmp/*" Filesystem.file_name="sess_*"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="PHP2Shell session artefacts on the Mobile Access portal", ioc_type="behaviour (hunt)"
]

| append [
    search index=* ("Received =" OR "Rejected connection from unauthorized uid")
    | where match(_raw, "Rejected connection from unauthorized uid") OR (match(coalesce(source, "")." ".coalesce(_raw, ""), "(?i)dynamicCli|Received = #[0-9]+#") AND match(_raw, "Received =") AND NOT match(_raw, "CPprofile\\.sh >> /dev/null; export SP_DISTRIBUTE=0; set -o noglob;"))
    | eval host=host, user="-", src="-", dest=host, detail=substr(replace(_raw, "\\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="Gaia dynamicCli.log"
    | eval ioc="DynamicCLI root commands without the Clish wrapper (CVE-2026-123039)", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name IN ("zz*.tpl", "challenge_render.tpl", ".up.tpl")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="zz*.tpl webshells in the portal templates", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name IN ("CPconfigdaemon", "slot_CPconfigdaemon") OR Processes.process IN ("*/tmp/CPconfigdaemon*", "*/tmp/.bd.log*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="TSGA backdoor, TSProxy library or port 11072 listener", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_path IN ("/lib/libcpfwcommon.so", "/tmp/.p_sock", "/tmp/.bd.log", "/tmp/CPconfigdaemon")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="TSGA backdoor, TSProxy library or port 11072 listener", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name IN ("DREAM_ANNEXATION.txt", "destroy_v6", "destory_v6") OR Filesystem.file_path="/tmp/des"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="vpxuser SSH to ESXi and the destroy_v6 wiper", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
