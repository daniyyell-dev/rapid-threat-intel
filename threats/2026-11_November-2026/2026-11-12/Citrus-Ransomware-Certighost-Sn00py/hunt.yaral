// Threat: Citrus Ransomware: Certighost AD CS Exploitation, Xray VLESS Tunnels and Sn00py
// Author: Daniel Jeremiah | Date: 2026-11-12
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Citrus-Ransomware-Certighost-Sn00py
rule rti_citrus_ransomware_certighost_sn00py {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-12"
    description = "Citrus Ransomware: Certighost AD CS Exploitation, Xray VLESS Tunnels and Sn00py"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Citrus-Ransomware-Certighost-Sn00py"

  events:
    (
      $e.principal.ip = /^(?:91\.210\.109\.118|91\.210\.108\.180)$/ or
      $e.target.ip = /^(?:91\.210\.109\.118|91\.210\.108\.180)$/ or
      $e.network.dns.answers.data = /^(?:91\.210\.109\.118|91\.210\.108\.180)$/ or
      re.regex($e.target.process.command_line, `KasperskyGPO_Deploy|Deploy-KasperskyGPO|KasperskyAgentInstallTask|Kaspersky_GPO_Deployment|Java rpchost agent`) nocase or
      re.regex($e.target.process.file.full_path, `(?i)^C:\\ProgramData\\(xray|mst|sabycenter|webex|rpchost|2341|3777|jhost)\.exe$`) nocase or
      re.regex($e.target.file.full_path, `\.citrus$|CITRUS_README\.txt$`) nocase
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
