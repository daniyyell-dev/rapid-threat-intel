| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Resolution.DNS
    WHERE DNS.query IN ("vietnam852.com", "*.vietnam852.com", "site.vietnam852.com", "*.site.vietnam852.com", "ftp.vietnam852.com", "*.ftp.vietnam852.com", "server.vietnam852.com", "*.server.vietnam852.com", "swordaa.com", "*.swordaa.com")
    BY DNS.src DNS.dest DNS.query DNS.reply_code
| rename "DNS.*" AS *
| rex field=query "(?i)(?<ioc>(?:vietnam852\.com|site\.vietnam852\.com|ftp\.vietnam852\.com|server\.vietnam852\.com|swordaa\.com))\.?$"
| eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
