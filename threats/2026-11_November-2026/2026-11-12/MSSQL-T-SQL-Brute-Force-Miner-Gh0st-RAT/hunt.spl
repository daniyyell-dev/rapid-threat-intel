        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>site\.vietnam852\.com:88/ip\.php|site\.vietnam852\.com:88/down\.exe|vietnam852\.com|site\.vietnam852\.com|ftp\.vietnam852\.com|server\.vietnam852\.com|swordaa\.com)"
