// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/MSSQL-T-SQL-Brute-Force-Miner-Gh0st-RAT
rule rti_mssql_t_sql_brute_force_miner_gh0st_rat {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-12"
    description = "MSSQL T-SQL Brute-Force Campaign Delivering an XMRig Miner and Gh0st RAT"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/MSSQL-T-SQL-Brute-Force-Miner-Gh0st-RAT"

  events:
    (
      $e.network.dns.questions.name = /(?:^|\.)(?:vietnam852\.com|site\.vietnam852\.com|ftp\.vietnam852\.com|server\.vietnam852\.com|swordaa\.com)\.?$/ nocase or
      $e.target.hostname = /(?:^|\.)(?:vietnam852\.com|site\.vietnam852\.com|ftp\.vietnam852\.com|server\.vietnam852\.com|swordaa\.com)\.?$/ nocase or
      $e.target.domain.name = /(?:^|\.)(?:vietnam852\.com|site\.vietnam852\.com|ftp\.vietnam852\.com|server\.vietnam852\.com|swordaa\.com)\.?$/ nocase or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:site\.vietnam852\.com:88/ip\.php|site\.vietnam852\.com:88/down\.exe|(?:[^/?#@]*\.)?(?:vietnam852\.com|site\.vietnam852\.com|ftp\.vietnam852\.com|server\.vietnam852\.com|swordaa\.com)(?::\d+)?(?:[/?#]|$))`) nocase or
      $e.target.file.sha256 = /^(?:8ce2cd98ef6ceeece8239936e4aea042c41807f632cd691d5091705bf6c0076d|f5444e8e9e9e019693aacb363b7441ac0b8ecfe96a77fd94b9c312a017588eb4|2a0d2889241885d5ea6fe7dd1b1adc83653a0c07b8aaa1b0832e5f9c0225b379|79596cf6e267ef5cb658bd97d04e42a41001d36595e370441adb3c2b5dd5666c|e9d3fd9093c476b8b5de19aa00c50758568649def6491f54fa3e0aba4ea31ac9|124774698fd3ede0800015d19c2bd6c1869d03bbc2e6e8dbe2f69d2978f7f4d0|125d3a0efe7699bb20397c13f0f4993ad893952727487b4d190e386a5b14c427|20983573b840447e1aacd6d3f6dd240732b15037d268d6456f0d3c4ec5051cb0|58db0ca2054abe2989412d7a1c8ed16718577f893c196825c848fcd56c7e8f05|2a23e10bfc097e98295cbff8124bd403c4cb677e709b48ccc53d6aca216c3061|da4128aa5d006e05c58f0d240c2d8e5fb02774b6acf314f1230059c7a3498724|3f64b0146b323c5716043360e84384a5a197a897f46088df93a910470a29e1a0)$/ nocase or
      $e.target.process.file.sha256 = /^(?:8ce2cd98ef6ceeece8239936e4aea042c41807f632cd691d5091705bf6c0076d|f5444e8e9e9e019693aacb363b7441ac0b8ecfe96a77fd94b9c312a017588eb4|2a0d2889241885d5ea6fe7dd1b1adc83653a0c07b8aaa1b0832e5f9c0225b379|79596cf6e267ef5cb658bd97d04e42a41001d36595e370441adb3c2b5dd5666c|e9d3fd9093c476b8b5de19aa00c50758568649def6491f54fa3e0aba4ea31ac9|124774698fd3ede0800015d19c2bd6c1869d03bbc2e6e8dbe2f69d2978f7f4d0|125d3a0efe7699bb20397c13f0f4993ad893952727487b4d190e386a5b14c427|20983573b840447e1aacd6d3f6dd240732b15037d268d6456f0d3c4ec5051cb0|58db0ca2054abe2989412d7a1c8ed16718577f893c196825c848fcd56c7e8f05|2a23e10bfc097e98295cbff8124bd403c4cb677e709b48ccc53d6aca216c3061|da4128aa5d006e05c58f0d240c2d8e5fb02774b6acf314f1230059c7a3498724|3f64b0146b323c5716043360e84384a5a197a897f46088df93a910470a29e1a0)$/ nocase or
      $e.principal.process.file.sha256 = /^(?:8ce2cd98ef6ceeece8239936e4aea042c41807f632cd691d5091705bf6c0076d|f5444e8e9e9e019693aacb363b7441ac0b8ecfe96a77fd94b9c312a017588eb4|2a0d2889241885d5ea6fe7dd1b1adc83653a0c07b8aaa1b0832e5f9c0225b379|79596cf6e267ef5cb658bd97d04e42a41001d36595e370441adb3c2b5dd5666c|e9d3fd9093c476b8b5de19aa00c50758568649def6491f54fa3e0aba4ea31ac9|124774698fd3ede0800015d19c2bd6c1869d03bbc2e6e8dbe2f69d2978f7f4d0|125d3a0efe7699bb20397c13f0f4993ad893952727487b4d190e386a5b14c427|20983573b840447e1aacd6d3f6dd240732b15037d268d6456f0d3c4ec5051cb0|58db0ca2054abe2989412d7a1c8ed16718577f893c196825c848fcd56c7e8f05|2a23e10bfc097e98295cbff8124bd403c4cb677e709b48ccc53d6aca216c3061|da4128aa5d006e05c58f0d240c2d8e5fb02774b6acf314f1230059c7a3498724|3f64b0146b323c5716043360e84384a5a197a897f46088df93a910470a29e1a0)$/ nocase or
      $e.principal.process.parent_process.file.sha256 = /^(?:8ce2cd98ef6ceeece8239936e4aea042c41807f632cd691d5091705bf6c0076d|f5444e8e9e9e019693aacb363b7441ac0b8ecfe96a77fd94b9c312a017588eb4|2a0d2889241885d5ea6fe7dd1b1adc83653a0c07b8aaa1b0832e5f9c0225b379|79596cf6e267ef5cb658bd97d04e42a41001d36595e370441adb3c2b5dd5666c|e9d3fd9093c476b8b5de19aa00c50758568649def6491f54fa3e0aba4ea31ac9|124774698fd3ede0800015d19c2bd6c1869d03bbc2e6e8dbe2f69d2978f7f4d0|125d3a0efe7699bb20397c13f0f4993ad893952727487b4d190e386a5b14c427|20983573b840447e1aacd6d3f6dd240732b15037d268d6456f0d3c4ec5051cb0|58db0ca2054abe2989412d7a1c8ed16718577f893c196825c848fcd56c7e8f05|2a23e10bfc097e98295cbff8124bd403c4cb677e709b48ccc53d6aca216c3061|da4128aa5d006e05c58f0d240c2d8e5fb02774b6acf314f1230059c7a3498724|3f64b0146b323c5716043360e84384a5a197a897f46088df93a910470a29e1a0)$/ nocase
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $dns_query = array_distinct($e.network.dns.questions.name)
    $target_hostname = array_distinct($e.target.hostname)
    $target_url = array_distinct($e.target.url)
    $file_sha256 = array_distinct($e.target.file.sha256)
    $process_sha256 = array_distinct($e.target.process.file.sha256)
    $process_path = array_distinct($e.target.process.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
