// Threat: Silent Lynx Strix AI-Agent Espionage Against Tajikistan
// Author: Daniel Jeremiah | Date: 2026-11-12
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Silent-Lynx-Strix-AI-Agent-Espionage-Tajikistan
let Lookback = 30d;
let IPs = dynamic(["89.125.213.123", "134.17.14.24"]);
let Domains = dynamic(["foreverpeace.ru"]);
let Urls = dynamic(["http://89.125.213.123:8080/P.ps1", "http://89.125.213.123:8080/decoy.pdf"]);
let UrlKeys = dynamic(["89.125.213.123:8080/P.ps1", "89.125.213.123:8080/decoy.pdf"]);
let SHA256s = dynamic(["af2822560bc0e44b600eefbe0170d3526e035704b533a806f9d455da6ac30d2c", "f26756cabe92842e25d82bee5f65ef9c22c80aec895386b9840b471b42e01463", "e6907392677134a1a4ffec14d303471352eee90da09db1991eb47486611f2e0d", "27dc5628adc666da702c9a33e8f96bb87087ac68a7064f99b91fb76b932aef6e", "5d8a2df90fa3cf913e2b5764e586ee3405a101294909df091060bd3e3d1a44c1", "19b68e504e1512dc19feef6b1da0f67f876191a937fdcd64ffb965c12d1f0bf0", "bf7fe6b518676a3e6d40459ac16b491e62d0e0a222ebb243a44d64ac33aed826", "efc1bbb873e9b691657a66e987b0ea87c454bb16e89126d1a41bcaa9bae9fab1", "368cb250f7b962c551dd721f6f62224a936dd7cffb8e0d92f223d82b991a0e6d"]);
union isfuzzy=true
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " port ", RemotePort))),
  (DeviceLogonEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceLogonEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", LogonType, " ", AccountName))),
  (EntraIdSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSignInEvents", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (AADSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSignInEventsBeta", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (EntraIdSpnSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSpnSignInEvents", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (AADSpnSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSpnSignInEventsBeta", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(AccountDisplayName), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ActionType))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteUrl has_any (Domains)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteUrl), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " ", RemoteIP))),
  (DeviceEvents
    | where Timestamp > ago(Lookback)
    | where ActionType == "DnsQueryResponse" and tostring(parse_json(AdditionalFields).DnsQueryString) has_any (Domains)
    | project Timestamp, SourceTable = "DeviceEvents", Entity = tostring(DeviceName), Indicator = tostring(parse_json(AdditionalFields).DnsQueryString), Context = tostring(strcat("DNS ", InitiatingProcessFileName))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteUrl has_any (UrlKeys)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteUrl), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " ", RemoteIP))),
  (EmailUrlInfo
    | where Timestamp > ago(Lookback)
    | where UrlDomain has_any (Domains) or Url has_any (UrlKeys)
    | project Timestamp, SourceTable = "EmailUrlInfo", Entity = tostring(NetworkMessageId), Indicator = tostring(Url), Context = tostring("URL in email")),
  (UrlClickEvents
    | where Timestamp > ago(Lookback)
    | where Url has_any (Domains) or Url has_any (UrlKeys)
    | project Timestamp, SourceTable = "UrlClickEvents", Entity = tostring(AccountUpn), Indicator = tostring(Url), Context = tostring(strcat(ActionType, " ", Workload))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(ActionType, " ", FolderPath))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(FolderPath, " ", ProcessCommandLine))),
  (DeviceImageLoadEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceImageLoadEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(FolderPath, " loaded by ", InitiatingProcessFileName))),
  (EmailAttachmentInfo
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "EmailAttachmentInfo", Entity = tostring(RecipientEmailAddress), Indicator = tostring(SHA256), Context = tostring(strcat(FileName, " from ", SenderFromAddress))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName in~ ("powershell.exe", "pwsh.exe") and (ProcessCommandLine has_any ("P.ps1", "decoy.pdf", "amsiInitFailed", "89.125.213.123") or (InitiatingProcessFileName =~ "explorer.exe" and ProcessCommandLine has_any ("-w hidden", "-WindowStyle Hidden", "-win hidden") and ProcessCommandLine has_any ("DownloadString", "Net.WebClient", "iwr ", "Invoke-WebRequest", "irm ")))
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | ", AccountName))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemotePort == 46125 and InitiatingProcessFileName in~ ("powershell.exe", "pwsh.exe")
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(InitiatingProcessFileName, " to port ", tostring(RemotePort), " | ", InitiatingProcessCommandLine))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName in~ ("srvdriv.exe", "ssdpdrv.exe", "netsrvc.exe", "ssdspsrv.exe", "CoreMessaging.exe") or ProcessCommandLine has_any ("srvdriv", "ssdpdrv", "netsrvc", "ssdspsrv", "CoreMessaging.exe")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(FolderPath, " | ", ProcessCommandLine, " | SHA256 ", SHA256))),
  (DeviceRegistryEvents
    | where Timestamp > ago(Lookback)
    | where RegistryKey has @"\CurrentControlSet\Services\" and (RegistryKey has_any ("srvdriv", "ssdpdrv", "netsrvc", "ssdspsrv") or RegistryValueData has_any ("srvdriv.exe", "ssdpdrv.exe", "netsrvc.exe", "ssdspsrv.exe", "CoreMessaging.exe"))
    | project Timestamp, SourceTable = "DeviceRegistryEvents", Entity = tostring(DeviceName), Indicator = tostring(RegistryKey), Context = tostring(strcat(ActionType, " ", RegistryValueName, " = ", RegistryValueData, " | by ", InitiatingProcessFileName))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FileName endswith ".war" and FolderPath has "webapps" and ActionType in ("FileCreated", "FileRenamed", "FileModified")
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(ActionType, " by ", InitiatingProcessFileName, " ", InitiatingProcessCommandLine))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName in~ ("java", "java.exe") and (InitiatingProcessCommandLine has_any ("geoserver", "catalina", "tomcat")) and FileName in~ ("sh", "bash", "dash", "curl", "wget", "nc", "ncat", "python", "python3", "perl", "cmd.exe", "powershell.exe")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | ", AccountName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName in~ ("postgres", "postmaster", "postgres.exe") and FileName in~ ("sh", "bash", "dash", "nc", "ncat", "netcat", "curl", "wget", "python", "python3", "perl", "socat", "cmd.exe", "powershell.exe")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | ", AccountName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName in~ ("cron", "crond", "anacron") and (ProcessCommandLine has_any ("/dev/tcp/", "89.125.213.123", "134.17.14.24", "foreverpeace.ru") or (FileName in~ ("nc", "ncat", "socat") and ProcessCommandLine has " -e "))
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | ", AccountName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName in~ ("fscan.exe", "fscan", "nxc.exe", "nxc", "netexec", "Inveigh.exe", "gost.exe", "gost", "ligolo-agent", "ligolo-agent.exe") or ProcessCommandLine has_any ("Invoke-Inveigh", "Responder.py", "ligolo", "fscan ", "nxc smb", "netexec smb")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | ", AccountName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName in~ ("whoami.exe", "hostname.exe", "ipconfig.exe") and InitiatingProcessFileName in~ ("powershell.exe", "pwsh.exe") and InitiatingProcessCommandLine has_any ("Net.Sockets.TCPClient", "GetStream", "P.ps1")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(InitiatingProcessFileName, " > ", ProcessCommandLine, " | ", AccountName))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteUrl has_any ("openrouter.ai", "api.deepseek.com", "generativelanguage.googleapis.com") and not(InitiatingProcessFileName in~ ("chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe", "iexplore.exe", "safari", "chrome", "firefox", "Telegram.exe", "Telegram"))
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteUrl), Context = tostring(strcat(InitiatingProcessFileName, " | ", InitiatingProcessAccountName, " | ", InitiatingProcessCommandLine))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteUrl has "api.telegram.org" and not(InitiatingProcessFileName in~ ("chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe", "iexplore.exe", "safari", "chrome", "firefox", "Telegram.exe", "Telegram"))
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteUrl), Context = tostring(strcat(InitiatingProcessFileName, " | ", InitiatingProcessAccountName, " | ", InitiatingProcessCommandLine))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FolderPath has "/.hermes/" or FolderPath has @"\.hermes\"
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(ActionType, " by ", InitiatingProcessFileName)))
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Hits = count(), Context = take_any(Context) by SourceTable, Entity, Indicator
| order by LastSeen desc
