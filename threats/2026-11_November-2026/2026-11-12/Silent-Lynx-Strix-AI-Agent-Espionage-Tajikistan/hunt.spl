        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_name IN ("postgres", "postmaster", "postgres.exe") Processes.process_name IN ("sh", "bash", "dash", "nc", "ncat", "netcat", "curl", "wget", "python", "python3", "perl", "socat", "cmd.exe", "powershell.exe")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
