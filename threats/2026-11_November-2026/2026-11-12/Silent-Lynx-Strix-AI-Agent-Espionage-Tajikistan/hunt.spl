        WHERE All_Traffic.dest_port=46125
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dvc
    | rename "All_Traffic.*" AS *
    | eval host=dvc, user="-", src=src_ip, dest=dest_ip, detail="connection to port 46125", data_model="Network_Traffic"
    | eval ioc="LNK lure starting hidden PowerShell or a shell to port 46125", ioc_type="behaviour (alert)"
]

