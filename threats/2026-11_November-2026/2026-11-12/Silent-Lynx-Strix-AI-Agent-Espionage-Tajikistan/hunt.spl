]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*af2822560bc0e44b600eefbe0170d3526e035704b533a806f9d455da6ac30d2c*", "*f26756cabe92842e25d82bee5f65ef9c22c80aec895386b9840b471b42e01463*", "*e6907392677134a1a4ffec14d303471352eee90da09db1991eb47486611f2e0d*", "*27dc5628adc666da702c9a33e8f96bb87087ac68a7064f99b91fb76b932aef6e*", "*5d8a2df90fa3cf913e2b5764e586ee3405a101294909df091060bd3e3d1a44c1*", "*19b68e504e1512dc19feef6b1da0f67f876191a937fdcd64ffb965c12d1f0bf0*", "*bf7fe6b518676a3e6d40459ac16b491e62d0e0a222ebb243a44d64ac33aed826*", "*efc1bbb873e9b691657a66e987b0ea87c454bb16e89126d1a41bcaa9bae9fab1*", "*368cb250f7b962c551dd721f6f62224a936dd7cffb8e0d92f223d82b991a0e6d*") OR All_Email.url IN ("*89.125.213.123:8080/P.ps1*", "*89.125.213.123:8080/decoy.pdf*", "*://foreverpeace.ru*", "*.foreverpeace.ru*", "foreverpeace.ru*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>af2822560bc0e44b600eefbe0170d3526e035704b533a806f9d455da6ac30d2c|f26756cabe92842e25d82bee5f65ef9c22c80aec895386b9840b471b42e01463|e6907392677134a1a4ffec14d303471352eee90da09db1991eb47486611f2e0d|27dc5628adc666da702c9a33e8f96bb87087ac68a7064f99b91fb76b932aef6e|5d8a2df90fa3cf913e2b5764e586ee3405a101294909df091060bd3e3d1a44c1|19b68e504e1512dc19feef6b1da0f67f876191a937fdcd64ffb965c12d1f0bf0|bf7fe6b518676a3e6d40459ac16b491e62d0e0a222ebb243a44d64ac33aed826|efc1bbb873e9b691657a66e987b0ea87c454bb16e89126d1a41bcaa9bae9fab1|368cb250f7b962c551dd721f6f62224a936dd7cffb8e0d92f223d82b991a0e6d|89\.125\.213\.123:8080/P\.ps1|89\.125\.213\.123:8080/decoy\.pdf|foreverpeace\.ru)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name IN ("powershell.exe", "pwsh.exe") (Processes.process IN ("*P.ps1*", "*decoy.pdf*", "*amsiInitFailed*", "*89.125.213.123*") OR (Processes.parent_process_name="explorer.exe" Processes.process IN ("*-w hidden*", "*-WindowStyle Hidden*") Processes.process IN ("*DownloadString*", "*Net.WebClient*", "*Invoke-WebRequest*")))
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="LNK lure starting hidden PowerShell or a shell to port 46125", ioc_type="behaviour (alert)"
]
| append [
