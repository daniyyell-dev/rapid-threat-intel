// Threat: wfx: Hijacked GitHub Accounts Plant a CI Secret Stealer in Thousands of Repositories
// Author: Daniel Jeremiah | Date: 2026-11-12
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/GitHub-Hijacked-Accounts-wfx-CI-Secret-Stealer
rule rti_github_hijacked_accounts_wfx_ci_secret_stealer {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-12"
    description = "wfx: Hijacked GitHub Accounts Plant a CI Secret Stealer in Thousands of Repositories"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/GitHub-Hijacked-Accounts-wfx-CI-Secret-Stealer"

  events:
    (
      $e.principal.ip = /^(?:194\.150\.166\.244|18\.143\.168\.96|153\.75\.82\.159|193\.32\.204\.199)$/ or
      $e.target.ip = /^(?:194\.150\.166\.244|18\.143\.168\.96|153\.75\.82\.159|193\.32\.204\.199)$/ or
      $e.network.dns.answers.data = /^(?:194\.150\.166\.244|18\.143\.168\.96|153\.75\.82\.159|193\.32\.204\.199)$/ or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:194\.150\.166\.244:8080/exfil|18\.143\.168\.96:8080/exfil)`) nocase or
      $e.target.file.sha256 = /^(?:89695abb392d5cfd4972672961e644bb46baa98aa1ed7173c2a2816c762735cf)$/ nocase or
      $e.target.process.file.sha256 = /^(?:89695abb392d5cfd4972672961e644bb46baa98aa1ed7173c2a2816c762735cf)$/ nocase or
      $e.principal.process.file.sha256 = /^(?:89695abb392d5cfd4972672961e644bb46baa98aa1ed7173c2a2816c762735cf)$/ nocase or
      $e.principal.process.parent_process.file.sha256 = /^(?:89695abb392d5cfd4972672961e644bb46baa98aa1ed7173c2a2816c762735cf)$/ nocase or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and $e.target.process.command_line = /ci-[a-z0-9]+\.sh/) or
      ($e.metadata.log_type = "AWS_CLOUDTRAIL" and $e.metadata.product_event_type = /^(AssumeRoleWithWebIdentity|AssumeRole|CreateAccessKey|UpdateAssumeRolePolicy)$/ and
      ($e.principal.user.userid = /wfx-/ or $e.target.resource.name = /wfx-/))
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $target_url = array_distinct($e.target.url)
    $file_sha256 = array_distinct($e.target.file.sha256)
    $process_sha256 = array_distinct($e.target.process.file.sha256)
    $process_path = array_distinct($e.target.process.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
