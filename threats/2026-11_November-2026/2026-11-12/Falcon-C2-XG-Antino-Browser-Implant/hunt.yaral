// Threat: Falcon C2 (XG): Browser Framework and Antino Implant Targeting Government Webmail
// Author: Daniel Jeremiah | Date: 2026-11-12
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Falcon-C2-XG-Antino-Browser-Implant
rule rti_falcon_c2_xg_antino_browser_implant {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-12"
    description = "Falcon C2 (XG): Browser Framework and Antino Implant Targeting Government Webmail"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Falcon-C2-XG-Antino-Browser-Implant"

  events:
    (
      $e.network.dns.questions.name = /(?:^|\.)(?:fonts\.tarotfree101\.top|fonts\.chrorne\.com|robot\.avbliud\.com|microsoft\-flash\.com|wps\-cn\.com)\.?$/ nocase or
      $e.target.hostname = /(?:^|\.)(?:fonts\.tarotfree101\.top|fonts\.chrorne\.com|robot\.avbliud\.com|microsoft\-flash\.com|wps\-cn\.com)\.?$/ nocase or
      $e.target.domain.name = /(?:^|\.)(?:fonts\.tarotfree101\.top|fonts\.chrorne\.com|robot\.avbliud\.com|microsoft\-flash\.com|wps\-cn\.com)\.?$/ nocase or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:(?:[^/?#@]*\.)?(?:fonts\.tarotfree101\.top|fonts\.chrorne\.com|robot\.avbliud\.com|microsoft\-flash\.com|wps\-cn\.com)(?::\d+)?(?:[/?#]|$))`) nocase or
