    | rex field=matched "(?i)(?<ioc>3e535d63af8a95221fb517fa1b3e4a0029d3463d8b767443abdff385ee8cb6e9|f8b86238e179d88a9979b6f97750a39dda1d07b54d634bc1348fdfb0944a3b92|88e8b07bdf294ace0357d35acb7e108c66ba65a2c4ad66351fb8f7806dae0862|065d18fcfeddbd718c054f4b21c3cde5b9291db921d01f343d7ac0d4b41f29ce|3eab406d841fa22a4b0200c95c1afab068347f835400d5771e8de60aef732016|5711586125909863b91c1b5ff7cf70ef5d35249d67b11d7a23dc864405cddfe2|b6a7be724871ed3e81c986b74d62da8911c82a336c4c1857b35f2446b2d49fda|2ed834d92bfefc9d07a9f1a48f986974ae2a29669029f8163a1f6e8706388fcd|356b96c2267c5f2d8c07693643626e090b6389318b4ffa74699fa1732da5a00c|32af8413cbd38ce8beb257288cb8e6aa2f9b781d56d0f5272bffbcdc22d999f4|e2b6b1becdbcc340121e163b5afdfc5437a480ca132248ed5c7c309c45ac3dbb|265c2b36060e4b21c25aa86a8bb22d1db5f806117b484774c75c65b5b38222e0|66e9098551a1c0c74077d6cf55570e5d307a4a5ef0b0f2053e139394e61c442d|3e923f11db08413fca8a3a69d33d8896cfd56309e5179e8604d7fb7110428da2|2ebe36f1322b77264a33fded81cd4b8817f93362945070bf0bb5845dd27c0575|857429faffe0e0747ce299e86eed063ed781b4e403b917ca7e853e89bedf072c|b33f2e95943e3ff0a72dea1be9fdea03d986bada4def34f6991b3113ec161ad7|898656c33effb51e109c548fc213f157f151a870ea64a4601eda74ae75bd3af6|b3d8ea89b19a87bf2fdd63127086681059f41d67b6e5f8c939f5636a1b2315ce|24d69139cb2d32598f0f4983876f6320485fac134a66ade59cab76b50b4128f7|0c39264337a1186b2e765e24073399cbdcba118306614eb411e315887af578bd|fonts\.tarotfree101\.top|fonts\.chrorne\.com|robot\.avbliud\.com|microsoft\-flash\.com|wps\-cn\.com)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_path="*mbidcmlcbgbphpoacojjbmfpohcimjji*"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="Malicious Falcon Chrome extension ID", ioc_type="behaviour (alert)"
]
| append [
    search index=* mbidcmlcbgbphpoacojjbmfpohcimjji
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="browser extension inventory and registry logs"
    | eval ioc="Malicious Falcon Chrome extension ID", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_path="*\\Windows GatherOSStateKit*" OR Filesystem.file_name="DllSafeCheck64.dll"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="Antino GatherOSStateKit persistence folder", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process="*Windows GatherOSStateKit*" OR Processes.process_path="*\\Windows GatherOSStateKit*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Antino GatherOSStateKit persistence folder", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_name="sdiagnhost.exe" Processes.process_name IN ("powershell.exe", "pwsh.exe", "cmd.exe")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="sdiagnhost used to add an Antino Run key", ioc_type="behaviour (hunt)"
]

| append [
    search index=* ("antino/heartbeat" OR "antino/antino_upload")
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="OneDrive, Microsoft Graph and Cloud App logs"
    | eval ioc="Antino OneDrive heartbeat or upload paths", ioc_type="behaviour (hunt)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
