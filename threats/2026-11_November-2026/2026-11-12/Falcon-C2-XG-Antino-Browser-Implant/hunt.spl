| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Resolution.DNS
    WHERE DNS.query IN ("fonts.tarotfree101.top", "*.fonts.tarotfree101.top", "fonts.chrorne.com", "*.fonts.chrorne.com", "robot.avbliud.com", "*.robot.avbliud.com", "microsoft-flash.com", "*.microsoft-flash.com", "wps-cn.com", "*.wps-cn.com")
    BY DNS.src DNS.dest DNS.query DNS.reply_code
| rename "DNS.*" AS *
| rex field=query "(?i)(?<ioc>(?:fonts\.tarotfree101\.top|fonts\.chrorne\.com|robot\.avbliud\.com|microsoft\-flash\.com|wps\-cn\.com))\.?$"
| eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
