    | eval data_model="endpoint", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, detail=coalesce(process, file_path)
  ]
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_endpoint(mbidcmlcbgbphpoacojjbmfpohcimjji)`
    | where match(coalesce(file_path, file_name, ""), "mbidcmlcbgbphpoacojjbmfpohcimjji")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Malicious Falcon Chrome extension ID", ioc_type="behaviour (alert)"
]
| append [
    search index=* mbidcmlcbgbphpoacojjbmfpohcimjji
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="raw events"
    | eval ioc="Malicious Falcon Chrome extension ID", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(GatherOSStateKit OR DllSafeCheck64.dll)`
    | where match(coalesce(file_path, file_name, ""), "(?i)Windows GatherOSStateKit|DllSafeCheck64\.dll")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Antino GatherOSStateKit persistence folder", ioc_type="behaviour (alert)"
]
| append [
    search `rti_endpoint(GatherOSStateKit)`
    | where match(coalesce(process, process_path, ""), "(?i)Windows GatherOSStateKit")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Antino GatherOSStateKit persistence folder", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(sdiagnhost.exe)`
    | where match(coalesce(parent_process_name, ""), "(?i)^sdiagnhost\.exe$") AND match(coalesce(process_name, ""), "(?i)^(powershell|pwsh|cmd)\.exe$")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="sdiagnhost used to add an Antino Run key", ioc_type="behaviour (hunt)"
]

| append [
    search index=* ("antino/heartbeat" OR "antino/antino_upload")
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="OneDrive, Microsoft Graph and Cloud App logs"
    | eval ioc="Antino OneDrive heartbeat or upload paths", ioc_type="behaviour (hunt)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
