``` Threat: Falcon C2 (XG): Browser Framework and Antino Implant Targeting Government Webmail
    Author: Daniel Jeremiah | Date: 2026-11-12
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/Falcon-C2-XG-Antino-Browser-Implant ```
| multisearch
  [ search `rti_dns(fonts.tarotfree101.top OR fonts.chrorne.com OR robot.avbliud.com OR microsoft-flash.com OR wps-cn.com)`
    | search query IN ("fonts.tarotfree101.top", "*.fonts.tarotfree101.top", "fonts.chrorne.com", "*.fonts.chrorne.com", "robot.avbliud.com", "*.robot.avbliud.com", "microsoft-flash.com", "*.microsoft-flash.com", "wps-cn.com", "*.wps-cn.com")
    | rex field=query "(?i)(?<ioc>(?:fonts\.tarotfree101\.top|fonts\.chrorne\.com|robot\.avbliud\.com|microsoft\-flash\.com|wps\-cn\.com))\.?$"
    | eval data_model="dns", ioc_type="domain", host=src, detail="DNS query ".query
  ]
  [ search `rti_web(fonts.tarotfree101.top OR fonts.chrorne.com OR robot.avbliud.com OR microsoft-flash.com OR wps-cn.com)`
    | search url IN ("*://fonts.tarotfree101.top*", "*.fonts.tarotfree101.top*", "fonts.tarotfree101.top*", "*://fonts.chrorne.com*", "*.fonts.chrorne.com*", "fonts.chrorne.com*", "*://robot.avbliud.com*", "*.robot.avbliud.com*", "robot.avbliud.com*", "*://microsoft-flash.com*", "*.microsoft-flash.com*", "microsoft-flash.com*", "*://wps-cn.com*", "*.wps-cn.com*", "wps-cn.com*") OR dest IN ("fonts.tarotfree101.top", "*.fonts.tarotfree101.top", "fonts.chrorne.com", "*.fonts.chrorne.com", "robot.avbliud.com", "*.robot.avbliud.com", "microsoft-flash.com", "*.microsoft-flash.com", "wps-cn.com", "*.wps-cn.com")
    | rex field=url "(?i)(?<ioc>fonts\.tarotfree101\.top|fonts\.chrorne\.com|robot\.avbliud\.com|microsoft\-flash\.com|wps\-cn\.com)"
    | eval ioc=coalesce(ioc, dest), data_model="web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
  ]
