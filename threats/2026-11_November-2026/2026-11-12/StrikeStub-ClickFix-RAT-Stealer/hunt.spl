``` Threat: StrikeStub: ClickFix PowerShell Dropper and Modular RAT/Stealer
    Author: Daniel Jeremiah | Date: 2026-11-12
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/StrikeStub-ClickFix-RAT-Stealer ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Resolution.DNS
    WHERE DNS.query IN ("squidscript.com", "*.squidscript.com", "spiraldirect.ch", "*.spiraldirect.ch")
    BY DNS.src DNS.dest DNS.query DNS.reply_code
| rename "DNS.*" AS *
| rex field=query "(?i)(?<ioc>(?:squidscript\.com|spiraldirect\.ch))\.?$"
| eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url IN ("*://squidscript.com*", "*.squidscript.com*", "squidscript.com*", "*://spiraldirect.ch*", "*.spiraldirect.ch*", "spiraldirect.ch*") OR Web.dest IN ("squidscript.com", "*.squidscript.com", "spiraldirect.ch", "*.spiraldirect.ch") OR Web.url IN ("*squidscript.com/Cloudflare.exe*"))
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>squidscript\.com/Cloudflare\.exe|squidscript\.com|spiraldirect\.ch)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.url IN ("*squidscript.com/Cloudflare.exe*", "*://squidscript.com*", "*.squidscript.com*", "squidscript.com*", "*://spiraldirect.ch*", "*.spiraldirect.ch*", "spiraldirect.ch*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>squidscript\.com/Cloudflare\.exe|squidscript\.com|spiraldirect\.ch)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_name="explorer.exe" AND Processes.process_name="powershell.exe" AND (Processes.process="*-w hidden*" OR Processes.process="*-WindowStyle Hidden*") AND (Processes.process="*iwr*" OR Processes.process="*irm*" OR Processes.process="*Invoke-WebRequest*" OR Processes.process="*Invoke-RestMethod*") AND (Processes.process="*svc.exe*" OR Processes.process="*Cloudflare.exe*" OR Processes.process="*squidscript.com*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="explorer.exe launching hidden PowerShell to drop svc.exe", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="RuntimeBroker.exe" AND NOT Processes.process_path="*\Windows\System32\*" AND NOT Processes.process_path="*\Windows\SysWOW64\*" AND NOT Processes.process_path="*\WinSxS\*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="RuntimeBroker.exe running outside System32", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Registry
        WHERE Registry.registry_path="*CurrentVersion\Run*" AND Registry.registry_value_data="*WindowsUpdate.exe*"
        BY Registry.dest Registry.user Registry.registry_path Registry.registry_value_name Registry.registry_value_data
    | rename "Registry.*" AS *
    | eval host=dest, src="-", detail=registry_path." ".registry_value_name."=".registry_value_data, data_model="Endpoint.Registry"
    | eval ioc="WindowsUpdate.exe Run-key and Startup persistence", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name="WindowsUpdate.exe" AND (Filesystem.file_path="*\Start Menu\Programs\Startup*" OR Filesystem.file_path="*\Programs\Startup*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="WindowsUpdate.exe Run-key and Startup persistence", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE Web.http_user_agent="*StrikeStub/1.0*"
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | eval host=dest, detail="HTTP ".status." ".url." UA: ".http_user_agent, data_model="Web"
    | eval ioc="WebSocket C2 with user agent StrikeStub/1.0", ioc_type="behaviour (hunt)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name="keylog_*.txt"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="HVNC, dated keylog files or DPAPI browser theft", ioc_type="behaviour (hunt)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
