``` Threat: BITTER PapRAT and WmRAT: ftp.exe, VHDX and WebDAV MSI Espionage Chains
    Author: Daniel Jeremiah | Date: 2026-11-12
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/BITTER-PapRAT-WmRAT-South-Asia-Espionage ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Resolution.DNS
    WHERE DNS.query IN ("netmansrvdns.com", "*.netmansrvdns.com", "rappellingaart.com", "*.rappellingaart.com", "techtalkhelp.com", "*.techtalkhelp.com", "rivingtonclarks.com", "*.rivingtonclarks.com", "goodnfortunes.com", "*.goodnfortunes.com", "felixfuturenext.com", "*.felixfuturenext.com", "gomescareerplans.com", "*.gomescareerplans.com", "chestergreenfarming.com", "*.chestergreenfarming.com")
    BY DNS.src DNS.dest DNS.query DNS.reply_code
| rename "DNS.*" AS *
| rex field=query "(?i)(?<ioc>(?:netmansrvdns\.com|rappellingaart\.com|techtalkhelp\.com|rivingtonclarks\.com|goodnfortunes\.com|felixfuturenext\.com|gomescareerplans\.com|chestergreenfarming\.com))\.?$"
| eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url IN ("*://netmansrvdns.com*", "*.netmansrvdns.com*", "netmansrvdns.com*", "*://rappellingaart.com*", "*.rappellingaart.com*", "rappellingaart.com*", "*://techtalkhelp.com*", "*.techtalkhelp.com*", "techtalkhelp.com*", "*://rivingtonclarks.com*", "*.rivingtonclarks.com*", "rivingtonclarks.com*", "*://goodnfortunes.com*", "*.goodnfortunes.com*", "goodnfortunes.com*", "*://felixfuturenext.com*", "*.felixfuturenext.com*", "felixfuturenext.com*", "*://gomescareerplans.com*", "*.gomescareerplans.com*", "gomescareerplans.com*", "*://chestergreenfarming.com*", "*.chestergreenfarming.com*", "chestergreenfarming.com*") OR Web.dest IN ("netmansrvdns.com", "*.netmansrvdns.com", "rappellingaart.com", "*.rappellingaart.com", "techtalkhelp.com", "*.techtalkhelp.com", "rivingtonclarks.com", "*.rivingtonclarks.com", "goodnfortunes.com", "*.goodnfortunes.com", "felixfuturenext.com", "*.felixfuturenext.com", "gomescareerplans.com", "*.gomescareerplans.com", "chestergreenfarming.com", "*.chestergreenfarming.com") OR Web.url IN ("*techtalkhelp.com/talk.log*", "*www.rivingtonclarks.com/beautiQuewonders/banaNa.php*", "*goodnfortunes.com/ucl.php*", "*felixfuturenext.com/Epistemological/*", "*gomescareerplans.com/docs*"))
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>techtalkhelp\.com/talk\.log|www\.rivingtonclarks\.com/beautiQuewonders/banaNa\.php|goodnfortunes\.com/ucl\.php|felixfuturenext\.com/Epistemological/|gomescareerplans\.com/docs|netmansrvdns\.com|rappellingaart\.com|techtalkhelp\.com|rivingtonclarks\.com|goodnfortunes\.com|felixfuturenext\.com|gomescareerplans\.com|chestergreenfarming\.com)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_hash IN ("*a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c*", "*e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b*", "*ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88*", "*569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33*", "*411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.process_hash
    | rename "Processes.*" AS *
    | rex field=process_hash "(?i)(?<ioc>a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c|e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b|ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88|569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33|411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_hash IN ("*a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c*", "*e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b*", "*ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88*", "*569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33*", "*411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.parent_process_hash
    | rename "Processes.*" AS *
    | rex field=parent_process_hash "(?i)(?<ioc>a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c|e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b|ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88|569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33|411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="parent process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_hash IN ("*a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c*", "*e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b*", "*ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88*", "*569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33*", "*411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action Filesystem.file_hash
    | rename "Filesystem.*" AS *
    | rex field=file_hash "(?i)(?<ioc>a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c|e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b|ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88|569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33|411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b)"
    | eval data_model="Endpoint.Filesystem", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="file ".action." ".file_path
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c*", "*e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b*", "*ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88*", "*569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33*", "*411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b*") OR All_Email.url IN ("*techtalkhelp.com/talk.log*", "*www.rivingtonclarks.com/beautiQuewonders/banaNa.php*", "*goodnfortunes.com/ucl.php*", "*felixfuturenext.com/Epistemological/*", "*gomescareerplans.com/docs*", "*://netmansrvdns.com*", "*.netmansrvdns.com*", "netmansrvdns.com*", "*://rappellingaart.com*", "*.rappellingaart.com*", "rappellingaart.com*", "*://techtalkhelp.com*", "*.techtalkhelp.com*", "techtalkhelp.com*", "*://rivingtonclarks.com*", "*.rivingtonclarks.com*", "rivingtonclarks.com*", "*://goodnfortunes.com*", "*.goodnfortunes.com*", "goodnfortunes.com*", "*://felixfuturenext.com*", "*.felixfuturenext.com*", "felixfuturenext.com*", "*://gomescareerplans.com*", "*.gomescareerplans.com*", "gomescareerplans.com*", "*://chestergreenfarming.com*", "*.chestergreenfarming.com*", "chestergreenfarming.com*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c|e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b|ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88|569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33|411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b|techtalkhelp\.com/talk\.log|www\.rivingtonclarks\.com/beautiQuewonders/banaNa\.php|goodnfortunes\.com/ucl\.php|felixfuturenext\.com/Epistemological/|gomescareerplans\.com/docs|netmansrvdns\.com|rappellingaart\.com|techtalkhelp\.com|rivingtonclarks\.com|goodnfortunes\.com|felixfuturenext\.com|gomescareerplans\.com|chestergreenfarming\.com)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_name="ftp.exe" Processes.process_name IN ("cmd.exe", "more.com", "conhost.exe")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="ftp.exe spawning cmd, then a scheduled task", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="schtasks.exe" Processes.process IN ("*MicrosoftUpdates\\updates*", "*BiosUpdates\\update*", "*err.log*", "*talk.log*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Fake update tasks piping a log file to cmd", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process="*--headless*" Processes.process="*more*" Processes.process IN ("*err.log*", "*talk.log*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Fake update tasks piping a log file to cmd", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="curl.exe" Processes.process IN ("*public\\music\\err.log*", "*programdata\\talk.log*", "*ucl.php*", "*abc.pdf*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="curl fetching commands into fake log files", ioc_type="behaviour (hunt)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="msiexec.exe" Processes.process="*@SSL*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="msiexec installing an MSI over WebDAV (@SSL)", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name IN ("bruzsvc.exe", "vnces.exe") OR (Processes.process_name="cmd.exe" Processes.process="*.msi*&*.xls*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="VHDX LNK running an MSI with a decoy spreadsheet", ioc_type="behaviour (hunt)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
