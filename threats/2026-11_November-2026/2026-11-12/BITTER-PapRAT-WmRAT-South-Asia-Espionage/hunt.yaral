// Threat: BITTER PapRAT and WmRAT: ftp.exe, VHDX and WebDAV MSI Espionage Chains
// Author: Daniel Jeremiah | Date: 2026-11-12
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/BITTER-PapRAT-WmRAT-South-Asia-Espionage
rule rti_bitter_paprat_wmrat_south_asia_espionage {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-12"
    description = "BITTER PapRAT and WmRAT: ftp.exe, VHDX and WebDAV MSI Espionage Chains"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-12/BITTER-PapRAT-WmRAT-South-Asia-Espionage"

  events:
    (
      $e.network.dns.questions.name = /(?:^|\.)(?:netmansrvdns\.com|rappellingaart\.com|techtalkhelp\.com|rivingtonclarks\.com|goodnfortunes\.com|felixfuturenext\.com|gomescareerplans\.com|chestergreenfarming\.com)\.?$/ nocase or
      $e.target.hostname = /(?:^|\.)(?:netmansrvdns\.com|rappellingaart\.com|techtalkhelp\.com|rivingtonclarks\.com|goodnfortunes\.com|felixfuturenext\.com|gomescareerplans\.com|chestergreenfarming\.com)\.?$/ nocase or
      $e.target.domain.name = /(?:^|\.)(?:netmansrvdns\.com|rappellingaart\.com|techtalkhelp\.com|rivingtonclarks\.com|goodnfortunes\.com|felixfuturenext\.com|gomescareerplans\.com|chestergreenfarming\.com)\.?$/ nocase or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:techtalkhelp\.com/talk\.log|www\.rivingtonclarks\.com/beautiQuewonders/banaNa\.php|goodnfortunes\.com/ucl\.php|felixfuturenext\.com/Epistemological/|gomescareerplans\.com/docs|(?:[^/?#@]*\.)?(?:netmansrvdns\.com|rappellingaart\.com|techtalkhelp\.com|rivingtonclarks\.com|goodnfortunes\.com|felixfuturenext\.com|gomescareerplans\.com|chestergreenfarming\.com)(?::\d+)?(?:[/?#]|$))`) nocase or
      $e.target.file.sha256 = /^(?:a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c|e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b|ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88|569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33|411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b)$/ nocase or
      $e.target.process.file.sha256 = /^(?:a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c|e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b|ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88|569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33|411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b)$/ nocase or
      $e.principal.process.file.sha256 = /^(?:a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c|e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b|ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88|569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33|411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b)$/ nocase or
      $e.principal.process.parent_process.file.sha256 = /^(?:a3081df333ca7f18bd90d10a45125ab5011dcf9d2806feae2935f09cab07da4c|e3992f8c945b0761242377cba32d91b0a390c7cecd79478439843d93e6d2b76b|ccefbdec2718d864d9d33c743aabfcef88a8d7904d1c598bfcf15cf5f3591c88|569a21b519aaac8c92f653d708ab6ef34e3f38ea967f47e041d1e2425f6a4b33|411c0b9a2f98b927d806a685faf0c1ab1005647b4816157008892347fb88546b)$/ nocase or
      re.regex($e.principal.process.file.full_path, `(^|[\\/])ftp\.exe$`) nocase and re.regex($e.target.process.file.full_path, `(cmd\.exe|more\.com|conhost\.exe)$`) nocase or
      re.regex($e.target.process.command_line, `MicrosoftUpdates.updates[0-9]+|BiosUpdates.update[0-9]+|headless.*more.*(err|talk)\.log`) nocase or
      re.regex($e.target.process.command_line, `msiexec.*@SSL`) nocase
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $dns_query = array_distinct($e.network.dns.questions.name)
    $target_hostname = array_distinct($e.target.hostname)
    $target_url = array_distinct($e.target.url)
    $file_sha256 = array_distinct($e.target.file.sha256)
    $process_sha256 = array_distinct($e.target.process.file.sha256)
    $process_path = array_distinct($e.target.process.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
