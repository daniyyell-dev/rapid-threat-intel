``` Threat: SignDrop: Public Windows CLFS Zero-Day for SYSTEM Privilege Escalation (Hunt Only)
    Author: Daniel Jeremiah | Date: 2026-11-13
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/SignDrop-Windows-CLFS-Zero-Day-SYSTEM-Privilege-Escalation ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Endpoint.Filesystem
    WHERE Filesystem.file_name="hid.dll" AND Filesystem.file_path="*\microsoft shared\ink\*"
    BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
| rename "Filesystem.*" AS *
| eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
| eval ioc="hid.dll written to or loaded from the ink folder", ioc_type="behaviour (alert)"

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_name="consent.exe" AND Processes.process_name IN ("conhost.exe", "cmd.exe", "powershell.exe", "pwsh.exe", "rundll32.exe")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="consent.exe starting a console or shell", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_path="*\SigDrop_*"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="Unmodified SignDrop proof-of-concept working folder", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
