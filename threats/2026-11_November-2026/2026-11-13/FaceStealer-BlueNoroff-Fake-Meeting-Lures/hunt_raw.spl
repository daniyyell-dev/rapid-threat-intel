  [ search `rti_endpoint(ca14040cc48fbc3b00ea5f74e891266128f7bb3058be400782c5b08436f7668a OR 57201b105d64ecf9050fa1fb9107a6be36761b221ae32d7eb23859ce74b68718 OR 1a9663641958e9e7c31cc621b85f22c77c20d1ace2cb0477c4d35e6c9675bb8e OR 540da969ed2a0d828e208c99f3afb4b0763a7076144e1b9edd6ca9c7db0dbeae)`
    | search file_hash IN ("*ca14040cc48fbc3b00ea5f74e891266128f7bb3058be400782c5b08436f7668a*", "*57201b105d64ecf9050fa1fb9107a6be36761b221ae32d7eb23859ce74b68718*", "*1a9663641958e9e7c31cc621b85f22c77c20d1ace2cb0477c4d35e6c9675bb8e*", "*540da969ed2a0d828e208c99f3afb4b0763a7076144e1b9edd6ca9c7db0dbeae*") OR process_hash IN ("*ca14040cc48fbc3b00ea5f74e891266128f7bb3058be400782c5b08436f7668a*", "*57201b105d64ecf9050fa1fb9107a6be36761b221ae32d7eb23859ce74b68718*", "*1a9663641958e9e7c31cc621b85f22c77c20d1ace2cb0477c4d35e6c9675bb8e*", "*540da969ed2a0d828e208c99f3afb4b0763a7076144e1b9edd6ca9c7db0dbeae*") OR parent_process_hash IN ("*ca14040cc48fbc3b00ea5f74e891266128f7bb3058be400782c5b08436f7668a*", "*57201b105d64ecf9050fa1fb9107a6be36761b221ae32d7eb23859ce74b68718*", "*1a9663641958e9e7c31cc621b85f22c77c20d1ace2cb0477c4d35e6c9675bb8e*", "*540da969ed2a0d828e208c99f3afb4b0763a7076144e1b9edd6ca9c7db0dbeae*")
    | eval matched=file_hash." ".process_hash." ".parent_process_hash
    | rex field=matched "(?i)(?<ioc>ca14040cc48fbc3b00ea5f74e891266128f7bb3058be400782c5b08436f7668a|57201b105d64ecf9050fa1fb9107a6be36761b221ae32d7eb23859ce74b68718|1a9663641958e9e7c31cc621b85f22c77c20d1ace2cb0477c4d35e6c9675bb8e|540da969ed2a0d828e208c99f3afb4b0763a7076144e1b9edd6ca9c7db0dbeae)"
    | eval data_model="endpoint", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, detail=coalesce(process, file_path)
  ]
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_endpoint(ReadToEnd)`
    | where match(coalesce(process, ""), "(?i)ReadToEnd") AND match(coalesce(process, ""), "(?i)iex|Invoke-Expression")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Pasted curl into PowerShell ReadToEnd and iex cradle", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint("update.ps1")`
    | where match(coalesce(process, ""), "(?i)update\.ps1") AND match(coalesce(process, ""), "(?i)UseBasicParsing|-ep bypass|-ExecutionPolicy Bypass")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="update.ps1 fetched to %TEMP% and run with -ep bypass", ioc_type="behaviour (alert)"
]

| append [
    search `rti_web(updatesdk)`
    | where match(coalesce(url, dest, ""), "(?i)(^|//)updatesdk\.")
    | eval host=dest, user=user, src=src, dest=dest, detail="HTTP ".coalesce(status, "-")." ".coalesce(url, "-")." UA: ".coalesce(http_user_agent, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="web"
    | eval ioc="Lookups for updatesdk.* or calendly.<lookalike> hosts", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((osacompile OR osascript OR "document.wflow"))`
    | where match(coalesce(process_name, ""), "(?i)^osa(compile|script)$") OR match(coalesce(process, ""), "(?i)Downloads.*document\.wflow")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="macOS curl into osacompile or Automator from Downloads", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((curl "-fsSL"))`
    | where match(coalesce(process, ""), "curl.*-fsSL.* -k.*bash|curl.* -k.*-fsSL.*bash")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Linux curl -fsSL -k piped to bash", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
