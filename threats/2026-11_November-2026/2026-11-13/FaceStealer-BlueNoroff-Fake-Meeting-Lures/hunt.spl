"shiabank.com*", "*://theworldofluck.site*", "*.theworldofluck.site*", "theworldofluck.site*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>ca14040cc48fbc3b00ea5f74e891266128f7bb3058be400782c5b08436f7668a|57201b105d64ecf9050fa1fb9107a6be36761b221ae32d7eb23859ce74b68718|1a9663641958e9e7c31cc621b85f22c77c20d1ace2cb0477c4d35e6c9675bb8e|540da969ed2a0d828e208c99f3afb4b0763a7076144e1b9edd6ca9c7db0dbeae|vip\.novaplayer\.online/view/7091322YJEemPZd0V5R4258BX3xe292n0|updatesdk\.novaplayer\.online/update\-winsdk\-18731628|updatesdk\.novaplayer\.online/update\-macsdk\-49661181|updatesdk\.novaplayer\.online/update\-linuxsdk\-06166443|docview\.ink/check/60046502686a7cjHHgIc|docview\.ink/check/7060005211mD1eCY8u09|calendly\.idcheck\.watch/DyPck|chromeupdate\.docdock\.online/check/32831766541X56zrQlC1|chromeupdate\.docdock\.online/check/3976671880i9937o3D8T|calendly\.docdock\.online/troubleshoot\-issue\-092267|calendly\.docdock\.online/uploads/2571422\?id=4NrwnhccbXvUAZM|uu01webzoom\.us|teams\.livemeet\.us|02live\.com\.co|02live\.us\.com|05live\.us\.com|live\-teams\.com\.co|me\-0live\.com|me\-live\.it\.com|me\-live\.online|me\-live\.xyz|microso1t\.com|ms\-live\.cc|ms\-live\.co\.com|ms\-live\.online|ms\-meet\.store|ms\-meeting\.co|ms\-meeting\.com\.co|ms\-meeting\.live|ms\-room\.online|ms\-teams\.co|ms\-teams\.in|protected\-view\.online|teams\-live\.cam|teams\-live\.com\.co|teams\-live\.com\.im|teams\-live\.eu\.com|teams\-live\.it\.com|teams\-live\.vip|teams\-live\.work|teams\-meet\.cc|teams\-meet\.cloud|teams\-meet\.co|teams\-meet\.com\.co|teams\-meet\.in|teams\-meeting\.co|teams\-meeting\.in|teams\-meets\.cc|teams\-meets\.com|teams\-meets\.in|teams\-meets\.online|teams\-meets\.us\.com|teams\-room\.us|teams02live\.com|teams02live\.us|teams02live\.us\.com|teams05live\.com|teams05live\.us\.com|teams06live\.com|teams07live\.com|teams0live\.com|teamscloud\.us\.com|teamslive\.cloud|teamslive\.us\.com|us02live\.co|us05cloud\.co|us05cloud\.com|us05cloud\.live|us09live\.us|web\-live\.com\.co|web\-live\.us|call\-in\.co|call\-in\.online|call\-live\.com|call\-on\.online|call\-room\.online|meet\-in\.co|meet\-on\.online|meet\-room\.online|meet\-room\.xyz|meeting\-on\.online|room\-live\.com|room\-meet\.us|room\-meet\.xyz|room\-on\.online|room\-on\.xyz|team\-meet\.xyz|web\-meet\.us|web\-teams\.us|novaplayer\.online|novaplayer\.xyz|videolan\.online|videolan\.store|videoviewer\.online|instantsecscan\.online|instantsecscan\.xyz|ipblock\.watch|scanmypc\.online|scanmypc\.xyz|securealliance\.xyz|securemypc\.life|securemypc\.xyz|ashnote\.blog|cloud\-docs\.online|cobolabs\.cloud|docsend\.space|notionshare\.online|agenda\.pw|idcheck\.watch|ipcheck\.watch|sealteam911\.online|theworldofluck\.online|docdock\.online|docsend\.blog|docsend\.site|docsend\.store|docview\.ink|docview\.pw|docview\.vip|mailview\.online|sealteam911\.com|shiabank\.com|theworldofluck\.site)"
