``` Threat: SANSAR: Linux GPU Cryptomining Toolkit with a Tor Orchestrator, Rootkit and Ethereum C2
    Author: Daniel Jeremiah | Date: 2026-11-13
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/SANSAR-Linux-GPU-Cryptomining-Toolkit ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Resolution.DNS
    WHERE DNS.query IN ("efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id.onion", "*.efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id.onion")
    BY DNS.src DNS.dest DNS.query DNS.reply_code
| rename "DNS.*" AS *
| rex field=query "(?i)(?<ioc>(?:efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id\.onion))\.?$"
| eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url IN ("*://efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id.onion*", "*.efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id.onion*", "efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id.onion*") OR Web.dest IN ("efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id.onion", "*.efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id.onion"))
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id\.onion)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_hash IN ("*00c9ac44291f83c72d54302e99d155a3e26d02225a3e516764d5833a99657c9e*", "*675c24728f87f7aa0fa07527027c95c24c246049c65eaef89270ab04ea50a180*", "*6ba1aa275e0e2826e8b48b36473539ca56cbdc41f429e539a45f8532b084d7a4*", "*df8ab6fd699e6ae90e63e9696bae8f01342708bafc2ed88af414337e4f237194*", "*96fc528ca5e7d1c2b3add5e31b8797cb126f704976c8fbeaecdbf0aa4309ad46*", "*acc706afc9322a3eae1ef49049749e0a7c9f1a123895ac56dc8a289beb2fb5b7*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.process_hash
    | rename "Processes.*" AS *
    | rex field=process_hash "(?i)(?<ioc>00c9ac44291f83c72d54302e99d155a3e26d02225a3e516764d5833a99657c9e|675c24728f87f7aa0fa07527027c95c24c246049c65eaef89270ab04ea50a180|6ba1aa275e0e2826e8b48b36473539ca56cbdc41f429e539a45f8532b084d7a4|df8ab6fd699e6ae90e63e9696bae8f01342708bafc2ed88af414337e4f237194|96fc528ca5e7d1c2b3add5e31b8797cb126f704976c8fbeaecdbf0aa4309ad46|acc706afc9322a3eae1ef49049749e0a7c9f1a123895ac56dc8a289beb2fb5b7)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_hash IN ("*00c9ac44291f83c72d54302e99d155a3e26d02225a3e516764d5833a99657c9e*", "*675c24728f87f7aa0fa07527027c95c24c246049c65eaef89270ab04ea50a180*", "*6ba1aa275e0e2826e8b48b36473539ca56cbdc41f429e539a45f8532b084d7a4*", "*df8ab6fd699e6ae90e63e9696bae8f01342708bafc2ed88af414337e4f237194*", "*96fc528ca5e7d1c2b3add5e31b8797cb126f704976c8fbeaecdbf0aa4309ad46*", "*acc706afc9322a3eae1ef49049749e0a7c9f1a123895ac56dc8a289beb2fb5b7*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.parent_process_hash
    | rename "Processes.*" AS *
    | rex field=parent_process_hash "(?i)(?<ioc>00c9ac44291f83c72d54302e99d155a3e26d02225a3e516764d5833a99657c9e|675c24728f87f7aa0fa07527027c95c24c246049c65eaef89270ab04ea50a180|6ba1aa275e0e2826e8b48b36473539ca56cbdc41f429e539a45f8532b084d7a4|df8ab6fd699e6ae90e63e9696bae8f01342708bafc2ed88af414337e4f237194|96fc528ca5e7d1c2b3add5e31b8797cb126f704976c8fbeaecdbf0aa4309ad46|acc706afc9322a3eae1ef49049749e0a7c9f1a123895ac56dc8a289beb2fb5b7)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="parent process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_hash IN ("*00c9ac44291f83c72d54302e99d155a3e26d02225a3e516764d5833a99657c9e*", "*675c24728f87f7aa0fa07527027c95c24c246049c65eaef89270ab04ea50a180*", "*6ba1aa275e0e2826e8b48b36473539ca56cbdc41f429e539a45f8532b084d7a4*", "*df8ab6fd699e6ae90e63e9696bae8f01342708bafc2ed88af414337e4f237194*", "*96fc528ca5e7d1c2b3add5e31b8797cb126f704976c8fbeaecdbf0aa4309ad46*", "*acc706afc9322a3eae1ef49049749e0a7c9f1a123895ac56dc8a289beb2fb5b7*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action Filesystem.file_hash
    | rename "Filesystem.*" AS *
    | rex field=file_hash "(?i)(?<ioc>00c9ac44291f83c72d54302e99d155a3e26d02225a3e516764d5833a99657c9e|675c24728f87f7aa0fa07527027c95c24c246049c65eaef89270ab04ea50a180|6ba1aa275e0e2826e8b48b36473539ca56cbdc41f429e539a45f8532b084d7a4|df8ab6fd699e6ae90e63e9696bae8f01342708bafc2ed88af414337e4f237194|96fc528ca5e7d1c2b3add5e31b8797cb126f704976c8fbeaecdbf0aa4309ad46|acc706afc9322a3eae1ef49049749e0a7c9f1a123895ac56dc8a289beb2fb5b7)"
    | eval data_model="Endpoint.Filesystem", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="file ".action." ".file_path
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*00c9ac44291f83c72d54302e99d155a3e26d02225a3e516764d5833a99657c9e*", "*675c24728f87f7aa0fa07527027c95c24c246049c65eaef89270ab04ea50a180*", "*6ba1aa275e0e2826e8b48b36473539ca56cbdc41f429e539a45f8532b084d7a4*", "*df8ab6fd699e6ae90e63e9696bae8f01342708bafc2ed88af414337e4f237194*", "*96fc528ca5e7d1c2b3add5e31b8797cb126f704976c8fbeaecdbf0aa4309ad46*", "*acc706afc9322a3eae1ef49049749e0a7c9f1a123895ac56dc8a289beb2fb5b7*") OR All_Email.url IN ("*://efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id.onion*", "*.efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id.onion*", "efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id.onion*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>00c9ac44291f83c72d54302e99d155a3e26d02225a3e516764d5833a99657c9e|675c24728f87f7aa0fa07527027c95c24c246049c65eaef89270ab04ea50a180|6ba1aa275e0e2826e8b48b36473539ca56cbdc41f429e539a45f8532b084d7a4|df8ab6fd699e6ae90e63e9696bae8f01342708bafc2ed88af414337e4f237194|96fc528ca5e7d1c2b3add5e31b8797cb126f704976c8fbeaecdbf0aa4309ad46|acc706afc9322a3eae1ef49049749e0a7c9f1a123895ac56dc8a289beb2fb5b7|efxisnqldelyr5ra25oqfrsut54b34g26e7zrsiuupsoekjof2gho2id\.onion)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_path="*/opt/vadi_*" OR Filesystem.file_name IN ("sansar", "acpi_thermal_mgr.ko")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="Files or processes under /opt/vadi_/", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_path="*/opt/vadi_*" OR Processes.process_name IN ("sansar", "kurt", "tilki")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Files or processes under /opt/vadi_/", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name IN ("acpi_thermal_mgr.ko", "acpi_thermal_mgr") OR Filesystem.file_path="*acpi_thermal_mgr*"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="acpi_thermal_mgr kernel module built or loaded", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process="*acpi_thermal_mgr*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="acpi_thermal_mgr kernel module built or loaded", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process="*eth_call*" AND (Processes.process="*0x43eb291f56688c63c93e8a93c4591fc997cf6349*" OR Processes.process="*0x6ded96e7*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="eth_call to the netns Ethereum C2 contract", ioc_type="behaviour (hunt)"
]
| append [
    search index=* "0x43eb291f56688c63c93e8a93c4591fc997cf6349" OR "0x6ded96e7"
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="raw events"
    | eval ioc="eth_call to the netns Ethereum C2 contract", ioc_type="behaviour (hunt)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE (Processes.process_name IN ("python", "python3") AND Processes.process="*ray*" AND (Processes.process="*nvidia-smi*" OR Processes.process="*/bin/sh*" OR Processes.process="*/bin/bash*" OR Processes.process="*authorized_keys*")) OR (Processes.process_name="nvidia-smi" AND Processes.parent_process_name IN ("python", "python3", "ray"))
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Exposed Ray job agent or nvidia-smi then a Python shell", ioc_type="behaviour (hunt)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name="libnvidia-ml.so.1" AND Filesystem.action IN ("created", "modified", "renamed")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="Unexpected replacement of libnvidia-ml.so.1", ioc_type="behaviour (hunt)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
