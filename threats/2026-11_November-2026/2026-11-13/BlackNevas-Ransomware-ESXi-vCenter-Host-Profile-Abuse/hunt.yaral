// Threat: BlackNevas: Ransomware Wipes ESXi and vCenter Through Legitimate Management Features
// Author: Daniel Jeremiah | Date: 2026-11-13
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/BlackNevas-Ransomware-ESXi-vCenter-Host-Profile-Abuse
rule rti_blacknevas_ransomware_esxi_vcenter_host_profile_abuse {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-13"
    description = "BlackNevas: Ransomware Wipes ESXi and vCenter Through Legitimate Management Features"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/BlackNevas-Ransomware-ESXi-vCenter-Host-Profile-Abuse"

  events:
    (
      $e.principal.ip = /^(?:45\.149\.154\.135|91\.92\.242\.121|31\.41\.33\.212|188\.240\.57\.94)$/ or
      $e.target.ip = /^(?:45\.149\.154\.135|91\.92\.242\.121|31\.41\.33\.212|188\.240\.57\.94)$/ or
      $e.network.dns.answers.data = /^(?:45\.149\.154\.135|91\.92\.242\.121|31\.41\.33\.212|188\.240\.57\.94)$/ or
      $e.network.dns.questions.name = /(?:^|\.)(?:api\.cloudvflare\.com)\.?$/ nocase or
      $e.target.hostname = /(?:^|\.)(?:api\.cloudvflare\.com)\.?$/ nocase or
      $e.target.domain.name = /(?:^|\.)(?:api\.cloudvflare\.com)\.?$/ nocase or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:(?:[^/?#@]*\.)?(?:api\.cloudvflare\.com)(?::\d+)?(?:[/?#]|$))`) nocase or
      $e.target.file.sha256 = /^(?:15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf|5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78)$/ nocase or
      $e.target.process.file.sha256 = /^(?:15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf|5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78)$/ nocase or
      $e.principal.process.file.sha256 = /^(?:15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf|5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78)$/ nocase or
      $e.principal.process.parent_process.file.sha256 = /^(?:15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf|5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78)$/ nocase or
      $e.target.file.sha1 = /^(?:28f8da19ddcdf26e426875c7a834b34a79bc1c33)$/ nocase or
      $e.target.process.file.sha1 = /^(?:28f8da19ddcdf26e426875c7a834b34a79bc1c33)$/ nocase or
      $e.principal.process.file.sha1 = /^(?:28f8da19ddcdf26e426875c7a834b34a79bc1c33)$/ nocase or
      $e.principal.process.parent_process.file.sha1 = /^(?:28f8da19ddcdf26e426875c7a834b34a79bc1c33)$/ nocase or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.target.process.command_line, `/tmp/\S+ +(/selftest|/p +/vmfs/.* /(wipe|allsys|detach))`) nocase) or
      (($e.metadata.event_type = "FILE_CREATION" or $e.metadata.event_type = "FILE_MODIFICATION" or $e.metadata.event_type = "FILE_MOVE") and $e.target.file.full_path = /systemd\/system\/vmware-vdma\.service$/) or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and $e.target.process.file.full_path = /^\/opt\/vmware\/bin\/agent$/)
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $dns_query = array_distinct($e.network.dns.questions.name)
    $target_hostname = array_distinct($e.target.hostname)
    $target_url = array_distinct($e.target.url)
    $file_sha256 = array_distinct($e.target.file.sha256)
    $process_sha256 = array_distinct($e.target.process.file.sha256)
    $process_path = array_distinct($e.target.process.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
