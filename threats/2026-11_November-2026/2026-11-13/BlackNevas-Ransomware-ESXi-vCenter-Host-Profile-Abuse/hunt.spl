``` Threat: BlackNevas: Ransomware Wipes ESXi and vCenter Through Legitimate Management Features
    Author: Daniel Jeremiah | Date: 2026-11-13
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/BlackNevas-Ransomware-ESXi-vCenter-Host-Profile-Abuse ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("45.149.154.135", "91.92.242.121", "31.41.33.212", "188.240.57.94")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("45.149.154.135", "91.92.242.121", "31.41.33.212", "188.240.57.94")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Resolution.DNS
        WHERE DNS.query IN ("api.cloudvflare.com", "*.api.cloudvflare.com")
        BY DNS.src DNS.dest DNS.query DNS.reply_code
    | rename "DNS.*" AS *
    | rex field=query "(?i)(?<ioc>(?:api\.cloudvflare\.com))\.?$"
    | eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url IN ("*://api.cloudvflare.com*", "*.api.cloudvflare.com*", "api.cloudvflare.com*") OR Web.dest IN ("api.cloudvflare.com", "*.api.cloudvflare.com"))
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>api\.cloudvflare\.com)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_hash IN ("*15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf*", "*5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78*", "*28f8da19ddcdf26e426875c7a834b34a79bc1c33*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.process_hash
    | rename "Processes.*" AS *
    | rex field=process_hash "(?i)(?<ioc>15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf|5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78|28f8da19ddcdf26e426875c7a834b34a79bc1c33)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_hash IN ("*15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf*", "*5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78*", "*28f8da19ddcdf26e426875c7a834b34a79bc1c33*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.parent_process_hash
    | rename "Processes.*" AS *
    | rex field=parent_process_hash "(?i)(?<ioc>15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf|5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78|28f8da19ddcdf26e426875c7a834b34a79bc1c33)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="parent process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_hash IN ("*15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf*", "*5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78*", "*28f8da19ddcdf26e426875c7a834b34a79bc1c33*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action Filesystem.file_hash
    | rename "Filesystem.*" AS *
    | rex field=file_hash "(?i)(?<ioc>15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf|5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78|28f8da19ddcdf26e426875c7a834b34a79bc1c33)"
    | eval data_model="Endpoint.Filesystem", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="file ".action." ".file_path
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf*", "*5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78*", "*28f8da19ddcdf26e426875c7a834b34a79bc1c33*") OR All_Email.url IN ("*://api.cloudvflare.com*", "*.api.cloudvflare.com*", "api.cloudvflare.com*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>15dc419b7fbeb50c50820a7cd27997541deafa4fa710f074bb657f0149574baf|5a9b7a0d3f25757aea957713d7e84cabec87597b3474368328a8fd5ed7a12f78|28f8da19ddcdf26e426875c7a834b34a79bc1c33|api\.cloudvflare\.com)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    search index=* "/tmp/" ("/selftest" OR ("/vmfs/" ("/wipe" OR "/allsys" OR "/detach")))
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="ESXi logs"
    | eval ioc="ESXi encryptor run from /tmp against /vmfs", ioc_type="behaviour (alert)"
]

| append [
    search index=* ("vmware-vdma" OR "DNS, time, VM settings sync")
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="vCenter appliance logs"
    | eval ioc="Fake vmware-vdma tunnel service on vCenter", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Registry
        WHERE Registry.registry_path="*\\Services\\vspbind*"
        BY Registry.dest Registry.user Registry.registry_path Registry.registry_value_name Registry.registry_value_data
    | rename "Registry.*" AS *
    | eval host=dest, src="-", detail=registry_path." ".registry_value_name."=".registry_value_data, data_model="Endpoint.Registry"
    | eval ioc="vspbind remote-management service", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
