// Threat: Fake Zillow Pages Deliver NetSupport RAT through ClickFix
// Author: Daniel Jeremiah | Date: 2026-11-13
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/Fake-Zillow-ClickFix-NetSupport-RAT
rule rti_fake_zillow_clickfix_netsupport_rat {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-13"
    description = "Fake Zillow Pages Deliver NetSupport RAT through ClickFix"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/Fake-Zillow-ClickFix-NetSupport-RAT"

  events:
    (
      $e.principal.ip = /^(?:89\.34\.90\.203|45\.227\.254\.179|45\.227\.254\.10)$/ or
      $e.target.ip = /^(?:89\.34\.90\.203|45\.227\.254\.179|45\.227\.254\.10)$/ or
      $e.network.dns.answers.data = /^(?:89\.34\.90\.203|45\.227\.254\.179|45\.227\.254\.10)$/ or
      $e.network.dns.questions.name = /(?:^|\.)(?:apartments\-review8509831\.sbs|apartments\-review28829031\.sbs|apartments\-review6125431\.sbs|apartments\-review261679200\.sbs|apartments\-review2138768\.sbs|apartments\-review261634860\.sbs|apartments\-review9384643\.sbs|asgomd\.com|bksju\.com|bksnb\.com|decrmd\.com|jpgomd\.com|nogomd\.com|asgrsv\.com|decrsv\.com|jpgrsv\.com)\.?$/ nocase or
      $e.target.hostname = /(?:^|\.)(?:apartments\-review8509831\.sbs|apartments\-review28829031\.sbs|apartments\-review6125431\.sbs|apartments\-review261679200\.sbs|apartments\-review2138768\.sbs|apartments\-review261634860\.sbs|apartments\-review9384643\.sbs|asgomd\.com|bksju\.com|bksnb\.com|decrmd\.com|jpgomd\.com|nogomd\.com|asgrsv\.com|decrsv\.com|jpgrsv\.com)\.?$/ nocase or
      $e.target.domain.name = /(?:^|\.)(?:apartments\-review8509831\.sbs|apartments\-review28829031\.sbs|apartments\-review6125431\.sbs|apartments\-review261679200\.sbs|apartments\-review2138768\.sbs|apartments\-review261634860\.sbs|apartments\-review9384643\.sbs|asgomd\.com|bksju\.com|bksnb\.com|decrmd\.com|jpgomd\.com|nogomd\.com|asgrsv\.com|decrsv\.com|jpgrsv\.com)\.?$/ nocase or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:89\.34\.90\.203/winup2|89\.34\.90\.203/mestos2\.zip|(?:[^/?#@]*\.)?(?:apartments\-review8509831\.sbs|apartments\-review28829031\.sbs|apartments\-review6125431\.sbs|apartments\-review261679200\.sbs|apartments\-review2138768\.sbs|apartments\-review261634860\.sbs|apartments\-review9384643\.sbs|asgomd\.com|bksju\.com|bksnb\.com|decrmd\.com|jpgomd\.com|nogomd\.com|asgrsv\.com|decrsv\.com|jpgrsv\.com)(?::\d+)?(?:[/?#]|$))`) nocase or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.principal.process.file.full_path, `explorer\.exe$`) nocase and re.regex($e.target.process.file.full_path, `powershell\.exe$`) nocase and re.regex($e.target.process.command_line, `(iwr|irm|Invoke-WebRequest|Invoke-RestMethod)`) nocase and re.regex($e.target.process.command_line, `(winup2|1495423691|89\.34\.90\.203)`) nocase) or
      re.regex($e.target.file.full_path, `(winup2\.ps1|mestos2\.zip)$`) nocase or
      (re.regex($e.target.file.full_path, `NetSupport\.lnk$`) nocase or re.regex($e.target.file.full_path, `AppData.Roaming.NetSupport.*Service\.exe$`) nocase) or
      re.regex($e.target.hostname, `(apartments-review[0-9]+\.sbs|asgomd\.com|asgrsv\.com|bksju\.com|bksnb\.com|decrmd\.com|jpgomd\.com|nogomd\.com|decrsv\.com|jpgrsv\.com)$`) nocase
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $dns_query = array_distinct($e.network.dns.questions.name)
    $target_hostname = array_distinct($e.target.hostname)
    $target_url = array_distinct($e.target.url)

  condition:
    $e

  options:
    allow_zero_values = true
}
