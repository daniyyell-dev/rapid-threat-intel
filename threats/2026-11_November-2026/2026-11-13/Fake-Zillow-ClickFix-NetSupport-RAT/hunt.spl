``` Threat: Fake Zillow Pages Deliver NetSupport RAT through ClickFix
    Author: Daniel Jeremiah | Date: 2026-11-13
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/Fake-Zillow-ClickFix-NetSupport-RAT ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("89.34.90.203", "45.227.254.179", "45.227.254.10")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("89.34.90.203", "45.227.254.179", "45.227.254.10")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Resolution.DNS
        WHERE DNS.query IN ("apartments-review8509831.sbs", "*.apartments-review8509831.sbs", "apartments-review28829031.sbs", "*.apartments-review28829031.sbs", "apartments-review6125431.sbs", "*.apartments-review6125431.sbs", "apartments-review261679200.sbs", "*.apartments-review261679200.sbs", "apartments-review2138768.sbs", "*.apartments-review2138768.sbs", "apartments-review261634860.sbs", "*.apartments-review261634860.sbs", "apartments-review9384643.sbs", "*.apartments-review9384643.sbs", "asgomd.com", "*.asgomd.com", "bksju.com", "*.bksju.com", "bksnb.com", "*.bksnb.com", "decrmd.com", "*.decrmd.com", "jpgomd.com", "*.jpgomd.com", "nogomd.com", "*.nogomd.com", "asgrsv.com", "*.asgrsv.com", "decrsv.com", "*.decrsv.com", "jpgrsv.com", "*.jpgrsv.com")
        BY DNS.src DNS.dest DNS.query DNS.reply_code
    | rename "DNS.*" AS *
    | rex field=query "(?i)(?<ioc>(?:apartments\-review8509831\.sbs|apartments\-review28829031\.sbs|apartments\-review6125431\.sbs|apartments\-review261679200\.sbs|apartments\-review2138768\.sbs|apartments\-review261634860\.sbs|apartments\-review9384643\.sbs|asgomd\.com|bksju\.com|bksnb\.com|decrmd\.com|jpgomd\.com|nogomd\.com|asgrsv\.com|decrsv\.com|jpgrsv\.com))\.?$"
    | eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url IN ("*://apartments-review8509831.sbs*", "*.apartments-review8509831.sbs*", "apartments-review8509831.sbs*", "*://apartments-review28829031.sbs*", "*.apartments-review28829031.sbs*", "apartments-review28829031.sbs*", "*://apartments-review6125431.sbs*", "*.apartments-review6125431.sbs*", "apartments-review6125431.sbs*", "*://apartments-review261679200.sbs*", "*.apartments-review261679200.sbs*", "apartments-review261679200.sbs*", "*://apartments-review2138768.sbs*", "*.apartments-review2138768.sbs*", "apartments-review2138768.sbs*", "*://apartments-review261634860.sbs*", "*.apartments-review261634860.sbs*", "apartments-review261634860.sbs*", "*://apartments-review9384643.sbs*", "*.apartments-review9384643.sbs*", "apartments-review9384643.sbs*", "*://asgomd.com*", "*.asgomd.com*", "asgomd.com*", "*://bksju.com*", "*.bksju.com*", "bksju.com*", "*://bksnb.com*", "*.bksnb.com*", "bksnb.com*", "*://decrmd.com*", "*.decrmd.com*", "decrmd.com*", "*://jpgomd.com*", "*.jpgomd.com*", "jpgomd.com*", "*://nogomd.com*", "*.nogomd.com*", "nogomd.com*", "*://asgrsv.com*", "*.asgrsv.com*", "asgrsv.com*", "*://decrsv.com*", "*.decrsv.com*", "decrsv.com*", "*://jpgrsv.com*", "*.jpgrsv.com*", "jpgrsv.com*") OR Web.dest IN ("apartments-review8509831.sbs", "*.apartments-review8509831.sbs", "apartments-review28829031.sbs", "*.apartments-review28829031.sbs", "apartments-review6125431.sbs", "*.apartments-review6125431.sbs", "apartments-review261679200.sbs", "*.apartments-review261679200.sbs", "apartments-review2138768.sbs", "*.apartments-review2138768.sbs", "apartments-review261634860.sbs", "*.apartments-review261634860.sbs", "apartments-review9384643.sbs", "*.apartments-review9384643.sbs", "asgomd.com", "*.asgomd.com", "bksju.com", "*.bksju.com", "bksnb.com", "*.bksnb.com", "decrmd.com", "*.decrmd.com", "jpgomd.com", "*.jpgomd.com", "nogomd.com", "*.nogomd.com", "asgrsv.com", "*.asgrsv.com", "decrsv.com", "*.decrsv.com", "jpgrsv.com", "*.jpgrsv.com") OR Web.url IN ("*89.34.90.203/winup2*", "*89.34.90.203/mestos2.zip*"))
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>89\.34\.90\.203/winup2|89\.34\.90\.203/mestos2\.zip|apartments\-review8509831\.sbs|apartments\-review28829031\.sbs|apartments\-review6125431\.sbs|apartments\-review261679200\.sbs|apartments\-review2138768\.sbs|apartments\-review261634860\.sbs|apartments\-review9384643\.sbs|asgomd\.com|bksju\.com|bksnb\.com|decrmd\.com|jpgomd\.com|nogomd\.com|asgrsv\.com|decrsv\.com|jpgrsv\.com)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.url IN ("*89.34.90.203/winup2*", "*89.34.90.203/mestos2.zip*", "*://apartments-review8509831.sbs*", "*.apartments-review8509831.sbs*", "apartments-review8509831.sbs*", "*://apartments-review28829031.sbs*", "*.apartments-review28829031.sbs*", "apartments-review28829031.sbs*", "*://apartments-review6125431.sbs*", "*.apartments-review6125431.sbs*", "apartments-review6125431.sbs*", "*://apartments-review261679200.sbs*", "*.apartments-review261679200.sbs*", "apartments-review261679200.sbs*", "*://apartments-review2138768.sbs*", "*.apartments-review2138768.sbs*", "apartments-review2138768.sbs*", "*://apartments-review261634860.sbs*", "*.apartments-review261634860.sbs*", "apartments-review261634860.sbs*", "*://apartments-review9384643.sbs*", "*.apartments-review9384643.sbs*", "apartments-review9384643.sbs*", "*://asgomd.com*", "*.asgomd.com*", "asgomd.com*", "*://bksju.com*", "*.bksju.com*", "bksju.com*", "*://bksnb.com*", "*.bksnb.com*", "bksnb.com*", "*://decrmd.com*", "*.decrmd.com*", "decrmd.com*", "*://jpgomd.com*", "*.jpgomd.com*", "jpgomd.com*", "*://nogomd.com*", "*.nogomd.com*", "nogomd.com*", "*://asgrsv.com*", "*.asgrsv.com*", "asgrsv.com*", "*://decrsv.com*", "*.decrsv.com*", "decrsv.com*", "*://jpgrsv.com*", "*.jpgrsv.com*", "jpgrsv.com*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>89\.34\.90\.203/winup2|89\.34\.90\.203/mestos2\.zip|apartments\-review8509831\.sbs|apartments\-review28829031\.sbs|apartments\-review6125431\.sbs|apartments\-review261679200\.sbs|apartments\-review2138768\.sbs|apartments\-review261634860\.sbs|apartments\-review9384643\.sbs|asgomd\.com|bksju\.com|bksnb\.com|decrmd\.com|jpgomd\.com|nogomd\.com|asgrsv\.com|decrsv\.com|jpgrsv\.com)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_name="explorer.exe" AND Processes.process_name="powershell.exe" AND (Processes.process="*iwr*" OR Processes.process="*irm*" OR Processes.process="*Invoke-WebRequest*" OR Processes.process="*Invoke-RestMethod*") AND (Processes.process="*winup2*" OR Processes.process="*1495423691*" OR Processes.process="*89.34.90.203*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="ClickFix PowerShell iwr of winup2 from the decimal IP", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name IN ("winup2.ps1", "mestos2.zip")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="winup2.ps1 or mestos2.zip written or downloaded", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process IN ("*winup2.ps1*", "*mestos2.zip*", "*89.34.90.203/mestos2*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="winup2.ps1 or mestos2.zip written or downloaded", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name="NetSupport.lnk" Filesystem.file_path="*Startup*"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="Startup NetSupport.lnk pointing at AppData Service.exe", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name="Service.exe" Filesystem.file_path="*AppData*Roaming*NetSupport*"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="Startup NetSupport.lnk pointing at AppData Service.exe", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url="*apartments-review*" AND Web.url="*.sbs*") OR Web.url IN ("*asgomd.com*", "*asgrsv.com*", "*bksju.com*", "*bksnb.com*", "*decrmd.com*", "*jpgomd.com*", "*nogomd.com*", "*decrsv.com*", "*jpgrsv.com*") OR Web.dest IN ("89.34.90.203", "45.227.254.179", "45.227.254.10")
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | eval host=dest, detail="HTTP ".status." ".url." UA: ".http_user_agent, data_model="Web"
    | eval ioc="Lookups for apartments-review*.sbs or the gateway domains", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
