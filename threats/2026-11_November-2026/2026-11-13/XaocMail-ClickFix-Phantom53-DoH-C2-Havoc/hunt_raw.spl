    | rex field=matched "(?i)(?<ioc>bceeb2d54b6a756c73a3e06617e9e95ad4d8e53da47639bcd6ef3cae98c6da6d|79a4cb73983a1facb5db09f1a20cec6e58d91a93044a78aa3ba32ab2190284ed|0e1c94a8f94158f64558325ddbfd1e1277884fba6fb1f8c381dbd5c742e59fbb|efc4b8c1968c06e598a6f6f98398d44b488198b497291fe30fb792d696b6cb81|4f656834e545c0b44922ce6d8952989c8c0859d8ae8b1f117c06ab07b047e2b4|8ebb2bf61b48ae7abdcd674413bebd79b30ddd945854e175ba60d56c0a3adf54|a4ad001c6900176eba43a747ae5d212db6fc78f7ef4e777f276cbbdf8099dbe8|dc57638cb90798835848a9dafec228bef7738def50f4f2db612862e07c5b6f8a|56582934901cce0b618d6a50e54c9db29bf2d444636bcd40b5975a765ecde538|009099ba10365b44bdb3ecc28dfcbed6a594ec0a0df86931620cdaac9843e611|0aff424f9a02eb9f429119c4caa05e85fc952603549d69849e745293d20235d6|7055483a77f679ad569c3a9bfe76cdb8e5b96efc44d2bf2a6f08e930add598b0|0dcfe51d2521e52a469f5cec6b42bc8e7e37b41df993cce7d739ff3fd248d8b1|bd1c005f35e4fd8c61dfa6f20d4c03e082c692e286a3b22dd642369c8d5e3564|dbd252becd490ac47e16bff4391ab9e6237c4f7e81ab6784c57fa2eed751f477|e9e57a57ee45b8faae2e47affd8cf3a6d0cc1283802108f7298ae1d2ef3b43f0|d2d41b249905deae3bd6bcaa547872d747256a7dfa459b509d9db9de8f0ca29b|ee5fa33b58d0f2772e091e23de9db24908d970000a88e39fd7d908f30f5e591a|a972797cc1a4161f6e2841142b8cace9b781585f9a71b03aa79a9c051b817491|47e853092511d9663196e9b36d563a0c3e92ee734f88675c4f375ffcfa5f3db8|4efe003a54db8ffbaef6065270eacb0a59479ccc86941517ac7a33344e97bc1d|9a2af4b6d9780e08c86ff35030ee1747ea11460cb1dffc868c48e7af6d626546)"
    | eval data_model="endpoint", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, detail=coalesce(process, file_path)
  ]
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_endpoint(("workers.dev" OR xei))`
    | where match(coalesce(parent_process_name, ""), "(?i)explorer\.exe$") AND match(coalesce(process, ""), "(?i)workers\.dev/[mhs]\?id=|xei.\[-1\.\.-3\]")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="ClickFix Run-dialog msiexec, mshta or PowerShell from workers.dev", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((p53_task_a.xml OR p53_task_b.xml))`
    | where match(coalesce(file_name, file_path, ""), "(?i)p53_task_[ab]\.xml")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="p53_task_a.xml or p53_task_b.xml written", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
