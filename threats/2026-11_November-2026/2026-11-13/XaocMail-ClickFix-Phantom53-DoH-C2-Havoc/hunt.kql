    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(ActionType, " ", FolderPath, " by ", InitiatingProcessFileName))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName =~ "pythonw.exe" and InitiatingProcessFolderPath has "AppData" and not (InitiatingProcessFolderPath has_any ("Programs\\Python", "PythonSoftwareFoundation", "Anaconda", "miniconda")) and RemotePort == 443 and (RemoteIP in ("1.1.1.1", "1.0.0.1", "8.8.8.8", "8.8.4.4", "76.76.2.11", "76.76.10.11") or RemoteUrl in~ ("dns.google", "cloudflare-dns.com", "one.one.one.one", "freedns.controld.com"))
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(InitiatingProcessFolderPath), Context = tostring(strcat("DoH to ", RemoteIP, " ", RemoteUrl, " | ", InitiatingProcessCommandLine)))
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Hits = count(), Context = take_any(Context) by SourceTable, Entity, Indicator
| order by LastSeen desc
