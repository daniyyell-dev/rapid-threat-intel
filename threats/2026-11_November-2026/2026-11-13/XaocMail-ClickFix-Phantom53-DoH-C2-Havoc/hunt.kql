    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(FileName, " from Run dialog | ", AccountName))),
  (DeviceEvents
    | where Timestamp > ago(Lookback)
    | where ActionType == "ScheduledTaskCreated" and AdditionalFields has "pythonw.exe" and AdditionalFields has ".pyw" and AdditionalFields has "AppData" and not (AdditionalFields has_any ("Programs\\Python", "PythonSoftwareFoundation", "Anaconda", "miniconda"))
    | project Timestamp, SourceTable = "DeviceEvents", Entity = tostring(DeviceName), Indicator = tostring(parse_json(AdditionalFields).TaskName), Context = tostring(strcat(iff(tostring(parse_json(AdditionalFields).TaskName) matches regex @"(MicrosoftEdgeUpdateTask|OneDriveSyncTask|WindowsDefenderScheduledScan|OfficeBackgroundTaskHandler|AdobeAcrobatUpdateTask)[a-z0-9]$", "task name from the Phantom53 pool | ", ""), substring(tostring(parse_json(AdditionalFields).TaskContent), 0, 300)))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
