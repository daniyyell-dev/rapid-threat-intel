| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_endpoint((SysCheck2 OR SysCheckX OR SysHeal))`
    | where match(coalesce(process, ""), "SysCheck2|SysCheckX|SysHeal")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="SysCheck tasks or files in the fake SystemHealth folder", ioc_type="behaviour (alert)"
]
| append [
    search `rti_endpoint(SystemHealth)`
    | where match(coalesce(file_path, ""), "(?i)Windows.SystemHealth.Update")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="SysCheck tasks or files in the fake SystemHealth folder", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(("python.exe" OR "pythonw.exe"))`
    | where match(coalesce(process, ""), "(?i)SystemHealth.Update") OR (match(coalesce(parent_process, ""), "(?i)--headless") AND match(coalesce(process_name, ""), "(?i)^pythonw?\.exe$"))
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Headless console starting Python from SystemHealth", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint("Add-MpPreference")`
    | where match(coalesce(process, ""), "(?i)Add-MpPreference.*(xmrig|ExclusionPath\s+.?C:.Windows.?(\s|$))")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Defender exclusion for C:\Windows or xmrig.exe", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint("remote-debugging-port=9222")`
    | where match(coalesce(parent_process_name, ""), "(?i)^pythonw?\.exe$") AND match(coalesce(process, ""), "remote-debugging-port=9222")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Python launching a browser with remote debugging on 9222", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
