      $e.principal.ip = /^(?:209\.99\.186\.187|82\.153\.135\.80|186\.2\.175\.183|186\.2\.163\.185|190\.115\.31\.69|186\.2\.175\.158|186\.2\.163\.193)$/ or
      $e.target.ip = /^(?:209\.99\.186\.187|82\.153\.135\.80|186\.2\.175\.183|186\.2\.163\.185|190\.115\.31\.69|186\.2\.175\.158|186\.2\.163\.193)$/ or
      $e.network.dns.answers.data = /^(?:209\.99\.186\.187|82\.153\.135\.80|186\.2\.175\.183|186\.2\.163\.185|190\.115\.31\.69|186\.2\.175\.158|186\.2\.163\.193)$/ or
      $e.network.dns.questions.name = /(?:^|\.)(?:choclatey\.org|massgravel\.net|workerstats\.net|pymons\.is|datamons\.org|niceer\.net|supertrap\.net|plaineagle\.xyz|univalley\.top|icedhatch\.top|icedhatch\.xyz|icedout\.top|pur\.st)\.?$/ nocase or
      $e.target.hostname = /(?:^|\.)(?:choclatey\.org|massgravel\.net|workerstats\.net|pymons\.is|datamons\.org|niceer\.net|supertrap\.net|plaineagle\.xyz|univalley\.top|icedhatch\.top|icedhatch\.xyz|icedout\.top|pur\.st)\.?$/ nocase or
      $e.target.domain.name = /(?:^|\.)(?:choclatey\.org|massgravel\.net|workerstats\.net|pymons\.is|datamons\.org|niceer\.net|supertrap\.net|plaineagle\.xyz|univalley\.top|icedhatch\.top|icedhatch\.xyz|icedout\.top|pur\.st)\.?$/ nocase or
