rule rti_armorsteal_seo_poisoning_python_stealer {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-13"
    description = "Armorsteal: SEO-Poisoned Chocolatey and Massgrave Lures Deliver a Python Stealer, Backdoor and Miner"
