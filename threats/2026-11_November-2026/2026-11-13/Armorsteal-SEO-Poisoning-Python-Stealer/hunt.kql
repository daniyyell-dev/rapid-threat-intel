// Threat: Armorsteal: SEO-Poisoned Chocolatey and Massgrave Lures Deliver a Python Stealer, Backdoor and Miner
// Author: Daniel Jeremiah | Date: 2026-11-13
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/Armorsteal-SEO-Poisoning-Python-Stealer
let Lookback = 30d;
let IPs = dynamic(["209.99.186.187", "82.153.135.80", "186.2.175.183", "186.2.163.185", "190.115.31.69", "186.2.175.158", "186.2.163.193"]);
let Domains = dynamic(["choclatey.org", "massgravel.net", "workerstats.net", "pymons.is", "datamons.org", "niceer.net", "supertrap.net", "plaineagle.xyz", "univalley.top", "icedhatch.top", "icedhatch.xyz", "icedout.top", "pur.st"]);
let SHA256s = dynamic(["f3846ec2a6ff0a27d9ef2b9bf7908743b81d295ef29344acfb96ff83fff994f9", "fb1181160e9f10ce1eb5e5dc9bc23e1498a39110ee9ea361fd150454cb01b292", "3e3b62a9836697d978cbb620dc8af8f6eefdf8cb73fc30d16bb394d1c58f4c97", "237ba698d7dc8936c43e0e78e7644002375e51e8baf9b3a7d4e18683f871ee31", "be0329d0795dd62ae587faf97e704bb36413e5c98ddd8fe575f5077db3c84e5f", "04d2828155ed2a276cfd3c97d4f966d328391dd818e04e773212cd601e49fa74", "56f05c4fb1c25c04e0dde60e2e5e41ac164a6dc53688d0f9eb52a55f82106389", "0ea99fbbe29af6f797e3866ed5f822c7a5d3e9cdb990a8c382a715069f156499", "8fb7aaf2b9270b8b75f6844aaefd5242b4f926fb89cba10fff3d9b908a769788", "5410c2f239c3649928383c4478dea182f90b21f5b258081fec07e9d297ae4b1c", "972fe9edb13da76113047e6db39bcc44749aaeec1be107c975649f0c413a3067", "cb9db2b44476e160fdae0e840d62e7c5c0b07dc56d26d17acf82412e446274ca", "f1150680a69ca5e28f229e51c7b7bc9afa34f3e3a4ba424e3571b152009104b0"]);
union isfuzzy=true
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " port ", RemotePort))),
  (DeviceLogonEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceLogonEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", LogonType, " ", AccountName))),
  (EntraIdSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSignInEvents", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (AADSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSignInEventsBeta", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (EntraIdSpnSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSpnSignInEvents", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (AADSpnSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSpnSignInEventsBeta", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(AccountDisplayName), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ActionType))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteUrl has_any (Domains)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteUrl), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " ", RemoteIP))),
  (DeviceEvents
    | where Timestamp > ago(Lookback)
    | where ActionType == "DnsQueryResponse" and tostring(parse_json(AdditionalFields).DnsQueryString) has_any (Domains)
    | project Timestamp, SourceTable = "DeviceEvents", Entity = tostring(DeviceName), Indicator = tostring(parse_json(AdditionalFields).DnsQueryString), Context = tostring(strcat("DNS ", InitiatingProcessFileName))),
  (EmailUrlInfo
    | where Timestamp > ago(Lookback)
    | where UrlDomain has_any (Domains)
    | project Timestamp, SourceTable = "EmailUrlInfo", Entity = tostring(NetworkMessageId), Indicator = tostring(Url), Context = tostring("URL in email")),
  (UrlClickEvents
    | where Timestamp > ago(Lookback)
    | where Url has_any (Domains)
    | project Timestamp, SourceTable = "UrlClickEvents", Entity = tostring(AccountUpn), Indicator = tostring(Url), Context = tostring(strcat(ActionType, " ", Workload))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(ActionType, " ", FolderPath))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(FolderPath, " ", ProcessCommandLine))),
  (DeviceImageLoadEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceImageLoadEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(FolderPath, " loaded by ", InitiatingProcessFileName))),
  (EmailAttachmentInfo
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "EmailAttachmentInfo", Entity = tostring(RecipientEmailAddress), Indicator = tostring(SHA256), Context = tostring(strcat(FileName, " from ", SenderFromAddress))),
  (DeviceEvents
    | where Timestamp > ago(Lookback)
    | where ActionType == "ScheduledTaskCreated" and tostring(parse_json(AdditionalFields).TaskName) has_any ("SysCheck2", "SysCheckX", "SysHeal")
    | project Timestamp, SourceTable = "DeviceEvents", Entity = tostring(DeviceName), Indicator = tostring(parse_json(AdditionalFields).TaskName), Context = tostring(strcat(InitiatingProcessFileName, " ", InitiatingProcessCommandLine))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FolderPath contains @"\Windows\SystemHealth\Update"
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where (InitiatingProcessFileName =~ "conhost.exe" and InitiatingProcessCommandLine contains "--headless" and FileName in~ ("python.exe", "pythonw.exe")) or (FileName in~ ("python.exe", "pythonw.exe") and FolderPath contains @"\Windows\SystemHealth\Update")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(InitiatingProcessCommandLine, " > ", ProcessCommandLine))),
  (DeviceRegistryEvents
    | where Timestamp > ago(Lookback)
    | where RegistryKey has @"Windows Defender\Exclusions" and (RegistryValueName =~ @"C:\Windows" or RegistryValueName =~ "xmrig.exe")
    | project Timestamp, SourceTable = "DeviceRegistryEvents", Entity = tostring(DeviceName), Indicator = tostring(RegistryValueName), Context = tostring(strcat(RegistryKey, " by ", InitiatingProcessFileName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where ProcessCommandLine has "Add-MpPreference" and (ProcessCommandLine has "xmrig" or ProcessCommandLine matches regex @"(?i)ExclusionPath\s+'?C:\\Windows'?(\s|$|,)")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(ProcessCommandLine)),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName in~ ("chrome.exe", "msedge.exe", "brave.exe") and ProcessCommandLine contains "--remote-debugging-port=9222" and InitiatingProcessFileName in~ ("python.exe", "pythonw.exe")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(InitiatingProcessFolderPath, " > ", ProcessCommandLine)))
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Hits = count(), Context = take_any(Context) by SourceTable, Entity, Indicator
| order by LastSeen desc
