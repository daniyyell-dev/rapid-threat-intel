        WHERE Processes.process_name IN ("python.exe", "pythonw.exe") Processes.process_path="*SystemHealth*Update*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Headless console starting Python from SystemHealth", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process="*Add-MpPreference*" Processes.process IN ("*xmrig*", "*ExclusionPath*C:*Windows*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Defender exclusion for C:\Windows or xmrig.exe", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name IN ("chrome.exe", "msedge.exe", "brave.exe") Processes.process="*--remote-debugging-port=9222*" Processes.parent_process_name IN ("python.exe", "pythonw.exe")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Python launching a browser with remote debugging on 9222", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
