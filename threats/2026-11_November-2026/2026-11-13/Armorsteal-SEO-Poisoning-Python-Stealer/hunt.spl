``` Threat: Armorsteal: SEO-Poisoned Chocolatey and Massgrave Lures Deliver a Python Stealer, Backdoor and Miner
    Author: Daniel Jeremiah | Date: 2026-11-13
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/Armorsteal-SEO-Poisoning-Python-Stealer ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("209.99.186.187", "82.153.135.80", "186.2.175.183", "186.2.163.185", "190.115.31.69", "186.2.175.158", "186.2.163.193")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("209.99.186.187", "82.153.135.80", "186.2.175.183", "186.2.163.185", "190.115.31.69", "186.2.175.158", "186.2.163.193")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Resolution.DNS
        WHERE DNS.query IN ("choclatey.org", "*.choclatey.org", "massgravel.net", "*.massgravel.net", "workerstats.net", "*.workerstats.net", "pymons.is", "*.pymons.is", "datamons.org", "*.datamons.org", "niceer.net", "*.niceer.net", "supertrap.net", "*.supertrap.net", "plaineagle.xyz", "*.plaineagle.xyz", "univalley.top", "*.univalley.top", "icedhatch.top", "*.icedhatch.top", "icedhatch.xyz", "*.icedhatch.xyz", "icedout.top", "*.icedout.top", "pur.st", "*.pur.st")
        BY DNS.src DNS.dest DNS.query DNS.reply_code
    | rename "DNS.*" AS *
    | rex field=query "(?i)(?<ioc>(?:choclatey\.org|massgravel\.net|workerstats\.net|pymons\.is|datamons\.org|niceer\.net|supertrap\.net|plaineagle\.xyz|univalley\.top|icedhatch\.top|icedhatch\.xyz|icedout\.top|pur\.st))\.?$"
    | eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
]
