``` Threat: GeoVision Camera Software Abused to Deploy XMRig Cryptominer
    Author: Daniel Jeremiah | Date: 2026-11-13
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/GeoVision-Camera-Software-XMRig-Cryptominer ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("45.32.117.34", "156.246.94.183", "2.59.133.151")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("45.32.117.34", "156.246.94.183", "2.59.133.151")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Resolution.DNS
        WHERE DNS.query IN ("cctv-update.top", "*.cctv-update.top")
        BY DNS.src DNS.dest DNS.query DNS.reply_code
    | rename "DNS.*" AS *
    | rex field=query "(?i)(?<ioc>(?:cctv\-update\.top))\.?$"
    | eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url IN ("*://cctv-update.top*", "*.cctv-update.top*", "cctv-update.top*") OR Web.dest IN ("cctv-update.top", "*.cctv-update.top") OR Web.url IN ("*45.32.117.34/a*", "*45.32.117.34/b*", "*45.32.117.34/c*"))
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>45\.32\.117\.34/a|45\.32\.117\.34/b|45\.32\.117\.34/c|cctv\-update\.top)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_hash IN ("*f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c*", "*b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b*", "*ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.process_hash
    | rename "Processes.*" AS *
    | rex field=process_hash "(?i)(?<ioc>f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c|b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b|ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_hash IN ("*f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c*", "*b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b*", "*ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.parent_process_hash
    | rename "Processes.*" AS *
    | rex field=parent_process_hash "(?i)(?<ioc>f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c|b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b|ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="parent process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_hash IN ("*f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c*", "*b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b*", "*ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action Filesystem.file_hash
    | rename "Filesystem.*" AS *
    | rex field=file_hash "(?i)(?<ioc>f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c|b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b|ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8)"
    | eval data_model="Endpoint.Filesystem", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="file ".action." ".file_path
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c*", "*b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b*", "*ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8*") OR All_Email.url IN ("*45.32.117.34/a*", "*45.32.117.34/b*", "*45.32.117.34/c*", "*://cctv-update.top*", "*.cctv-update.top*", "cctv-update.top*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c|b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b|ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8|45\.32\.117\.34/a|45\.32\.117\.34/b|45\.32\.117\.34/c|cctv\-update\.top)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_name="GeoStartupAgentService.exe" Processes.process_name IN ("cmd.exe", "powershell.exe", "pwsh.exe")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="GeoStartupAgentService.exe spawning a shell or PowerShell", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name IN ("wsftprm.sys", "kvckiller.sys")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="wsftprm.sys or kvckiller.sys driver load or file", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Registry
        WHERE Registry.registry_path="*Image File Execution Options*" AND Registry.registry_value_name="Debugger" AND (Registry.registry_path="*MsMpEng.exe*" OR Registry.registry_path="*SecurityHealthService.exe*" OR Registry.registry_path="*SecurityHealthSystray.exe*" OR Registry.registry_path="*MpCmdRun.exe*" OR Registry.registry_value_data="*systray.exe*")
        BY Registry.dest Registry.user Registry.registry_path Registry.registry_value_name Registry.registry_value_data
    | rename "Registry.*" AS *
    | eval host=dest, src="-", detail=registry_path." ".registry_value_name."=".registry_value_data, data_model="Endpoint.Registry"
    | eval ioc="IFEO Debugger set on Microsoft Defender or Windows Security processes", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="schtasks.exe" Processes.process="*PackageUpdater*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="PackageUpdater task or update.exe from the systemprofile folder", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="update.exe" (Processes.process_path="*\\system32\\config\\systemprofile\\*" OR Processes.process="*\\system32\\config\\systemprofile\\update.exe*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="PackageUpdater task or update.exe from the systemprofile folder", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="ApplyUpdate.exe" (Processes.process="*--url*" OR Processes.process="*--user*" OR Processes.process="*--donate-level*" OR Processes.process="*--coin*" OR Processes.process="*--algo*" OR Processes.process="*stratum+*" OR Processes.process="* -o *" OR Processes.process="* -u *")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="ApplyUpdate.exe launched with XMRig arguments", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
