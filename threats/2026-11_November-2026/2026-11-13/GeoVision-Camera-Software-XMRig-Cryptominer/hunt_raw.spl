``` Threat: GeoVision Camera Software Abused to Deploy XMRig Cryptominer
    Author: Daniel Jeremiah | Date: 2026-11-13
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/GeoVision-Camera-Software-XMRig-Cryptominer ```
| multisearch
  [ search `rti_network(45.32.117.34 OR 156.246.94.183 OR 2.59.133.151)`
    | search dest_ip IN ("45.32.117.34", "156.246.94.183", "2.59.133.151")
    | eval data_model="network", ioc_type="ipv4", ioc=dest_ip, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
  ]
  [ search `rti_network(45.32.117.34 OR 156.246.94.183 OR 2.59.133.151)`
    | search src_ip IN ("45.32.117.34", "156.246.94.183", "2.59.133.151")
    | eval data_model="network", ioc_type="ipv4", ioc=src_ip, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
  ]
  [ search `rti_dns(cctv-update.top)`
    | search query IN ("cctv-update.top", "*.cctv-update.top")
    | rex field=query "(?i)(?<ioc>(?:cctv\-update\.top))\.?$"
    | eval data_model="dns", ioc_type="domain", host=src, detail="DNS query ".query
  ]
  [ search `rti_web(cctv-update.top OR 45.32.117.34)`
    | search url IN ("*://cctv-update.top*", "*.cctv-update.top*", "cctv-update.top*", "*45.32.117.34/a*", "*45.32.117.34/b*", "*45.32.117.34/c*") OR dest IN ("cctv-update.top", "*.cctv-update.top")
    | rex field=url "(?i)(?<ioc>45\.32\.117\.34/a|45\.32\.117\.34/b|45\.32\.117\.34/c|cctv\-update\.top)"
    | eval ioc=coalesce(ioc, dest), data_model="web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
  ]
  [ search `rti_endpoint(f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c OR b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b OR ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8)`
    | search file_hash IN ("*f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c*", "*b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b*", "*ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8*") OR process_hash IN ("*f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c*", "*b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b*", "*ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8*") OR parent_process_hash IN ("*f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c*", "*b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b*", "*ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8*")
    | eval matched=file_hash." ".process_hash." ".parent_process_hash
    | rex field=matched "(?i)(?<ioc>f1235751c9e48e5732b7b183dc2bb175a19e4c6401dfd0e96b4cfdd0d8c54b4c|b673c4d707828abedc767a2be6badef7454492e62c37e30cf3cc5a402fd3647b|ff5dbdcf6d7ae5d97b6f3ef412df0b977ba4a844c45b30ca78c0eeb2653d69a8)"
    | eval data_model="endpoint", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, detail=coalesce(process, file_path)
  ]
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_endpoint(GeoStartupAgentService)`
    | where match(coalesce(parent_process_name, ""), "(?i)GeoStartupAgentService\.exe$") AND match(coalesce(process_name, ""), "(?i)^(cmd|powershell|pwsh)\.exe$")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="GeoStartupAgentService.exe spawning a shell or PowerShell", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((wsftprm.sys OR kvckiller.sys))`
    | where match(coalesce(file_name, file_path, ""), "(?i)(wsftprm|kvckiller)\.sys")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="wsftprm.sys or kvckiller.sys driver load or file", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint("Image File Execution Options")`
    | where match(coalesce(registry_path, ""), "(?i)Image File Execution Options") AND match(coalesce(registry_value_name, ""), "(?i)^Debugger$") AND (match(coalesce(registry_path, ""), "(?i)(MsMpEng|SecurityHealthService|SecurityHealthSystray|MpCmdRun)\.exe") OR match(coalesce(registry_value_data, ""), "(?i)systray\.exe"))
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(registry_path, "-")." ".coalesce(registry_value_name, "-")."=".coalesce(registry_value_data, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="IFEO Debugger set on Microsoft Defender or Windows Security processes", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((PackageUpdater OR "systemprofile\\update.exe"))`
    | where match(coalesce(process, process_path, ""), "(?i)PackageUpdater|system32\\config\\systemprofile\\update\.exe")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="PackageUpdater task or update.exe from the systemprofile folder", ioc_type="behaviour (alert)"
]
| append [
    search index=* (EventCode=4698 OR EventCode=4702) PackageUpdater
    | eval host=coalesce(Computer, dest, dvc, host, "-"), user=coalesce(user, User, Account_Name, "-"), src="-", dest=coalesce(Computer, dest, dvc, host, "-"), detail=coalesce(TaskName, Task_Name, Message, _raw)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="windows_task"
    | eval ioc="PackageUpdater task or update.exe from the systemprofile folder", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(ApplyUpdate.exe)`
    | where match(coalesce(process_name, ""), "(?i)^ApplyUpdate\.exe$") AND match(coalesce(process, ""), "(?i)(--(url|user|pass|donate-level|coin|algo|tls)\b|\s-(o|u|p)\s|stratum\+)")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="ApplyUpdate.exe launched with XMRig arguments", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
