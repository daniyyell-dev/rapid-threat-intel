      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.principal.process.file.full_path, `(sqlservr|w3wp)\.exe$`) nocase and re.regex($e.target.process.file.full_path, `(cmd|powershell|pwsh)\.exe$`) nocase) or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.target.process.file.full_path, `ProgramData.(bdreinit|ask|w3wp)\.exe$`) nocase) or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.target.process.file.full_path, `breakchain[^\\/]*\.exe$`) nocase) or
