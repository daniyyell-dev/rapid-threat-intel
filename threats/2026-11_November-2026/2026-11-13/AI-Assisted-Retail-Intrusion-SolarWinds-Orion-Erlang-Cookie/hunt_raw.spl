    | rex field=matched "(?i)(?<ioc>54fb493822bcd832f7b2256015f13e3dfde815e1931e7fd39a90ea8ad3fdbd0a|a6579b16f895cf9ac4c31ba20606f2ad1ac4d1458e95c296da2afc1039881513|9c866c403e6bd5778fa3788cac9aac39aab1bf2d18a22c9999a4c27e30c0abf3|e95a265bf220a4330f77f842b3eeed8b1ed8c61f51d7e3f2fd33bac14b6b26af|c21e4fb40f871e418def63a5cdf3603ed4c3c6d1b218710db8ba45538b66fa01|6500890307f3860899f96452fea3effde777e6fcf369dc1e8861bdb65836d55e|7265d69dd8d8939dc888ce5f05190ce200ee2660f928f3b84f60e6a7b3383205|3d79628bf7804dbf17e7b396ecd62ebf5d66518940c6d23daccf59a20953438a|f042d705e1de3b5f9b8161ff59aa3ff80c684f5aaeac42be589a579ab1c7cf51|5db5e7f655c4ee94411df8110d1b6d02bb15574ac199fa7a553ce6c3cb25bf03|f8b67854d119da08c704b78f7c9fae0501417f5e63ffece86d2e811f1c7dea68|ef7c23619cf9293002fbe4f50147e806de0168cf186ca01fea2e113dc2eb1dce|b739635832c7f7f2be4821982980d2977165a2c8226f5912e6431db8c0cf6eea|0241f569f4ce1bf0f2470867d6ba40f23f78d4d3ee2fbc423c91f3b591f446bc|c9a5e9799f2844a71d0085697b3c2adb5528f4b9516146826193ddbe4d89423c|fad5dc8987df3206fdc50d0f4889bee06721d54a373bdc2f5545ba560562647e|2b7ed8dc34a83430029764d64f81c8f42e19c81fe923742558c96799a34dcf19|7c8eb7d23337536ed2aec14f1425c2fcd13976a4390cfecf653533e6a3bd87c4|ba4038fd20e474c047be8aad5bfacdb1bfc1ddbe12f803f473b7918d8d819436|deabe064a12641c4e95d4b133746f148d8ed4bcffd1dfe9ce1b6621dde2aa774|d92f20d73ade9a6134bec960aed0c02873e19cd03d707c85064c73ce0f852104|bcccfca65602e2691e25e8590a7029fa40712e05eac8bf203f3f5dc900b31ad4|9b077fc464d9a4a2e6b227e61eae8a759de13b728e7cd2f06563a1af0de93d19|59e51c54cf3ac4d375de96a358c15bc125fe5453ee29cf923276c429097b9eac|330e9314bd39898984e52e2e3cc01e84c9c4c95f5bc467cf5bc75cd539dd0438|2be9c2222cb177747f58f2ccb224a85879f1c2ffb0240e0b8968536d320b8edf|1df54c1c5ee76f2f8f962963df3962f1a688806631da01d0e5ce85b817a5e2f7|11b26168927a622ddc3beb592edc3bf476b897a360cbab36ad3ef0039068dd67|1f8565e14f8bcde3eb48a6676596d0cd8b7cc3c12d903f97b0e0b3ac8725c17c|d376e01930adabbe40634b8b16664a088d8bec2dc99aa88c16db9d302e45aaf5|642ea33ddf7eba3043cf7b567ccffe57d6671f640e7734072f02975dfa44d893|5ee783076e9c8b3830d8e2dccda9abf65be81a0b8dfc281ff12188f7607f1d38|dac237636f2fb1e44e28117999e77fc42a53d3b59b80cfb84928452ffe561793|76adf3141ccd877d98c85dbb7f6f227e70f71e8158392ac9797927260dd2faa3|5666332a66b1fb46bfbc7e076b21a8081f22931f5688686550d42bcec6aa3207|2ffe8c6910d08072ccb8fef133a4570c6a085289b669373b1b508bd294fe9b23|717319bc981c2b8f76907e2985f363540cb286f68aff0c75a5841eec2d0c9b04|7e9b60d021067dfe22b28783162ce9f55c2ccce7d221cadbf1f0f155dca6779e|9b7b2dadba43634e8f6b38f612287865800b6c790e83a69211da55434c26a74a|318ce2ca913ff8297f23886a6d6640f28f63ba2bb62c0c6897972265d71e1407)"
    | eval data_model="endpoint", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, detail=coalesce(process, file_path)
  ]
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_endpoint(erl.exe "-setcookie")`
    | where match(coalesce(process, ""), "(?i)erl\.exe.*-setcookie") AND match(coalesce(process, ""), "rpc:call|os,cmd")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Orion erl.exe with a stolen Erlang cookie running os:cmd", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((sqlservr.exe OR w3wp.exe))`
    | where match(coalesce(parent_process_name, ""), "(?i)^(sqlservr|w3wp)\.exe$") AND match(coalesce(process_name, ""), "(?i)^(cmd|powershell|pwsh)\.exe$")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Shell spawned by sqlservr.exe or w3wp.exe", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((bdreinit.exe OR ask.exe OR w3wp.exe))`
    | where (match(coalesce(process_name, ""), "(?i)^(bdreinit|ask)\.exe$") AND match(coalesce(process_path, process, ""), "(?i)ProgramData")) OR (match(coalesce(process_name, ""), "(?i)^w3wp\.exe$") AND NOT match(coalesce(process_path, process, ""), "(?i)inetsrv"))
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="bdreinit.exe or ask.exe side-loading from ProgramData", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(breakchain*)`
    | where match(coalesce(process_name, process, ""), "(?i)breakchain")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="BreakChain launcher relaunching payloads", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((certutil.exe OR csc.exe OR reg.exe))`
    | where (match(coalesce(process, ""), "(?i)certutil.*-decode.*ProgramData|csc\.exe.*ProgramData")) OR match(coalesce(process, ""), "(?i)reg(\.exe)?\s+save\s+hklm.(sam|security|system)")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="certutil and csc.exe in ProgramData, or hive dumps", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint((powershell.exe OR pwsh.exe))`
    | where len(coalesce(process, "")) > 500 AND match(coalesce(process, ""), "===[A-Z ]{4,}===|###[^#]{3,}###")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Long labelled PowerShell scripts from a server process", ioc_type="behaviour (hunt)"
]

| append [
    search `rti_endpoint("*.ps1")`
    | where match(coalesce(file_name, file_path, ""), "(?i)(^|[\\/])i\d+_[a-z0-9]+\.ps1$")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Numbered i<n>_*.ps1 spraying scripts", ioc_type="behaviour (hunt)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
