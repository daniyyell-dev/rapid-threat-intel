union isfuzzy=true
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " port ", RemotePort))),
  (DeviceLogonEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceLogonEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", LogonType, " ", AccountName))),
  (EntraIdSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSignInEvents", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (AADSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSignInEventsBeta", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (EntraIdSpnSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSpnSignInEvents", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (AADSpnSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSpnSignInEventsBeta", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(AccountDisplayName), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ActionType))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteUrl has_any (UrlKeys)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteUrl), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " ", RemoteIP))),
  (EmailUrlInfo
    | where Timestamp > ago(Lookback)
    | where Url has_any (UrlKeys)
    | project Timestamp, SourceTable = "EmailUrlInfo", Entity = tostring(NetworkMessageId), Indicator = tostring(Url), Context = tostring("URL in email")),
  (UrlClickEvents
    | where Timestamp > ago(Lookback)
    | where Url has_any (UrlKeys)
    | project Timestamp, SourceTable = "UrlClickEvents", Entity = tostring(AccountUpn), Indicator = tostring(Url), Context = tostring(strcat(ActionType, " ", Workload))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(ActionType, " ", FolderPath))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(FolderPath, " ", ProcessCommandLine))),
  (DeviceImageLoadEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceImageLoadEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(FolderPath, " loaded by ", InitiatingProcessFileName))),
  (EmailAttachmentInfo
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "EmailAttachmentInfo", Entity = tostring(RecipientEmailAddress), Indicator = tostring(SHA256), Context = tostring(strcat(FileName, " from ", SenderFromAddress))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName =~ "erl.exe" and ProcessCommandLine has "-setcookie" and (ProcessCommandLine has "rpc:call" or ProcessCommandLine has "os,cmd")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(FolderPath, " | parent ", InitiatingProcessFileName, " | ", AccountName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName in~ ("sqlservr.exe", "w3wp.exe") and FileName in~ ("cmd.exe", "powershell.exe", "pwsh.exe")
    | project ShellTime = Timestamp, DeviceId, DeviceName, Parent = InitiatingProcessFileName, ShellCmd = ProcessCommandLine
    | join kind=inner (
        DeviceProcessEvents
        | where Timestamp > ago(Lookback)
        | where FolderPath has @"\ProgramData\" and (FileName in~ ("bdreinit.exe", "ask.exe", "w3wp.exe", "mmc.exe") or FileName startswith "breakchain")
        | project StageTime = Timestamp, DeviceId, StageFile = FileName, StageCmd = ProcessCommandLine
    ) on DeviceId
    | where StageTime between (ShellTime .. ShellTime + 60m)
    | summarize Timestamp = max(StageTime), Stages = make_set(StageFile, 10), Shell = any(ShellCmd), ParentProc = any(Parent) by DeviceId, DeviceName
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(strcat_array(Stages, ", ")), Context = tostring(strcat(ParentProc, " shell then ProgramData stage within 60m: ", Shell))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName in~ ("sqlservr.exe", "w3wp.exe") and FileName in~ ("cmd.exe", "powershell.exe", "pwsh.exe")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | ", AccountName))),
  (DeviceImageLoadEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName in~ ("bdreinit.exe", "ask.exe") and FileName in~ ("log.dll", "ask.dll")
    | project Timestamp, SourceTable = "DeviceImageLoadEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(InitiatingProcessFolderPath, " loaded ", FileName, " | SHA256 ", SHA256))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where (FileName in~ ("bdreinit.exe", "ask.exe") and FolderPath has @"\ProgramData\") or (FileName =~ "w3wp.exe" and not(FolderPath has @"\inetsrv\"))
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(InitiatingProcessFileName, " > ", ProcessCommandLine))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName startswith "breakchain" or ProcessCommandLine has "breakchain"
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | SHA256 ", SHA256))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where (FileName =~ "certutil.exe" and ProcessCommandLine has "-decode" and ProcessCommandLine has "ProgramData") or (FileName =~ "csc.exe" and ProcessCommandLine has "ProgramData" and InitiatingProcessFileName in~ ("powershell.exe", "cmd.exe", "pwsh.exe"))
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | ", AccountName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName =~ "reg.exe" and ProcessCommandLine has "save" and (ProcessCommandLine has @"hklm\sam" or ProcessCommandLine has @"hklm\security" or ProcessCommandLine has @"hklm\system")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " | ", AccountName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName in~ ("powershell.exe", "pwsh.exe") and InitiatingProcessParentFileName in~ ("sqlservr.exe", "w3wp.exe", "cmd.exe") and strlen(ProcessCommandLine) > 500 and ProcessCommandLine matches regex @"===[A-Z ]{4,}===|###[^#]{3,}###"
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessParentFileName, " > ", InitiatingProcessFileName, " | ", AccountName))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FileName matches regex @"(?i)^i\d+_[a-z0-9]+\.ps1$"
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(ActionType, " ", FolderPath, " by ", InitiatingProcessFileName)))
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Hits = count(), Context = take_any(Context) by SourceTable, Entity, Indicator
| order by LastSeen desc
