// Threat: Barracuda Managed XDR Integration Credential Store Breach
// Author: Daniel Jeremiah | Date: 2026-11-13
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/Barracuda-Managed-XDR-Integration-Credential-Store-Breach
let Lookback = 30d;
let IPs = dynamic(["180.178.56.10", "52.128.238.126", "221.146.68.107", "2a09:bac1:7680:3d0::26b:5b"]);
union isfuzzy=true
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " port ", RemotePort))),
  (DeviceLogonEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceLogonEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", LogonType, " ", AccountName))),
  (EntraIdSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSignInEvents", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (AADSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSignInEventsBeta", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (EntraIdSpnSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSpnSignInEvents", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (AADSpnSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSpnSignInEventsBeta", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(AccountDisplayName), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ActionType))),
  (union isfuzzy=true
    (EntraIdSignInEvents
        | where Timestamp >= datetime(2026-11-01T00:00:00Z)
        | where IPAddress in ("180.178.56.10", "52.128.238.126", "221.146.68.107", "2a09:bac1:7680:3d0::26b:5b") or UserAgent has "read-only-audit"
        | project Timestamp, SourceTable = "EntraIdSignInEvents", Entity = tostring(coalesce(AccountUpn, Application, "")), Indicator = tostring(IPAddress), Context = strcat(coalesce(UserAgent, ""), " | ", coalesce(Application, ""), " | result=", tostring(coalesce(ErrorCode, "")), " | sp=", coalesce(ServicePrincipalName, ""))),
    (AADSignInEventsBeta
        | where Timestamp >= datetime(2026-11-01T00:00:00Z)
        | where IPAddress in ("180.178.56.10", "52.128.238.126", "221.146.68.107", "2a09:bac1:7680:3d0::26b:5b") or UserAgent has "read-only-audit"
        | project Timestamp, SourceTable = "AADSignInEventsBeta", Entity = tostring(coalesce(AccountUpn, Application, "")), Indicator = tostring(IPAddress), Context = strcat(coalesce(UserAgent, ""), " | ", coalesce(Application, ""), " | result=", tostring(coalesce(ErrorCode, "")), " | sp=", coalesce(ServicePrincipalName, ""))),
    (EntraIdSpnSignInEvents
        | where Timestamp >= datetime(2026-11-01T00:00:00Z)
        | where IPAddress in ("180.178.56.10", "52.128.238.126", "221.146.68.107", "2a09:bac1:7680:3d0::26b:5b") or column_ifexists("UserAgent", "") has "read-only-audit"
        | project Timestamp, SourceTable = "EntraIdSpnSignInEvents", Entity = tostring(coalesce(ServicePrincipalName, ApplicationId, "")), Indicator = tostring(IPAddress), Context = strcat(column_ifexists("UserAgent", ""), " | ", coalesce(ResourceDisplayName, ""), " | result=", tostring(coalesce(ErrorCode, "")), " | app=", tostring(ApplicationId))),
    (AADSpnSignInEventsBeta
        | where Timestamp >= datetime(2026-11-01T00:00:00Z)
        | where IPAddress in ("180.178.56.10", "52.128.238.126", "221.146.68.107", "2a09:bac1:7680:3d0::26b:5b") or column_ifexists("UserAgent", "") has "read-only-audit"
        | project Timestamp, SourceTable = "AADSpnSignInEventsBeta", Entity = tostring(coalesce(ServicePrincipalName, ApplicationId, "")), Indicator = tostring(IPAddress), Context = strcat(column_ifexists("UserAgent", ""), " | ", coalesce(ResourceDisplayName, ""), " | result=", tostring(coalesce(ErrorCode, "")), " | app=", tostring(ApplicationId))),
    (CloudAppEvents
        | where Timestamp >= datetime(2026-11-01T00:00:00Z)
        | where IPAddress in ("180.178.56.10", "52.128.238.126", "221.146.68.107", "2a09:bac1:7680:3d0::26b:5b") or tostring(RawEventData) has "read-only-audit" or column_ifexists("UserAgent", "") has "read-only-audit"
        | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(coalesce(AccountDisplayName, Application, "")), Indicator = tostring(IPAddress), Context = strcat(coalesce(Application, ""), " | ", coalesce(ActionType, ""), " | ", column_ifexists("UserAgent", ""))),
    (AWSCloudTrail
        | where TimeGenerated >= datetime(2026-11-01T00:00:00Z)
        | where SourceIpAddress in ("180.178.56.10", "52.128.238.126", "221.146.68.107", "2a09:bac1:7680:3d0::26b:5b") or UserAgent has "read-only-audit"
        | project Timestamp = TimeGenerated, SourceTable = "AWSCloudTrail", Entity = tostring(coalesce(UserIdentityArn, UserIdentityUserName, "")), Indicator = tostring(SourceIpAddress), Context = strcat(coalesce(EventName, ""), " | ", coalesce(EventSource, ""), " | ", coalesce(UserAgent, ""))))
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Hits = count(), Context = take_any(Context) by SourceTable, Entity, Indicator
| order by LastSeen desc
