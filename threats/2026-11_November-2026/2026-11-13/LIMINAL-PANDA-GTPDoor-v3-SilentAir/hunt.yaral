// Threat: LIMINAL PANDA GTPDoor v3 and SilentAir Mobile-Network Espionage
// Author: Daniel Jeremiah | Date: 2026-11-13
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/LIMINAL-PANDA-GTPDoor-v3-SilentAir
rule rti_liminal_panda_gtpdoor_v3_silentair {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-13"
    description = "LIMINAL PANDA GTPDoor v3 and SilentAir Mobile-Network Espionage"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/LIMINAL-PANDA-GTPDoor-v3-SilentAir"

  events:
    (
      $e.target.file.md5 = /^(?:35f0d4d0c5519a2957338e448fce53bc|da35d98c9a22e8ede93595d21fe7e63e)$/ nocase or
      $e.target.process.file.md5 = /^(?:35f0d4d0c5519a2957338e448fce53bc|da35d98c9a22e8ede93595d21fe7e63e)$/ nocase or
      $e.principal.process.file.md5 = /^(?:35f0d4d0c5519a2957338e448fce53bc|da35d98c9a22e8ede93595d21fe7e63e)$/ nocase or
      $e.principal.process.parent_process.file.md5 = /^(?:35f0d4d0c5519a2957338e448fce53bc|da35d98c9a22e8ede93595d21fe7e63e)$/ nocase or
      $e.target.file.md5 = "35f0d4d0c5519a2957338e448fce53bc" or $e.target.file.md5 = "da35d98c9a22e8ede93595d21fe7e63e" or $e.principal.process.file.md5 = "35f0d4d0c5519a2957338e448fce53bc" or $e.principal.process.file.md5 = "da35d98c9a22e8ede93595d21fe7e63e" or $e.target.process.file.md5 = "35f0d4d0c5519a2957338e448fce53bc" or $e.target.process.file.md5 = "da35d98c9a22e8ede93595d21fe7e63e"
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $file_md5 = array_distinct($e.target.file.md5)
    $process_md5 = array_distinct($e.target.process.file.md5)
    $process_path = array_distinct($e.target.process.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
