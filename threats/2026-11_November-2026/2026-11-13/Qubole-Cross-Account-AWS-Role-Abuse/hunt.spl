``` Threat: Qubole Cross-Account Access Abused: Vendor IAM Credentials Used to Assume Customer AWS Roles
    Author: Daniel Jeremiah | Date: 2026-11-13
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-13/Qubole-Cross-Account-AWS-Role-Abuse ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("57.129.54.120", "45.83.220.211", "185.209.199.73", "89.37.63.175")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("57.129.54.120", "45.83.220.211", "185.209.199.73", "89.37.63.175")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_hash IN ("*65f061281c9a712e9502793dc4c5035cae490b84da05f7d4223cefa65ad396e4*", "*1c7437dac21630f53c0b888b50662c6487e23fd7*", "*086d4a83181971e883c53a4c44f46da2*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.process_hash
    | rename "Processes.*" AS *
    | rex field=process_hash "(?i)(?<ioc>65f061281c9a712e9502793dc4c5035cae490b84da05f7d4223cefa65ad396e4|1c7437dac21630f53c0b888b50662c6487e23fd7|086d4a83181971e883c53a4c44f46da2)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_hash IN ("*65f061281c9a712e9502793dc4c5035cae490b84da05f7d4223cefa65ad396e4*", "*1c7437dac21630f53c0b888b50662c6487e23fd7*", "*086d4a83181971e883c53a4c44f46da2*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.parent_process_hash
    | rename "Processes.*" AS *
    | rex field=parent_process_hash "(?i)(?<ioc>65f061281c9a712e9502793dc4c5035cae490b84da05f7d4223cefa65ad396e4|1c7437dac21630f53c0b888b50662c6487e23fd7|086d4a83181971e883c53a4c44f46da2)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="parent process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_hash IN ("*65f061281c9a712e9502793dc4c5035cae490b84da05f7d4223cefa65ad396e4*", "*1c7437dac21630f53c0b888b50662c6487e23fd7*", "*086d4a83181971e883c53a4c44f46da2*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action Filesystem.file_hash
    | rename "Filesystem.*" AS *
    | rex field=file_hash "(?i)(?<ioc>65f061281c9a712e9502793dc4c5035cae490b84da05f7d4223cefa65ad396e4|1c7437dac21630f53c0b888b50662c6487e23fd7|086d4a83181971e883c53a4c44f46da2)"
    | eval data_model="Endpoint.Filesystem", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="file ".action." ".file_path
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*65f061281c9a712e9502793dc4c5035cae490b84da05f7d4223cefa65ad396e4*", "*1c7437dac21630f53c0b888b50662c6487e23fd7*", "*086d4a83181971e883c53a4c44f46da2*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>65f061281c9a712e9502793dc4c5035cae490b84da05f7d4223cefa65ad396e4|1c7437dac21630f53c0b888b50662c6487e23fd7|086d4a83181971e883c53a4c44f46da2)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    search index=* sourcetype="aws:cloudtrail" (805246085872 OR AIDA3W7DIFLYOLTK63SFS OR AIDAJYRRH5Y3A7AAJM2HW) | where (eventName="AssumeRole" AND (sourceIPAddress IN ("57.129.54.120", "45.83.220.211", "185.209.199.73", "89.37.63.175") OR match(sourceIPAddress, "^2001:41d0:70d:7800:")) AND ('userIdentity.accountId'="805246085872" OR like('userIdentity.principalId', "%AIDAJYRRH5Y3A7AAJM2HW%"))) OR like('userIdentity.principalId', "%AIDA3W7DIFLYOLTK63SFS%")
    | eval host=coalesce(recipientAccountId, 'userIdentity.accountId'), user=coalesce('userIdentity.sessionContext.sessionIssuer.arn', 'userIdentity.arn'), src=sourceIPAddress, dest=coalesce('requestParameters.roleArn', "-"), detail=eventName." session ".coalesce('requestParameters.roleSessionName', "-")." from ".sourceIPAddress
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="aws:cloudtrail"
    | eval ioc="Qubole account role assumption from a non-AWS address", ioc_type="behaviour (alert)"
]

| append [
    search index=* sourcetype="aws:cloudtrail" "quiam-"
    | eval host=coalesce(recipientAccountId, 'userIdentity.accountId'), user=coalesce('userIdentity.sessionContext.sessionIssuer.arn', 'userIdentity.arn'), src=sourceIPAddress, dest=coalesce('requestParameters.roleArn', 'userIdentity.arn', "-"), detail=eventName." session quiam-* from ".sourceIPAddress
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="aws:cloudtrail"
    | eval ioc="quiam-* role sessions harvesting secrets or S3", ioc_type="behaviour (alert)"
]

| append [
    search index=* ("57.129.54.120" OR "45.83.220.211" OR "185.209.199.73" OR "89.37.63.175" OR "2001:41d0:70d:7800")
    | eval host=host, user=coalesce(user, 'userIdentity.arn', "-"), src=coalesce(sourceIPAddress, src_ip, src, "-"), dest=sourcetype, detail=coalesce(eventName, action, "-")." UA ".coalesce(userAgent, http_user_agent, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="cloud and identity logs"
    | eval ioc="TruffleHog credential checks from the attacker addresses", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
