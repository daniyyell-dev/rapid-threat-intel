``` Threat: Fake Microsoft 365 Outage Notices Lure Users to Restore Held Messages
    Author: Daniel Jeremiah | Date: 2026-11-14
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-14/Microsoft-365-Outage-Service-Health-Phishing ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Resolution.DNS
    WHERE DNS.query IN ("reallifeaccounting.com", "*.reallifeaccounting.com", "moments-notice.com", "*.moments-notice.com", "planetmaison.com", "*.planetmaison.com", "newbooker.com", "*.newbooker.com")
    BY DNS.src DNS.dest DNS.query DNS.reply_code
| rename "DNS.*" AS *
| rex field=query "(?i)(?<ioc>(?:reallifeaccounting\.com|moments\-notice\.com|planetmaison\.com|newbooker\.com))\.?$"
| eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url IN ("*://reallifeaccounting.com*", "*.reallifeaccounting.com*", "reallifeaccounting.com*", "*://moments-notice.com*", "*.moments-notice.com*", "moments-notice.com*", "*://planetmaison.com*", "*.planetmaison.com*", "planetmaison.com*", "*://newbooker.com*", "*.newbooker.com*", "newbooker.com*") OR Web.dest IN ("reallifeaccounting.com", "*.reallifeaccounting.com", "moments-notice.com", "*.moments-notice.com", "planetmaison.com", "*.planetmaison.com", "newbooker.com", "*.newbooker.com"))
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>reallifeaccounting\.com|moments\-notice\.com|planetmaison\.com|newbooker\.com)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.url IN ("*://reallifeaccounting.com*", "*.reallifeaccounting.com*", "reallifeaccounting.com*", "*://moments-notice.com*", "*.moments-notice.com*", "moments-notice.com*", "*://planetmaison.com*", "*.planetmaison.com*", "planetmaison.com*", "*://newbooker.com*", "*.newbooker.com*", "newbooker.com*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>reallifeaccounting\.com|moments\-notice\.com|planetmaison\.com|newbooker\.com)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
