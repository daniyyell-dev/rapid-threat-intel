// Threat: Fake Microsoft 365 Outage Notices Lure Users to Restore Held Messages
// Author: Daniel Jeremiah | Date: 2026-11-14
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-14/Microsoft-365-Outage-Service-Health-Phishing
rule rti_microsoft_365_outage_service_health_phishing {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-14"
    description = "Fake Microsoft 365 Outage Notices Lure Users to Restore Held Messages"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-14/Microsoft-365-Outage-Service-Health-Phishing"

  events:
    (
      $e.network.dns.questions.name = /(?:^|\.)(?:reallifeaccounting\.com|moments\-notice\.com|planetmaison\.com|newbooker\.com)\.?$/ nocase or
      $e.target.hostname = /(?:^|\.)(?:reallifeaccounting\.com|moments\-notice\.com|planetmaison\.com|newbooker\.com)\.?$/ nocase or
      $e.target.domain.name = /(?:^|\.)(?:reallifeaccounting\.com|moments\-notice\.com|planetmaison\.com|newbooker\.com)\.?$/ nocase or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:(?:[^/?#@]*\.)?(?:reallifeaccounting\.com|moments\-notice\.com|planetmaison\.com|newbooker\.com)(?::\d+)?(?:[/?#]|$))`) nocase
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $dns_query = array_distinct($e.network.dns.questions.name)
    $target_hostname = array_distinct($e.target.hostname)
    $target_url = array_distinct($e.target.url)

  condition:
    $e

  options:
    allow_zero_values = true
}
