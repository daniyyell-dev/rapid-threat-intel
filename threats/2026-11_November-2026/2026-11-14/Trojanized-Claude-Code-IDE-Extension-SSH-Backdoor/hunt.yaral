// Threat: Trojanized Claude Code IDE Extension Plants Persistent Reverse SSH Backdoor on Developer Machines
// Author: Daniel Jeremiah | Date: 2026-11-14
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-14/Trojanized-Claude-Code-IDE-Extension-SSH-Backdoor
rule rti_trojanized_claude_code_ide_extension_ssh_backdoor {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-14"
    description = "Trojanized Claude Code IDE Extension Plants Persistent Reverse SSH Backdoor on Developer Machines"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-14/Trojanized-Claude-Code-IDE-Extension-SSH-Backdoor"

  events:
    (
      $e.principal.ip = /^(?:134\.209\.82\.225)$/ or
      $e.target.ip = /^(?:134\.209\.82\.225)$/ or
      $e.network.dns.answers.data = /^(?:134\.209\.82\.225)$/ or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:134\.209\.82\.225:8099/beacon)`) nocase or
      $e.target.file.sha256 = /^(?:ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15|7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278|fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364|3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081|80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c|6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731)$/ nocase or
      $e.target.process.file.sha256 = /^(?:ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15|7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278|fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364|3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081|80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c|6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731)$/ nocase or
      $e.principal.process.file.sha256 = /^(?:ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15|7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278|fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364|3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081|80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c|6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731)$/ nocase or
      $e.principal.process.parent_process.file.sha256 = /^(?:ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15|7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278|fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364|3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081|80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c|6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731)$/ nocase or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.target.process.file.full_path, `(^|[\\/])(ssh|ssh\.exe|autossh)$`) nocase and re.regex($e.target.process.command_line, `(^|\s)-[A-Za-z]*R\s`) and strings.contains($e.target.process.command_line, "0:localhost:22")) or
      re.regex($e.target.file.full_path, `([\\/]\.config[\\/](\.smt|\.smtk|smt\.cmd|smtk)$|com\.apple\.sysmond\.plist$|[\\/]\.stk_[0-9a-f]{10}$|\\Startup\\sysmon\.cmd$)`) nocase
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $target_url = array_distinct($e.target.url)
    $file_sha256 = array_distinct($e.target.file.sha256)
    $process_sha256 = array_distinct($e.target.process.file.sha256)
    $process_path = array_distinct($e.target.process.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
