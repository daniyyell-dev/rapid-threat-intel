``` Threat: Trojanized Claude Code IDE Extension Plants Persistent Reverse SSH Backdoor on Developer Machines
    Author: Daniel Jeremiah | Date: 2026-11-14
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-14/Trojanized-Claude-Code-IDE-Extension-SSH-Backdoor ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("134.209.82.225")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("134.209.82.225")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url IN ("*134.209.82.225:8099/beacon*"))
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>134\.209\.82\.225:8099/beacon)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_hash IN ("*ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15*", "*7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278*", "*fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364*", "*3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081*", "*80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c*", "*6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.process_hash
    | rename "Processes.*" AS *
    | rex field=process_hash "(?i)(?<ioc>ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15|7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278|fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364|3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081|80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c|6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_hash IN ("*ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15*", "*7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278*", "*fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364*", "*3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081*", "*80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c*", "*6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.parent_process_hash
    | rename "Processes.*" AS *
    | rex field=parent_process_hash "(?i)(?<ioc>ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15|7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278|fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364|3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081|80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c|6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="parent process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_hash IN ("*ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15*", "*7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278*", "*fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364*", "*3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081*", "*80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c*", "*6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action Filesystem.file_hash
    | rename "Filesystem.*" AS *
    | rex field=file_hash "(?i)(?<ioc>ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15|7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278|fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364|3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081|80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c|6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731)"
    | eval data_model="Endpoint.Filesystem", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="file ".action." ".file_path
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15*", "*7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278*", "*fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364*", "*3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081*", "*80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c*", "*6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731*") OR All_Email.url IN ("*134.209.82.225:8099/beacon*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>ecb58cb29078d9646ad1dcdbe51526f2d9cfea06be5fb2ab183e8ecc3ab6bf15|7e0a52885fadee05544a9e99eb18c792bec05900a5e1a66d68f8383decb0e278|fcbb327e38e61c4fec795e0d0591f52cd1014b813d20a5912104953c3a17c364|3de1722901165769893bef57c72594e9a54459faa23f3091b136b79966edd081|80402fdcad8799285fd93044976973ca000da7995fb93363f819bb8e4f84ee6c|6786ec90cbd45949695bd7805c9fbb26cfc91bc5fc897de0183d9bcb9cb21731|134\.209\.82\.225:8099/beacon)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name IN ("ssh.exe", "ssh", "autossh") Processes.process="*-R*" Processes.process="*0:localhost:22*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="ssh reverse tunnel to local port 22", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name IN ("smt.cmd", "smtk", ".smt", ".smtk", "com.apple.sysmond.plist", ".stk_*") OR (Filesystem.file_name="sysmon.cmd" Filesystem.file_path="*\\Startup\\*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="SysMon, sysmond or .smt persistence files", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
