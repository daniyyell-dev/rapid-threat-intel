``` Threat: Xen Orchestra Authentication Bypass (VSA-2026-062) Exploited to Take Over XCP-ng Hosts
    Author: Daniel Jeremiah | Date: 2026-11-11
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/Xen-Orchestra-VSA-2026-062-Auth-Bypass-XCP-ng-Takeover ```
| multisearch
  [ search `rti_network(91.211.251.112 OR 193.148.56.72 OR 37.221.208.216 OR 45.66.35.11 OR 64.65.0.120 OR 64.65.62.160 OR 89.47.51.90 OR 92.60.37.247)`
    | search dest_ip IN ("91.211.251.112", "193.148.56.72", "37.221.208.216", "45.66.35.11", "64.65.0.120", "64.65.62.160", "89.47.51.90", "92.60.37.247")
    | eval data_model="network", ioc_type="ipv4", ioc=dest_ip, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
  ]
  [ search `rti_network(91.211.251.112 OR 193.148.56.72 OR 37.221.208.216 OR 45.66.35.11 OR 64.65.0.120 OR 64.65.62.160 OR 89.47.51.90 OR 92.60.37.247)`
    | search src_ip IN ("91.211.251.112", "193.148.56.72", "37.221.208.216", "45.66.35.11", "64.65.0.120", "64.65.62.160", "89.47.51.90", "92.60.37.247")
    | eval data_model="network", ioc_type="ipv4", ioc=src_ip, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
  ]
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_web(authenticationToken)`
    | where like(cookie, "%authenticationToken=j:%") OR like(_raw, "%authenticationToken=j:%")
    | eval host=dest, user=user, src=src, dest=dest, detail="HTTP ".coalesce(status, "-")." ".coalesce(url, "-")." UA: ".coalesce(http_user_agent, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="web"
    | eval ioc="Auth-bypass cookie sent to Xen Orchestra", ioc_type="behaviour (alert)"
]

| append [
    search `rti_web("authentication_tokens")`
    | where like(url, "%/rest/v0/users/me/authentication_tokens%")
    | eval host=dest, user=user, src=src, dest=dest, detail="HTTP ".coalesce(status, "-")." ".coalesce(url, "-")." UA: ".coalesce(http_user_agent, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="web"
    | eval ioc="Login-token harvesting requests", ioc_type="behaviour (hunt)"
]

| append [
    search index=* ("-serial file:" OR "pivot2" OR "hvm_serial")
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="XCP-ng logs"
    | eval ioc="Attacker foothold VM on XCP-ng", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(zz-ustar* OR ustar5 OR ustar6 OR ld.so.preload)`
    | where match(file_path, "^(/etc/cron\.d/zz-ustar|/\.ustar[56]$|/etc/ld\.so\.preload$)")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Persistence files on XCP-ng hosts", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
