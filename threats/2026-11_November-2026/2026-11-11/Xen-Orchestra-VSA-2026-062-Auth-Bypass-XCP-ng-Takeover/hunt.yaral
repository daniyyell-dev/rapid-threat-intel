// Threat: Xen Orchestra Authentication Bypass (VSA-2026-062) Exploited to Take Over XCP-ng Hosts
// Author: Daniel Jeremiah | Date: 2026-11-11
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/Xen-Orchestra-VSA-2026-062-Auth-Bypass-XCP-ng-Takeover
rule rti_xen_orchestra_vsa_2026_062_auth_bypass_xcp_ng_takeover {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-11"
    description = "Xen Orchestra Authentication Bypass (VSA-2026-062) Exploited to Take Over XCP-ng Hosts"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/Xen-Orchestra-VSA-2026-062-Auth-Bypass-XCP-ng-Takeover"

  events:
    (
      $e.principal.ip = /^(?:91\.211\.251\.112|193\.148\.56\.72|37\.221\.208\.216|45\.66\.35\.11|64\.65\.0\.120|64\.65\.62\.160|89\.47\.51\.90|92\.60\.37\.247)$/ or
      $e.target.ip = /^(?:91\.211\.251\.112|193\.148\.56\.72|37\.221\.208\.216|45\.66\.35\.11|64\.65\.0\.120|64\.65\.62\.160|89\.47\.51\.90|92\.60\.37\.247)$/ or
      $e.network.dns.answers.data = /^(?:91\.211\.251\.112|193\.148\.56\.72|37\.221\.208\.216|45\.66\.35\.11|64\.65\.0\.120|64\.65\.62\.160|89\.47\.51\.90|92\.60\.37\.247)$/ or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and $e.target.process.command_line = /-serial file:|hvm_serial/ nocase) or
      (($e.metadata.event_type = "FILE_CREATION" or $e.metadata.event_type = "FILE_MODIFICATION" or $e.metadata.event_type = "FILE_MOVE") and $e.target.file.full_path = /^(\/etc\/cron\.d\/zz-ustar[0-9]*|\/\.ustar[56]|\/etc\/ld\.so\.preload)$/)
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
