| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_endpoint(Unblock-File OR "Zone.Identifier" OR (wscript AND "//B") OR nvdg_worker)`
    | where match(coalesce(process, process_name, ""), "(?i)Unblock-File|Zone\.Identifier|//B|nvdg_worker")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="MOTW strip then hidden wscript within 10 minutes", ioc_type="behaviour (alert)"
]
| append [
    search `rti_endpoint(nvdg_worker)`
    | where match(coalesce(process, process_name, ""), "(?i)nvdg_worker")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="MOTW strip then hidden wscript within 10 minutes", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(nvdg_worker)`
    | where match(coalesce(process, process_name, file_name, ""), "(?i)nvdg_worker")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Hidden wscript launching ~nvdg_worker.vbs", ioc_type="behaviour (alert)"
]

| append [
    search `rti_web(drop-indexings/tasks OR up-indexings/tasks)`
    | where match(coalesce(url, ""), "(?i)(drop|up)-indexings/tasks")
    | eval host=dest, user=user, src=src, dest=dest, detail="HTTP ".coalesce(status, "-")." ".coalesce(url, "-")." UA: ".coalesce(http_user_agent, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="web"
    | eval ioc="GitLab dead-drop for the current C2", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(install_guard.js OR verify_w OR verify_m)`
    | where match(coalesce(process, process_name, file_name, url, ""), "(?i)install_guard|verify_w|verify_m|guard-launcher-result|guard-install-log")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="install_guard.js or verify_w / verify_m loaders", ioc_type="behaviour (hunt)"
]

| append [
    search `rti_endpoint(GoogleUpdateSupporterNode OR UpdateSupporter OR google-agent.service OR google-update-support OR run-update-agent.vbs)`
    | where match(coalesce(process, process_name, ""), "(?i)GoogleUpdateSupporterNode|com\.google\.UpdateSupporter|google-agent\.service|google-update-support|run-update-agent\.vbs")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Fake Google Update persistence", ioc_type="behaviour (hunt)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
