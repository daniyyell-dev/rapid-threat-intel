``` Threat: Trigram: DPRK Dropper Chain Targeting AI, Blockchain and Logistics (Kimsuky / UNK_DeadDrop)
    Author: Daniel Jeremiah | Date: 2026-11-11
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/Trigram-DPRK-Dropper-Kimsuky-UNK-DeadDrop ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("170.205.31.182", "216.198.79.1", "198.54.127.82", "170.205.29.83", "185.147.159.187", "146.19.215.187", "170.205.30.27", "193.160.32.10", "193.160.32.188", "65.110.40.18", "170.205.28.251", "193.160.32.243", "208.84.100.64", "23.137.104.77")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("170.205.31.182", "216.198.79.1", "198.54.127.82", "170.205.29.83", "185.147.159.187", "146.19.215.187", "170.205.30.27", "193.160.32.10", "193.160.32.188", "65.110.40.18", "170.205.28.251", "193.160.32.243", "208.84.100.64", "23.137.104.77")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
