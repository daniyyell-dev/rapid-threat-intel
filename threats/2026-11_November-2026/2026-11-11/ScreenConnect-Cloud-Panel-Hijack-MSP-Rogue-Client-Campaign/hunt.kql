let Lookback = 30d;
let IPs = dynamic(["185.99.255.28", "155.94.150.39"]);
let Domains = dynamic(["newnewnew.gotdns.org", "soxnewwork.homedns.org", "sc.payproofkit.com", "cdn007-digitaldownloads.com", "amexsafekeyupdate.com", "ns.mo7sen.dev"]);
let Urls = dynamic(["https://ns.mo7sen.dev/EadF.php?p=4", "https://ns.mo7sen.dev/EadF.php?p=5", "https://ns.mo7sen.dev/EadF.php"]);
let UrlKeys = dynamic(["ns.mo7sen.dev/EadF.php?p=4", "ns.mo7sen.dev/EadF.php?p=5", "ns.mo7sen.dev/EadF.php"]);
let SHA256s = dynamic(["60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb", "94b93c649b0ae0281352da9d01761fa9195ab1e6ac7010af3b9ba1646355eb11", "7a9aca9fdd4dcc13fe497cabdb13ca1e5d6a529271c8aa495e5ca1c1c80271ec", "b93f10f30ee453d1e1c046fec9d141c41d7680be5cd46c3aeb3febe0f4953b4d", "3c7a98f0fdb6235b8076319c74dc1085f7b349b6d750416dd0cadb07d7972ec4", "d2ed7a7bf4f8ac9c7969e9b3a07ebd4dda0d858f372c876ac0a041611698de9a", "4a1dd3cd2ea14368afadf7e9dfdd63b104e3981ef8c85bbb6510919b810af04b", "8cb5f48bbe70b5248db7f327f3d1ad6649df5c767d2a7e0711ee147fd92e06af", "cf50d73fa8117a758093b1344de41cd6a6ccddc645cdda1fa91a9264efe93956", "81cc2baa35b798d6084bd078662fa29ff28df02c46c6ccdb2b43bde97d19f781", "c31e6f075cd77e01839aebce32ed35659a9ee962d102aca53040bb5e297410a9", "deda7c30d798a19b6699a45fbcba503cf778594df9163c61c2f96bb2d2b9fb45", "0bd84c776dc01f784a617e73fc77b269f847fc4a062ffd489e4692869724bf08", "454c43d296b1276bde9a4f6ff1da2221cb35ccdb2fc7991bdd572e45bce12a8a", "5dd3a6ba806ac472663e243cfc1c034c534d5d9a42ec362c3dbf0f8d950148d0", "43b7a5e56f9e6c7b74e1ce2b7b5af63f383084625fcc2d3a5985fa1059e2db95", "50659748723e906c8b3d3c0386bd4cf692f693a3e23639398c1a14d0c31fed61", "a1937467fd862916f89342cdd61f55c4bc405fb35b6e1379e27cfbfdba77dcdc", "338e37f58043635ebab64ee5fdc919935e55cb146ca97834b358f934e55e88ec", "8e6912deed82e80bb6bd66f73509d024b1f78b993515366d8317e69a97cff4f4", "d85315bd7602b6f5c13dc0eada2c9cba0892c7cd3b1eb7dacb1bffdd536ceb21"]);
union isfuzzy=true
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " port ", RemotePort))),
  (DeviceLogonEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceLogonEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", LogonType, " ", AccountName))),
  (EntraIdSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSignInEvents", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (AADSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSignInEventsBeta", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (EntraIdSpnSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSpnSignInEvents", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (AADSpnSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSpnSignInEventsBeta", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(AccountDisplayName), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ActionType))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteUrl has_any (Domains)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteUrl), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " ", RemoteIP))),
  (DeviceEvents
    | where Timestamp > ago(Lookback)
    | where ActionType == "DnsQueryResponse" and tostring(parse_json(AdditionalFields).DnsQueryString) has_any (Domains)
    | project Timestamp, SourceTable = "DeviceEvents", Entity = tostring(DeviceName), Indicator = tostring(parse_json(AdditionalFields).DnsQueryString), Context = tostring(strcat("DNS ", InitiatingProcessFileName))),
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteUrl has_any (UrlKeys)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteUrl), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " ", RemoteIP))),
  (EmailUrlInfo
    | where Timestamp > ago(Lookback)
    | where UrlDomain has_any (Domains) or Url has_any (UrlKeys)
    | project Timestamp, SourceTable = "EmailUrlInfo", Entity = tostring(NetworkMessageId), Indicator = tostring(Url), Context = tostring("URL in email")),
  (UrlClickEvents
    | where Timestamp > ago(Lookback)
    | where Url has_any (Domains) or Url has_any (UrlKeys)
    | project Timestamp, SourceTable = "UrlClickEvents", Entity = tostring(AccountUpn), Indicator = tostring(Url), Context = tostring(strcat(ActionType, " ", Workload))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(ActionType, " ", FolderPath))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(FolderPath, " ", ProcessCommandLine))),
  (DeviceImageLoadEvents
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "DeviceImageLoadEvents", Entity = tostring(DeviceName), Indicator = tostring(SHA256), Context = tostring(strcat(FolderPath, " loaded by ", InitiatingProcessFileName))),
  (EmailAttachmentInfo
    | where Timestamp > ago(Lookback)
    | where SHA256 in~ (SHA256s)
    | project Timestamp, SourceTable = "EmailAttachmentInfo", Entity = tostring(RecipientEmailAddress), Indicator = tostring(SHA256), Context = tostring(strcat(FileName, " from ", SenderFromAddress))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where ProcessCommandLine has_any ("TrapWatch", "RelayTrap", "sckit-", "Panel-Lateral.ps1", "Run-Lateral-Full.bat", "ToolboxRelayUploader", "EadF.php", "Stage0Loader", "LabConfig.ps1", "2588ef5c15954b10", "ed630cc2c873b091", "d905b2b1b165d0a9", "4b8f4089ddaac6a9", "df1f7ef0cfacd0d8", "c=Exploited") or FileName in~ ("ToolboxRelayUploader.exe", "runnew.cmd")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(FolderPath, " ", ProcessCommandLine))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where (InitiatingProcessFileName startswith "ScreenConnect" or InitiatingProcessFolderPath has "ScreenConnect") and ProcessCommandLine has "ScreenConnect.ClientSetup"
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " ", ProcessCommandLine))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName =~ "ScreenConnect.ClientService.exe" and ProcessCommandLine has_any ("2588ef5c15954b10", "ed630cc2c873b091", "185.99.255.28", "newnewnew.gotdns.org", "soxnewwork.homedns.org", "sc.payproofkit.com", "c=Exploited")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(FolderPath, " ", ProcessCommandLine))),
  (DeviceEvents
    | where Timestamp > ago(Lookback)
    | where ActionType in ("ScheduledTaskCreated", "ScheduledTaskUpdated") and tostring(AdditionalFields) has "TrapWatch"
    | project Timestamp, SourceTable = "DeviceEvents", Entity = tostring(DeviceName), Indicator = tostring(ActionType), Context = tostring(strcat("Task: ", tostring(AdditionalFields.TaskName)))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName =~ "schtasks.exe" and ProcessCommandLine has "TrapWatch"
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", ProcessCommandLine))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FolderPath has @"\ProgramData\RelayTrap" or FolderPath has @"\sckit-" or FileName in~ ("Panel-Lateral.ps1", "Run-Lateral-Full.bat", "ToolboxRelayUploader.exe")
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(ActionType, " by ", InitiatingProcessFileName))),
  (DeviceRegistryEvents
    | where Timestamp > ago(Lookback)
    | where RegistryValueName =~ "RelayTrapLiteAlert" or RegistryValueData has "RelayTrap"
    | project Timestamp, SourceTable = "DeviceRegistryEvents", Entity = tostring(DeviceName), Indicator = tostring(RegistryKey), Context = tostring(strcat(ActionType, " ", RegistryValueName, " = ", RegistryValueData))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName startswith "ScreenConnect" or InitiatingProcessFileName startswith "ScreenConnect"
    | summarize ScTime = min(Timestamp) by DeviceId, bin(Timestamp, 1h)
    | join kind=inner (
        DeviceProcessEvents
        | where Timestamp > ago(Lookback)
        | where FileName =~ "sqlite3.exe"
        | project SqlTime = Timestamp, DeviceId, DeviceName, SqlCmd = ProcessCommandLine, SqlPath = FolderPath
    ) on DeviceId
    | where SqlTime >= ScTime and SqlTime <= ScTime + 60m
    | project Timestamp = SqlTime, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(SqlCmd), Context = tostring(strcat("sqlite3 after ScreenConnect activity within 60m; path: ", SqlPath, iff(SqlCmd has_any ("Cookies", "Login Data", "Web Data"), "; browser profile data in command line", "")))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where (InitiatingProcessFileName startswith "ScreenConnect" or FolderPath has "ScreenConnect" or FolderPath has @"\ProgramData\RelayTrap") and (FileName in~ ("Run-Lateral-Full.bat", "Panel-Lateral.ps1", "LabConfig.ps1") or FileName matches regex @"^k[0-9a-f]{32}\.ps1$")
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(ActionType, " ", FolderPath, "\\", FileName, " by ", InitiatingProcessFileName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName startswith "ScreenConnect" and (FileName in~ ("cmd.exe", "powershell.exe", "pwsh.exe") or ProcessCommandLine has_any ("Run-Lateral-Full.bat", "Panel-Lateral.ps1", "LabConfig.ps1", "EadF.php"))
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " ", ProcessCommandLine))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where FileName in~ ("powershell.exe", "pwsh.exe", "sqlite3.exe") and ProcessCommandLine has_any (".ASPXAUTH", "Cookies", "Login Data", "Web Data", "LabConfig.ps1", "Panel-Lateral")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(InitiatingProcessFileName, " > ", FileName, " ", ProcessCommandLine))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName in~ ("powershell.exe", "pwsh.exe", "sqlite3.exe") and (FileName in~ ("Cookies", "Login Data", "Web Data") or FolderPath has "Cookies" or FolderPath has "User Data")
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FolderPath), Context = tostring(strcat(ActionType, " ", FolderPath, "\\", FileName, " by ", InitiatingProcessFileName)))
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Hits = count(), Context = take_any(Context) by SourceTable, Entity, Indicator
| order by LastSeen desc
