        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>ns\.mo7sen\.dev/EadF\.php\?p=4|ns\.mo7sen\.dev/EadF\.php\?p=5|ns\.mo7sen\.dev/EadF\.php|newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com|amexsafekeyupdate\.com|ns\.mo7sen\.dev|007\.from\-ak\.com)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
