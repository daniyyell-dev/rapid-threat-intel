``` Threat: ScreenConnect Cloud Panel Hijack: Rogue Clients Pushed to MSP-Managed Endpoints
    Author: Daniel Jeremiah | Date: 2026-11-11
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/ScreenConnect-Cloud-Panel-Hijack-MSP-Rogue-Client-Campaign ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("185.99.255.28", "155.94.150.39")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("185.99.255.28", "155.94.150.39")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Resolution.DNS
        WHERE DNS.query IN ("newnewnew.gotdns.org", "*.newnewnew.gotdns.org", "soxnewwork.homedns.org", "*.soxnewwork.homedns.org", "sc.payproofkit.com", "*.sc.payproofkit.com", "cdn007-digitaldownloads.com", "*.cdn007-digitaldownloads.com", "amexsafekeyupdate.com", "*.amexsafekeyupdate.com")
        BY DNS.src DNS.dest DNS.query DNS.reply_code
    | rename "DNS.*" AS *
    | rex field=query "(?i)(?<ioc>(?:newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com|amexsafekeyupdate\.com))\.?$"
    | eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url IN ("*://newnewnew.gotdns.org*", "*.newnewnew.gotdns.org*", "newnewnew.gotdns.org*", "*://soxnewwork.homedns.org*", "*.soxnewwork.homedns.org*", "soxnewwork.homedns.org*", "*://sc.payproofkit.com*", "*.sc.payproofkit.com*", "sc.payproofkit.com*", "*://cdn007-digitaldownloads.com*", "*.cdn007-digitaldownloads.com*", "cdn007-digitaldownloads.com*", "*://amexsafekeyupdate.com*", "*.amexsafekeyupdate.com*", "amexsafekeyupdate.com*") OR Web.dest IN ("newnewnew.gotdns.org", "*.newnewnew.gotdns.org", "soxnewwork.homedns.org", "*.soxnewwork.homedns.org", "sc.payproofkit.com", "*.sc.payproofkit.com", "cdn007-digitaldownloads.com", "*.cdn007-digitaldownloads.com", "amexsafekeyupdate.com", "*.amexsafekeyupdate.com") OR Web.url IN ("*ns.mo7sen.dev/EadF.php?p=4*"))
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>ns\.mo7sen\.dev/EadF\.php\?p=4|newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com|amexsafekeyupdate\.com)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_hash IN ("*60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.process_hash
    | rename "Processes.*" AS *
    | rex field=process_hash "(?i)(?<ioc>60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_hash IN ("*60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb*")
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.parent_process_hash
    | rename "Processes.*" AS *
    | rex field=parent_process_hash "(?i)(?<ioc>60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb)"
    | eval data_model="Endpoint.Processes", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="parent process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_hash IN ("*60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb*")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action Filesystem.file_hash
    | rename "Filesystem.*" AS *
    | rex field=file_hash "(?i)(?<ioc>60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb)"
    | eval data_model="Endpoint.Filesystem", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, src="-", detail="file ".action." ".file_path
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb*") OR All_Email.url IN ("*ns.mo7sen.dev/EadF.php?p=4*", "*://newnewnew.gotdns.org*", "*.newnewnew.gotdns.org*", "newnewnew.gotdns.org*", "*://soxnewwork.homedns.org*", "*.soxnewwork.homedns.org*", "soxnewwork.homedns.org*", "*://sc.payproofkit.com*", "*.sc.payproofkit.com*", "sc.payproofkit.com*", "*://cdn007-digitaldownloads.com*", "*.cdn007-digitaldownloads.com*", "cdn007-digitaldownloads.com*", "*://amexsafekeyupdate.com*", "*.amexsafekeyupdate.com*", "amexsafekeyupdate.com*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb|ns\.mo7sen\.dev/EadF\.php\?p=4|newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com|amexsafekeyupdate\.com)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_name="ScreenConnect*" AND Processes.process="*ScreenConnect.ClientSetup*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Second ScreenConnect client pushed by Run Command", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="ScreenConnect.ClientService.exe" AND (Processes.process="*2588ef5c15954b10*" OR Processes.process="*ed630cc2c873b091*" OR Processes.process="*185.99.255.28*" OR Processes.process="*newnewnew.gotdns.org*" OR Processes.process="*soxnewwork.homedns.org*" OR Processes.process="*sc.payproofkit.com*" OR Processes.process="*c=Exploited*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Rogue ScreenConnect client IDs or attacker relay", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process="*TrapWatch*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="TrapWatch scheduled task persistence", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_path="*\ProgramData\RelayTrap*" OR Filesystem.file_path="*\sckit-*" OR Filesystem.file_name IN ("Panel-Lateral.ps1", "Run-Lateral-Full.bat", "ToolboxRelayUploader.exe")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="RelayTrap and sckit staging files", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Registry
        WHERE Registry.registry_value_name="RelayTrapLiteAlert"
        BY Registry.dest Registry.user Registry.registry_path Registry.registry_value_name Registry.registry_value_data
    | rename "Registry.*" AS *
    | eval host=dest, src="-", detail=registry_path." ".registry_value_name."=".registry_value_data, data_model="Endpoint.Registry"
    | eval ioc="RelayTrapLiteAlert Run-key persistence", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="sqlite3.exe"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail="sqlite3: ".process, data_model="Endpoint.Processes"
    | eval ioc="sqlite3 after ScreenConnect activity (reverse pivot)", ioc_type="behaviour (hunt)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
