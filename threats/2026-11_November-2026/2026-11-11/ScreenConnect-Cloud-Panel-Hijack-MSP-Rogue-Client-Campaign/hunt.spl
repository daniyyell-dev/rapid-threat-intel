        FROM datamodel=Email.All_Email
        WHERE (All_Email.file_hash IN ("*60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb*", "*94b93c649b0ae0281352da9d01761fa9195ab1e6ac7010af3b9ba1646355eb11*", "*7a9aca9fdd4dcc13fe497cabdb13ca1e5d6a529271c8aa495e5ca1c1c80271ec*", "*b93f10f30ee453d1e1c046fec9d141c41d7680be5cd46c3aeb3febe0f4953b4d*", "*3c7a98f0fdb6235b8076319c74dc1085f7b349b6d750416dd0cadb07d7972ec4*", "*d2ed7a7bf4f8ac9c7969e9b3a07ebd4dda0d858f372c876ac0a041611698de9a*", "*4a1dd3cd2ea14368afadf7e9dfdd63b104e3981ef8c85bbb6510919b810af04b*", "*8cb5f48bbe70b5248db7f327f3d1ad6649df5c767d2a7e0711ee147fd92e06af*", "*cf50d73fa8117a758093b1344de41cd6a6ccddc645cdda1fa91a9264efe93956*", "*81cc2baa35b798d6084bd078662fa29ff28df02c46c6ccdb2b43bde97d19f781*", "*c31e6f075cd77e01839aebce32ed35659a9ee962d102aca53040bb5e297410a9*", "*deda7c30d798a19b6699a45fbcba503cf778594df9163c61c2f96bb2d2b9fb45*", "*0bd84c776dc01f784a617e73fc77b269f847fc4a062ffd489e4692869724bf08*", "*454c43d296b1276bde9a4f6ff1da2221cb35ccdb2fc7991bdd572e45bce12a8a*", "*5dd3a6ba806ac472663e243cfc1c034c534d5d9a42ec362c3dbf0f8d950148d0*", "*43b7a5e56f9e6c7b74e1ce2b7b5af63f383084625fcc2d3a5985fa1059e2db95*", "*50659748723e906c8b3d3c0386bd4cf692f693a3e23639398c1a14d0c31fed61*", "*a1937467fd862916f89342cdd61f55c4bc405fb35b6e1379e27cfbfdba77dcdc*", "*338e37f58043635ebab64ee5fdc919935e55cb146ca97834b358f934e55e88ec*", "*8e6912deed82e80bb6bd66f73509d024b1f78b993515366d8317e69a97cff4f4*", "*d85315bd7602b6f5c13dc0eada2c9cba0892c7cd3b1eb7dacb1bffdd536ceb21*", "*61a672a13f03a9e81f573535ee92b1ed6cb7e848a33a06048865312d4e185ae2*", "*0be01e7bd69cfdd222645d49bb5ad9961372fef2*", "*3f81c9c874a896c46e4bccea2fad2eaa3d9f2054*", "*13ce33b19daee3963f7e15d461b191c38f6bc0d3*") OR All_Email.url IN ("*ns.mo7sen.dev/EadF.php?p=4*", "*ns.mo7sen.dev/EadF.php?p=5*", "*ns.mo7sen.dev/EadF.php*", "*://newnewnew.gotdns.org*", "*.newnewnew.gotdns.org*", "newnewnew.gotdns.org*", "*://soxnewwork.homedns.org*", "*.soxnewwork.homedns.org*", "soxnewwork.homedns.org*", "*://sc.payproofkit.com*", "*.sc.payproofkit.com*", "sc.payproofkit.com*", "*://cdn007-digitaldownloads.com*", "*.cdn007-digitaldownloads.com*", "cdn007-digitaldownloads.com*", "*://amexsafekeyupdate.com*", "*.amexsafekeyupdate.com*", "amexsafekeyupdate.com*", "*://ns.mo7sen.dev*", "*.ns.mo7sen.dev*", "ns.mo7sen.dev*", "*://007.from-ak.com*", "*.007.from-ak.com*", "007.from-ak.com*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb|94b93c649b0ae0281352da9d01761fa9195ab1e6ac7010af3b9ba1646355eb11|7a9aca9fdd4dcc13fe497cabdb13ca1e5d6a529271c8aa495e5ca1c1c80271ec|b93f10f30ee453d1e1c046fec9d141c41d7680be5cd46c3aeb3febe0f4953b4d|3c7a98f0fdb6235b8076319c74dc1085f7b349b6d750416dd0cadb07d7972ec4|d2ed7a7bf4f8ac9c7969e9b3a07ebd4dda0d858f372c876ac0a041611698de9a|4a1dd3cd2ea14368afadf7e9dfdd63b104e3981ef8c85bbb6510919b810af04b|8cb5f48bbe70b5248db7f327f3d1ad6649df5c767d2a7e0711ee147fd92e06af|cf50d73fa8117a758093b1344de41cd6a6ccddc645cdda1fa91a9264efe93956|81cc2baa35b798d6084bd078662fa29ff28df02c46c6ccdb2b43bde97d19f781|c31e6f075cd77e01839aebce32ed35659a9ee962d102aca53040bb5e297410a9|deda7c30d798a19b6699a45fbcba503cf778594df9163c61c2f96bb2d2b9fb45|0bd84c776dc01f784a617e73fc77b269f847fc4a062ffd489e4692869724bf08|454c43d296b1276bde9a4f6ff1da2221cb35ccdb2fc7991bdd572e45bce12a8a|5dd3a6ba806ac472663e243cfc1c034c534d5d9a42ec362c3dbf0f8d950148d0|43b7a5e56f9e6c7b74e1ce2b7b5af63f383084625fcc2d3a5985fa1059e2db95|50659748723e906c8b3d3c0386bd4cf692f693a3e23639398c1a14d0c31fed61|a1937467fd862916f89342cdd61f55c4bc405fb35b6e1379e27cfbfdba77dcdc|338e37f58043635ebab64ee5fdc919935e55cb146ca97834b358f934e55e88ec|8e6912deed82e80bb6bd66f73509d024b1f78b993515366d8317e69a97cff4f4|d85315bd7602b6f5c13dc0eada2c9cba0892c7cd3b1eb7dacb1bffdd536ceb21|61a672a13f03a9e81f573535ee92b1ed6cb7e848a33a06048865312d4e185ae2|0be01e7bd69cfdd222645d49bb5ad9961372fef2|3f81c9c874a896c46e4bccea2fad2eaa3d9f2054|13ce33b19daee3963f7e15d461b191c38f6bc0d3|ns\.mo7sen\.dev/EadF\.php\?p=4|ns\.mo7sen\.dev/EadF\.php\?p=5|ns\.mo7sen\.dev/EadF\.php|newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com|amexsafekeyupdate\.com|ns\.mo7sen\.dev|007\.from\-ak\.com)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_name="ScreenConnect*" AND Processes.process="*ScreenConnect.ClientSetup*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Second ScreenConnect client pushed by Run Command", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="ScreenConnect.ClientService.exe" AND (Processes.process="*2588ef5c15954b10*" OR Processes.process="*ed630cc2c873b091*" OR Processes.process="*185.99.255.28*" OR Processes.process="*newnewnew.gotdns.org*" OR Processes.process="*soxnewwork.homedns.org*" OR Processes.process="*sc.payproofkit.com*" OR Processes.process="*c=Exploited*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Rogue ScreenConnect client IDs or attacker relay", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process="*TrapWatch*"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="TrapWatch scheduled task persistence", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_path="*\ProgramData\RelayTrap*" OR Filesystem.file_path="*\sckit-*" OR Filesystem.file_name IN ("Panel-Lateral.ps1", "Run-Lateral-Full.bat", "ToolboxRelayUploader.exe")
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="RelayTrap and sckit staging files", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Registry
        WHERE Registry.registry_value_name="RelayTrapLiteAlert"
        BY Registry.dest Registry.user Registry.registry_path Registry.registry_value_name Registry.registry_value_data
    | rename "Registry.*" AS *
    | eval host=dest, src="-", detail=registry_path." ".registry_value_name."=".registry_value_data, data_model="Endpoint.Registry"
    | eval ioc="RelayTrapLiteAlert Run-key persistence", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name="sqlite3.exe"
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail="sqlite3: ".process, data_model="Endpoint.Processes"
    | eval ioc="sqlite3 after ScreenConnect activity (reverse pivot)", ioc_type="behaviour (hunt)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.parent_process_name="ScreenConnect*" AND (Processes.process_name IN ("cmd.exe", "powershell.exe", "pwsh.exe") OR Processes.process="*Run-Lateral-Full.bat*" OR Processes.process="*Panel-Lateral.ps1*" OR Processes.process="*LabConfig.ps1*" OR Processes.process="*EadF.php*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Guest-to-Host file transfer and Run within seconds of connect", ioc_type="behaviour (alert)"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE Filesystem.file_name IN ("Run-Lateral-Full.bat", "Panel-Lateral.ps1", "LabConfig.ps1") OR Filesystem.file_path="*\ProgramData\RelayTrap*"
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.file_name Filesystem.action
    | rename "Filesystem.*" AS *
    | eval host=dest, src="-", detail="file ".action." ".file_path, data_model="Endpoint.Filesystem"
    | eval ioc="Guest-to-Host file transfer and Run within seconds of connect", ioc_type="behaviour (alert)"
]

| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE Processes.process_name IN ("powershell.exe", "pwsh.exe", "sqlite3.exe") AND (Processes.process="*.ASPXAUTH*" OR Processes.process="*Cookies*" OR Processes.process="*Login Data*" OR Processes.process="*Web Data*" OR Processes.process="*LabConfig.ps1*" OR Processes.process="*Panel-Lateral*")
        BY Processes.dest Processes.user Processes.parent_process_name Processes.process_name Processes.process
    | rename "Processes.*" AS *
    | eval host=dest, src="-", detail=parent_process_name." > ".process, data_model="Endpoint.Processes"
    | eval ioc="Non-browser or PowerShell access to .ASPXAUTH or cookie stores", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
