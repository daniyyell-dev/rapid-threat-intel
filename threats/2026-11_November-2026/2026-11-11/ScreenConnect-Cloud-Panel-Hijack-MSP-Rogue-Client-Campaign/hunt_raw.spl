    | eval data_model="endpoint", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, detail=coalesce(process, file_path)
  ]
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_endpoint(ScreenConnect.ClientSetup)`
    | where match(coalesce(parent_process_name, ""), "(?i)^screenconnect") AND match(coalesce(process, ""), "(?i)ScreenConnect\.ClientSetup")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Second ScreenConnect client pushed by Run Command", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(2588ef5c15954b10 OR ed630cc2c873b091 OR 185.99.255.28 OR newnewnew.gotdns.org OR soxnewwork.homedns.org OR sc.payproofkit.com OR "c=Exploited")`
    | where match(coalesce(process, ""), "(?i)2588ef5c15954b10|ed630cc2c873b091|185\.99\.255\.28|newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|c=Exploited")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Rogue ScreenConnect client IDs or attacker relay", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(TrapWatch)`
    | where match(coalesce(process, ""), "(?i)TrapWatch")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="TrapWatch scheduled task persistence", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(("RelayTrap" OR "sckit-" OR "Panel-Lateral.ps1" OR "Run-Lateral-Full.bat" OR "ToolboxRelayUploader.exe"))`
    | where match(coalesce(file_path, file_name, ""), "(?i)ProgramData.RelayTrap|sckit-|Panel-Lateral\.ps1|Run-Lateral-Full\.bat|ToolboxRelayUploader\.exe")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="RelayTrap and sckit staging files", ioc_type="behaviour (alert)"
]

| append [
    search index=* RelayTrapLiteAlert
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="raw events"
    | eval ioc="RelayTrapLiteAlert Run-key persistence", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(sqlite3.exe)`
    | where match(coalesce(process_name, ""), "(?i)sqlite3\.exe")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="sqlite3 after ScreenConnect activity (reverse pivot)", ioc_type="behaviour (hunt)"
]

| append [
    search `rti_endpoint(ScreenConnect)`
    | where match(coalesce(parent_process_name, ""), "(?i)^screenconnect") AND (match(coalesce(process_name, ""), "(?i)^(cmd|powershell|pwsh)\.exe$") OR match(coalesce(process, ""), "(?i)Run-Lateral-Full\.bat|Panel-Lateral\.ps1|LabConfig\.ps1|EadF\.php"))
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Guest-to-Host file transfer and Run within seconds of connect", ioc_type="behaviour (alert)"
]
| append [
    search `rti_endpoint(("Run-Lateral-Full.bat" OR "Panel-Lateral.ps1" OR "LabConfig.ps1" OR "RelayTrap"))`
    | where match(coalesce(file_path, file_name, ""), "(?i)Run-Lateral-Full\.bat|Panel-Lateral\.ps1|LabConfig\.ps1|ProgramData.RelayTrap")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Guest-to-Host file transfer and Run within seconds of connect", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(("powershell.exe" OR "pwsh.exe" OR "sqlite3.exe"))`
    | where match(coalesce(process_name, ""), "(?i)^(powershell|pwsh|sqlite3)\.exe$") AND match(coalesce(process, ""), "(?i)ASPXAUTH|Cookies|Login Data|Web Data|LabConfig\.ps1|Panel-Lateral")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Non-browser or PowerShell access to .ASPXAUTH or cookie stores", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
