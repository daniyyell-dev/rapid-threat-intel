      $e.principal.process.file.sha256 = /^(?:60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb|94b93c649b0ae0281352da9d01761fa9195ab1e6ac7010af3b9ba1646355eb11|7a9aca9fdd4dcc13fe497cabdb13ca1e5d6a529271c8aa495e5ca1c1c80271ec|b93f10f30ee453d1e1c046fec9d141c41d7680be5cd46c3aeb3febe0f4953b4d|3c7a98f0fdb6235b8076319c74dc1085f7b349b6d750416dd0cadb07d7972ec4|d2ed7a7bf4f8ac9c7969e9b3a07ebd4dda0d858f372c876ac0a041611698de9a|4a1dd3cd2ea14368afadf7e9dfdd63b104e3981ef8c85bbb6510919b810af04b|8cb5f48bbe70b5248db7f327f3d1ad6649df5c767d2a7e0711ee147fd92e06af|cf50d73fa8117a758093b1344de41cd6a6ccddc645cdda1fa91a9264efe93956|81cc2baa35b798d6084bd078662fa29ff28df02c46c6ccdb2b43bde97d19f781|c31e6f075cd77e01839aebce32ed35659a9ee962d102aca53040bb5e297410a9|deda7c30d798a19b6699a45fbcba503cf778594df9163c61c2f96bb2d2b9fb45|0bd84c776dc01f784a617e73fc77b269f847fc4a062ffd489e4692869724bf08|454c43d296b1276bde9a4f6ff1da2221cb35ccdb2fc7991bdd572e45bce12a8a|5dd3a6ba806ac472663e243cfc1c034c534d5d9a42ec362c3dbf0f8d950148d0|43b7a5e56f9e6c7b74e1ce2b7b5af63f383084625fcc2d3a5985fa1059e2db95|50659748723e906c8b3d3c0386bd4cf692f693a3e23639398c1a14d0c31fed61|a1937467fd862916f89342cdd61f55c4bc405fb35b6e1379e27cfbfdba77dcdc|338e37f58043635ebab64ee5fdc919935e55cb146ca97834b358f934e55e88ec|8e6912deed82e80bb6bd66f73509d024b1f78b993515366d8317e69a97cff4f4|d85315bd7602b6f5c13dc0eada2c9cba0892c7cd3b1eb7dacb1bffdd536ceb21)$/ nocase or
      $e.principal.process.parent_process.file.sha256 = /^(?:60142ea5daebbf94a2dec4009f673d9822a2fd796ac55478be1edea3136ef4bb|94b93c649b0ae0281352da9d01761fa9195ab1e6ac7010af3b9ba1646355eb11|7a9aca9fdd4dcc13fe497cabdb13ca1e5d6a529271c8aa495e5ca1c1c80271ec|b93f10f30ee453d1e1c046fec9d141c41d7680be5cd46c3aeb3febe0f4953b4d|3c7a98f0fdb6235b8076319c74dc1085f7b349b6d750416dd0cadb07d7972ec4|d2ed7a7bf4f8ac9c7969e9b3a07ebd4dda0d858f372c876ac0a041611698de9a|4a1dd3cd2ea14368afadf7e9dfdd63b104e3981ef8c85bbb6510919b810af04b|8cb5f48bbe70b5248db7f327f3d1ad6649df5c767d2a7e0711ee147fd92e06af|cf50d73fa8117a758093b1344de41cd6a6ccddc645cdda1fa91a9264efe93956|81cc2baa35b798d6084bd078662fa29ff28df02c46c6ccdb2b43bde97d19f781|c31e6f075cd77e01839aebce32ed35659a9ee962d102aca53040bb5e297410a9|deda7c30d798a19b6699a45fbcba503cf778594df9163c61c2f96bb2d2b9fb45|0bd84c776dc01f784a617e73fc77b269f847fc4a062ffd489e4692869724bf08|454c43d296b1276bde9a4f6ff1da2221cb35ccdb2fc7991bdd572e45bce12a8a|5dd3a6ba806ac472663e243cfc1c034c534d5d9a42ec362c3dbf0f8d950148d0|43b7a5e56f9e6c7b74e1ce2b7b5af63f383084625fcc2d3a5985fa1059e2db95|50659748723e906c8b3d3c0386bd4cf692f693a3e23639398c1a14d0c31fed61|a1937467fd862916f89342cdd61f55c4bc405fb35b6e1379e27cfbfdba77dcdc|338e37f58043635ebab64ee5fdc919935e55cb146ca97834b358f934e55e88ec|8e6912deed82e80bb6bd66f73509d024b1f78b993515366d8317e69a97cff4f4|d85315bd7602b6f5c13dc0eada2c9cba0892c7cd3b1eb7dacb1bffdd536ceb21)$/ nocase or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.principal.process.file.full_path, `screenconnect`) nocase and re.regex($e.target.process.command_line, `ScreenConnect\.ClientSetup`) nocase) or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.target.process.command_line, `2588ef5c15954b10|ed630cc2c873b091|185\.99\.255\.28|newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|c=Exploited`) nocase) or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.target.process.command_line, `TrapWatch`) nocase) or
      re.regex($e.target.file.full_path, `ProgramData.RelayTrap|sckit-|Panel-Lateral\.ps1|Run-Lateral-Full\.bat|ToolboxRelayUploader\.exe`) nocase or
      $e.metadata.event_type = "REGISTRY_MODIFICATION" and re.regex($e.target.registry.registry_value_name, `RelayTrapLiteAlert`) nocase or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.principal.process.file.full_path, `screenconnect`) nocase and re.regex($e.target.process.command_line, `Run-Lateral-Full\.bat|Panel-Lateral\.ps1|LabConfig\.ps1|EadF\.php`) nocase) or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.target.process.file.full_path, `(powershell|pwsh|sqlite3)\.exe$`) nocase and re.regex($e.target.process.command_line, `ASPXAUTH|Cookies|Login Data|Web Data|LabConfig\.ps1|Panel-Lateral`) nocase)
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $dns_query = array_distinct($e.network.dns.questions.name)
    $target_hostname = array_distinct($e.target.hostname)
    $target_url = array_distinct($e.target.url)
    $file_sha256 = array_distinct($e.target.file.sha256)
    $process_sha256 = array_distinct($e.target.process.file.sha256)
    $process_path = array_distinct($e.target.process.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
