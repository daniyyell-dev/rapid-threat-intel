  events:
    (
      $e.principal.ip = /^(?:185\.99\.255\.28|155\.94\.150\.39)$/ or
      $e.target.ip = /^(?:185\.99\.255\.28|155\.94\.150\.39)$/ or
      $e.network.dns.answers.data = /^(?:185\.99\.255\.28|155\.94\.150\.39)$/ or
      $e.network.dns.questions.name = /(?:^|\.)(?:newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com|amexsafekeyupdate\.com|ns\.mo7sen\.dev)\.?$/ nocase or
      $e.target.hostname = /(?:^|\.)(?:newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com|amexsafekeyupdate\.com|ns\.mo7sen\.dev)\.?$/ nocase or
      $e.target.domain.name = /(?:^|\.)(?:newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com|amexsafekeyupdate\.com|ns\.mo7sen\.dev)\.?$/ nocase or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:ns\.mo7sen\.dev/EadF\.php\?p=4|ns\.mo7sen\.dev/EadF\.php\?p=5|ns\.mo7sen\.dev/EadF\.php|(?:[^/?#@]*\.)?(?:newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com|amexsafekeyupdate\.com|ns\.mo7sen\.dev)(?::\d+)?(?:[/?#]|$))`) nocase or
