// Threat: ScreenConnect Cloud Panel Hijack: Rogue Clients Pushed to MSP-Managed Endpoints
// Author: Daniel Jeremiah | Date: 2026-11-11
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/ScreenConnect-Cloud-Panel-Hijack-MSP-Rogue-Client-Campaign
rule rti_screenconnect_cloud_panel_hijack_msp_rogue_client_campaign {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-11"
    description = "ScreenConnect Cloud Panel Hijack: Rogue Clients Pushed to MSP-Managed Endpoints"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/ScreenConnect-Cloud-Panel-Hijack-MSP-Rogue-Client-Campaign"

  events:
    (
      $e.principal.ip = /^(?:185\.99\.255\.28|155\.94\.150\.39)$/ or
      $e.target.ip = /^(?:185\.99\.255\.28|155\.94\.150\.39)$/ or
      $e.network.dns.answers.data = /^(?:185\.99\.255\.28|155\.94\.150\.39)$/ or
      $e.network.dns.questions.name = /(?:^|\.)(?:newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com)\.?$/ nocase or
      $e.target.hostname = /(?:^|\.)(?:newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com)\.?$/ nocase or
      $e.target.domain.name = /(?:^|\.)(?:newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com)\.?$/ nocase or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:ns\.mo7sen\.dev/EadF\.php\?p=4|(?:[^/?#@]*\.)?(?:newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|cdn007\-digitaldownloads\.com)(?::\d+)?(?:[/?#]|$))`) nocase or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.principal.process.file.full_path, `screenconnect`) nocase and re.regex($e.target.process.command_line, `ScreenConnect\.ClientSetup`) nocase) or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.target.process.command_line, `2588ef5c15954b10|ed630cc2c873b091|185\.99\.255\.28|newnewnew\.gotdns\.org|soxnewwork\.homedns\.org|sc\.payproofkit\.com|c=Exploited`) nocase) or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and re.regex($e.target.process.command_line, `TrapWatch`) nocase) or
      re.regex($e.target.file.full_path, `ProgramData.RelayTrap|sckit-|Panel-Lateral\.ps1|Run-Lateral-Full\.bat|ToolboxRelayUploader\.exe`) nocase or
      $e.metadata.event_type = "REGISTRY_MODIFICATION" and re.regex($e.target.registry.registry_value_name, `RelayTrapLiteAlert`) nocase
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(60)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $dns_query = array_distinct($e.network.dns.questions.name)
    $target_hostname = array_distinct($e.target.hostname)
    $target_url = array_distinct($e.target.url)

  condition:
    $e

  options:
    allow_zero_values = true
}
