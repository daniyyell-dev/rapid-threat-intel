rule rti_skyw4lker_microsoft_365_device_code_phishing {
  meta:
    author = "Daniel Jeremiah"
    date = "2026-11-11"
    description = "SkyW4lker: Microsoft 365 Device-Code Phishing Kit Targeting Enterprises"
