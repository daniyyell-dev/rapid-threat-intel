      $e.target.domain.name = /(?:^|\.)(?:0ff365access\.mooo\.com|0utlook0ffice365admin\.twilightparadox\.com|5200m\.com|7criccasinobonus\.cc|acrobat\-adobe\-com\-4464uswc\.egllo\.com|atlantictriad\.ignorelist\.com|atlassgroupinc\.com|auth\-loadingdocuments\.online|awemode\.outlookoffice365\.microsoftcopilots\.docshare\.linnwest\.us|bennett002\.mooo\.com|bezpartien\.online|bigbrain\.chickenkiller\.com|bloomfleldcapital\.com|bramum\.online|bxcelcounselling\.org|calmechc\.net|celestialtremor\.org|celvarioncorn\.org|centipedtourspa\.com|cleggs\.my03\.com|clingard\.pro|clubdenut\.club|coreansdmain\.com|csr\-rooflng\.com|dutchfarrms\.com|eccentric\-authentication\.com|ecosys\.newdocument2026\.pdfdocshared\.tntileandmarbleinc\.com|efaxdoc\.auth\.outlook2026common\.copilos26\.kone\-inc\.com|efaxdoc\.documents2026\.docs\.shared\.lakeviewscustom\.com|flow505\.mooo\.com|flow55\.chickenkiller\.com|frontdesk\.click|ghethim\.com|glafondbottamconstruction\.com|globlasumi\.com|gregor\.justdied\.com|grincool\.xyz|haevy\-llc\.com|hivezoom\.com|ideahom\.world|incommecialre\.com|innvisoin\.net|insigthinvestments\.com|investomind\.biz|jjnysnobiogtx\.org|kilishy\.qhigh\.com|kuer\.online|lampadasdeslgn\.com|linking\.mefound\.com|m365cloud\.login\.outlook\.office365\.azgymfloor\.com|maqaigiapelhani\.cam|metrorocl\.co\.uk|mgproparties\.com|naregruop\.com|noxband\.com|off365acess\.jumpingcrab\.com|off365mail\.club|office0365login\.2waky\.com|outlookdrive\.microsoftonline\.common\.oauth2\.client\.buycerm\.com|pdlhaelth\.com|priorispace\.biz|psionicsandhorses\.net|reauth\.copilot\.auth\.outlook\.mcloud365\.buycerm\.com|reauth\.docs\.copilot\.auth02\.outlook\.mcloud365\.argentventuras\.com|rektham\.online|rustlnsurance\.com|seatacsmarine\.com|slybee\.com|solutions00fileptroduct\.com|stellarntis\-fs\.com|studeseliamechan\.link|sunraycontractlng\.com|sunstateaquips\.com|swiftii\.chickenkiller\.com|thepaybank\.com|torvion\.life|unitadrentals\.com|us\-agricultures\.com|vasquezmyth\.com|copilots\.outlook\.cloud\.microsoft\.andersonelevators\.com)\.?$/ nocase or
      re.regex($e.target.url, `^(?:[a-z][a-z0-9+.-]*://)?(?:[^/?#]*@)?(?:(?:[^/?#@]*\.)?(?:0ff365access\.mooo\.com|0utlook0ffice365admin\.twilightparadox\.com|5200m\.com|7criccasinobonus\.cc|acrobat\-adobe\-com\-4464uswc\.egllo\.com|atlantictriad\.ignorelist\.com|atlassgroupinc\.com|auth\-loadingdocuments\.online|awemode\.outlookoffice365\.microsoftcopilots\.docshare\.linnwest\.us|bennett002\.mooo\.com|bezpartien\.online|bigbrain\.chickenkiller\.com|bloomfleldcapital\.com|bramum\.online|bxcelcounselling\.org|calmechc\.net|celestialtremor\.org|celvarioncorn\.org|centipedtourspa\.com|cleggs\.my03\.com|clingard\.pro|clubdenut\.club|coreansdmain\.com|csr\-rooflng\.com|dutchfarrms\.com|eccentric\-authentication\.com|ecosys\.newdocument2026\.pdfdocshared\.tntileandmarbleinc\.com|efaxdoc\.auth\.outlook2026common\.copilos26\.kone\-inc\.com|efaxdoc\.documents2026\.docs\.shared\.lakeviewscustom\.com|flow505\.mooo\.com|flow55\.chickenkiller\.com|frontdesk\.click|ghethim\.com|glafondbottamconstruction\.com|globlasumi\.com|gregor\.justdied\.com|grincool\.xyz|haevy\-llc\.com|hivezoom\.com|ideahom\.world|incommecialre\.com|innvisoin\.net|insigthinvestments\.com|investomind\.biz|jjnysnobiogtx\.org|kilishy\.qhigh\.com|kuer\.online|lampadasdeslgn\.com|linking\.mefound\.com|m365cloud\.login\.outlook\.office365\.azgymfloor\.com|maqaigiapelhani\.cam|metrorocl\.co\.uk|mgproparties\.com|naregruop\.com|noxband\.com|off365acess\.jumpingcrab\.com|off365mail\.club|office0365login\.2waky\.com|outlookdrive\.microsoftonline\.common\.oauth2\.client\.buycerm\.com|pdlhaelth\.com|priorispace\.biz|psionicsandhorses\.net|reauth\.copilot\.auth\.outlook\.mcloud365\.buycerm\.com|reauth\.docs\.copilot\.auth02\.outlook\.mcloud365\.argentventuras\.com|rektham\.online|rustlnsurance\.com|seatacsmarine\.com|slybee\.com|solutions00fileptroduct\.com|stellarntis\-fs\.com|studeseliamechan\.link|sunraycontractlng\.com|sunstateaquips\.com|swiftii\.chickenkiller\.com|thepaybank\.com|torvion\.life|unitadrentals\.com|us\-agricultures\.com|vasquezmyth\.com|copilots\.outlook\.cloud\.microsoft\.andersonelevators\.com)(?::\d+)?(?:[/?#]|$))`) nocase or
      $e.target.file.sha256 = /^(?:9aa0b87974b9b4cd42603833b7ad44257578467d279b315a071108a5ed02c268)$/ nocase or
      $e.target.process.file.sha256 = /^(?:9aa0b87974b9b4cd42603833b7ad44257578467d279b315a071108a5ed02c268)$/ nocase or
      $e.principal.process.file.sha256 = /^(?:9aa0b87974b9b4cd42603833b7ad44257578467d279b315a071108a5ed02c268)$/ nocase or
      $e.principal.process.parent_process.file.sha256 = /^(?:9aa0b87974b9b4cd42603833b7ad44257578467d279b315a071108a5ed02c268)$/ nocase
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(60)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $dns_query = array_distinct($e.network.dns.questions.name)
    $target_hostname = array_distinct($e.target.hostname)
    $target_url = array_distinct($e.target.url)
    $file_sha256 = array_distinct($e.target.file.sha256)
    $process_sha256 = array_distinct($e.target.process.file.sha256)
    $process_path = array_distinct($e.target.process.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}
