// GhostFrame: ESXi Hypervisor Implant Linked to Settra Ransomware (TAG-218)
// Field names follow CIM/UDM conventions and have not been tested against live data; adjust them to your environment.
// Google SecOps (YARA-L 2.0) detection rule over UDM events. Author: daniyyell-dev.
// https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/GhostFrame-ESXi-Hypervisor-Implant-Settra-Ransomware
// Paste into Detection > Rules & Detections > Rules Editor, then run a Retrohunt over at least the last 30 days
// before enabling it live. The indicators below are live and malicious: do not browse to them.
// Groups hits per principal host per hour (events without a hostname are kept as one group).
// Behaviours: 2 alert behaviour(s) with a clean UDM mapping are part of this rule; the rest are listed as leads at the end.
// Behaviours are leads, not confirmed indicators, and can match legitimate activity. Compare any hit against your own baseline and environment before acting.
// Behaviours are for hunting and alerting only; never block on them.
rule rti_ghostframe_esxi_hypervisor_implant_settra_ransomware {
  meta:
    author = "daniyyell-dev"
    description = "Matches UDM events against the published indicators and alert behaviours for GhostFrame: ESXi Hypervisor Implant Linked to Settra Ransomware (TAG-218)"
    threat = "GhostFrame: ESXi Hypervisor Implant Linked to Settra Ransomware (TAG-218)"
    reference = "https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/GhostFrame-ESXi-Hypervisor-Implant-Settra-Ransomware"
    source_1 = "https://www.recordedfuture.com/blog/ghostframe-esxi-implant-settra-ransomware"
    mitre_attack_technique = "T1003, T1036, T1037, T1090, T1133, T1190, T1219, T1486, T1562.004"
    false_positives = "Low for high-confidence indicators; shared hosting, CDN or cloud IPs and scanner IPs can match benign traffic. Behaviour matches are leads and can be legitimate admin or automation activity; compare with your own baseline"
    yara_version = "YL2.0"
    severity = "High"
    priority = "High"
    tlp = "CLEAR"
    published = "2026-11-10"
    rule_version = "1.0"

  events:
    (
      $e.principal.ip = /^(?:45\.158\.196\.81|45\.158\.196\.141|193\.5\.65\.114)$/ or
      $e.target.ip = /^(?:45\.158\.196\.81|45\.158\.196\.141|193\.5\.65\.114)$/ or
      $e.network.dns.answers.data = /^(?:45\.158\.196\.81|45\.158\.196\.141|193\.5\.65\.114)$/ or
      $e.target.file.sha256 = /^(?:a05eae6d07b82e2e5451a72266f21fbaf76486ef4920a820988de93e15353a10)$/ nocase or
      $e.target.process.file.sha256 = /^(?:a05eae6d07b82e2e5451a72266f21fbaf76486ef4920a820988de93e15353a10)$/ nocase or
      $e.principal.process.file.sha256 = /^(?:a05eae6d07b82e2e5451a72266f21fbaf76486ef4920a820988de93e15353a10)$/ nocase or
      $e.principal.process.parent_process.file.sha256 = /^(?:a05eae6d07b82e2e5451a72266f21fbaf76486ef4920a820988de93e15353a10)$/ nocase or
      // Behaviour 2 (Alert): GhostFrame persistence on ESXi
      (($e.metadata.event_type = "FILE_CREATION" or $e.metadata.event_type = "FILE_MODIFICATION" or $e.metadata.event_type = "FILE_MOVE") and $e.target.file.full_path = /^\/(opt\/vmhostd-core|etc\/rc\.local\.d\/local\.sh)$/) or
      ($e.metadata.event_type = "PROCESS_LAUNCH" and $e.target.process.file.full_path = /(^|\/)vmhostd$/) or
      // Behaviour 3 (Alert): ESXi firewall disabled again and again
      ($e.metadata.event_type = "PROCESS_LAUNCH" and $e.target.process.command_line = /network firewall set.*--enabled\s+(false|0)|execInstalledOnly.*(\s|=)(0|false)\b/ nocase)
    )
    $host = $e.principal.hostname

  match:
    $host over 1h

  outcome:
    $risk_score = max(80)
    $event_count = count($e.metadata.id)
    $event_types = array_distinct($e.metadata.event_type)
    $log_types = array_distinct($e.metadata.log_type)
    $principal_user = array_distinct($e.principal.user.userid)
    $principal_ip = array_distinct($e.principal.ip)
    $target_ip = array_distinct($e.target.ip)
    $product_event_type = array_distinct($e.metadata.product_event_type)
    $process_command_line = array_distinct($e.target.process.command_line)
    $target_file_path = array_distinct($e.target.file.full_path)
    $file_sha256 = array_distinct($e.target.file.sha256)
    $process_sha256 = array_distinct($e.target.process.file.sha256)
    $process_path = array_distinct($e.target.process.file.full_path)

  condition:
    $e

  options:
    allow_zero_values = true
}

// Behaviours not in the rule above. Hunt them in UDM search or the named logs.
// Behaviours are leads, not confirmed indicators, and can match legitimate activity. Compare any hit against your own baseline and environment before acting. Behaviours are for hunting and alerting only; never block on them.
//
//   Behaviour 1 (Alert): One host trying six C2 ports at once
//       Look for: One host opening near-simultaneous TCP connections to the same external IP on ports 53, 2222, 3389, 4444, 8443 and 9443, retried every 5 to 12 seconds
//       Log source: Firewall, NetFlow or EDR network events from ESXi management addresses
//       No rule written: needs a count of distinct ports across many events (a multi-event rule); run it as a separate rule if you want it live
//
//   Behaviour 4 (Hunt): VNC, snapshot and tunnel activity on ESXi
//       Look for: VNC enabled on VMs, unexpected snapshots or power changes, and the ESXi Host Client reached through an unusual tunnel
//       Log source: ESXi and vCenter events
//       No rule written: vCenter and ESXi event names for VNC settings, snapshots and power changes vary by version; review them against your change records

// Hunt leads and notes (not network or hash indicators), check manually in UDM search:
//   On ESXi, a modified /etc/rc.local.d/local.sh that runs esxcli network firewall set --enabled false or sets execInstalledOnly to 0 is GhostFrame persistence.
//   Settra ransomware intrusions used MeshAgent for persistence; an unexpected MeshAgent install on a server is worth checking.
