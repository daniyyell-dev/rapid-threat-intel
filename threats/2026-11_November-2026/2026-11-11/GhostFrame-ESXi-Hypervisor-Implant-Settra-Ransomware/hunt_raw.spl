``` Threat: GhostFrame: ESXi Hypervisor Implant Linked to Settra Ransomware (TAG-218)
    Author: Daniel Jeremiah | Date: 2026-11-11
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/GhostFrame-ESXi-Hypervisor-Implant-Settra-Ransomware ```
| multisearch
  [ search `rti_network(45.158.196.81 OR 45.158.196.141 OR 193.5.65.114)`
    | search dest_ip IN ("45.158.196.81", "45.158.196.141", "193.5.65.114")
    | eval data_model="network", ioc_type="ipv4", ioc=dest_ip, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
  ]
  [ search `rti_network(45.158.196.81 OR 45.158.196.141 OR 193.5.65.114)`
    | search src_ip IN ("45.158.196.81", "45.158.196.141", "193.5.65.114")
    | eval data_model="network", ioc_type="ipv4", ioc=src_ip, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
  ]
  [ search `rti_endpoint(a05eae6d07b82e2e5451a72266f21fbaf76486ef4920a820988de93e15353a10)`
    | search file_hash IN ("*a05eae6d07b82e2e5451a72266f21fbaf76486ef4920a820988de93e15353a10*") OR process_hash IN ("*a05eae6d07b82e2e5451a72266f21fbaf76486ef4920a820988de93e15353a10*") OR parent_process_hash IN ("*a05eae6d07b82e2e5451a72266f21fbaf76486ef4920a820988de93e15353a10*")
    | eval matched=file_hash." ".process_hash." ".parent_process_hash
    | rex field=matched "(?i)(?<ioc>a05eae6d07b82e2e5451a72266f21fbaf76486ef4920a820988de93e15353a10)"
    | eval data_model="endpoint", ioc_type=case(len(ioc)==64, "sha256", len(ioc)==40, "sha1", 1==1, "md5"), host=dest, detail=coalesce(process, file_path)
  ]
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_network(53 OR 2222 OR 3389 OR 4444 OR 8443 OR 9443)`
    | search dest_port IN (53, 2222, 3389, 4444, 8443, 9443)
    | bin _time span=30s
    | stats count min(_time) AS first_seen max(_time) AS last_seen dc(dest_port) AS ports values(dest_port) AS port_list BY src_ip dest_ip _time
    | where ports>=4
    | stats sum(count) AS count min(first_seen) AS first_seen max(last_seen) AS last_seen values(port_list) AS port_list BY src_ip dest_ip
    | eval host=src_ip, user="-", src=src_ip, dest=dest_ip, detail="ports ".mvjoin(port_list, ",")." to one address within 30s", data_model="network"
    | fields - src_ip dest_ip port_list
    | eval ioc="One host trying six C2 ports at once", ioc_type="behaviour (alert)"
]

| append [
    search index=* ("vmhostd-core" OR "rc.local.d/local.sh" OR "auto-backup.sh")
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="ESXi logs"
    | eval ioc="GhostFrame persistence on ESXi", ioc_type="behaviour (alert)"
]
| append [
    search `rti_endpoint(vmhostd)`
    | where match(process_name, "(?i)(^|[\\/])(vmhostd)$")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(parent_process_name, "-")." > ".coalesce(process, process_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="GhostFrame persistence on ESXi", ioc_type="behaviour (alert)"
]

| append [
    search index=* (("firewall" "--enabled false") OR ("execInstalledOnly" 0))
    | eval host=host, user=coalesce(user, "-"), src=coalesce(src, src_ip, "-"), dest=sourcetype, detail=substr(replace(_raw, "\s+", " "), 1, 300)
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="ESXi logs"
    | eval ioc="ESXi firewall disabled again and again", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
