// Threat: Storm-3358 ARTEX Agentic Intrusions Against the Financial Sector
// Author: Daniel Jeremiah | Date: 2026-11-11
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-11/Storm-3358-ARTEX-Agentic-Intrusions-Financial-Sector
let Lookback = 30d;
let IPs = dynamic(["199.19.95.66", "199.19.95.67", "199.19.95.68", "91.92.240.238", "85.11.168.45", "85.11.167.52", "178.16.54.129", "31.77.229.35"]);
union isfuzzy=true
  (DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceNetworkEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", InitiatingProcessFileName, " port ", RemotePort))),
  (DeviceLogonEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIP in (IPs)
    | project Timestamp, SourceTable = "DeviceLogonEvents", Entity = tostring(DeviceName), Indicator = tostring(RemoteIP), Context = tostring(strcat(ActionType, " ", LogonType, " ", AccountName))),
  (EntraIdSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSignInEvents", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (AADSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSignInEventsBeta", Entity = tostring(AccountUpn), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ErrorCode))),
  (EntraIdSpnSignInEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "EntraIdSpnSignInEvents", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (AADSpnSignInEventsBeta
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "AADSpnSignInEventsBeta", Entity = tostring(ServicePrincipalName), Indicator = tostring(IPAddress), Context = tostring(strcat(ResourceDisplayName, " ", ErrorCode))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where IPAddress in (IPs)
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(AccountDisplayName), Indicator = tostring(IPAddress), Context = tostring(strcat(Application, " ", ActionType))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where (FileName in~ ("curl", "curl.exe", "wget", "nc", "ncat", "netcat") and ProcessCommandLine has_any ("199.19.95.66", "199.19.95.67", "199.19.95.68", "91.92.240.238", "85.11.168.45", "85.11.167.52", "178.16.54.129", "31.77.229.35")) or ProcessCommandLine has_any ("vshell", "AdaptixC2", "MARKER123", "ARTX123")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(FolderPath, " ", ProcessCommandLine))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where InitiatingProcessFileName in~ ("w3wp.exe", "httpd", "apache2", "nginx", "php-fpm", "php", "java", "node", "tomcat") and FileName in~ ("curl", "curl.exe", "wget", "nc", "ncat", "netcat", "sh", "bash", "cmd.exe", "powershell.exe")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(InitiatingProcessFileName, " > ", ProcessCommandLine))),
  (W3CIISLog
    | where TimeGenerated > ago(Lookback)
    | where csUserAgent has_any ("Nmap", "curl/", "Wget", "python-requests", "python-urllib", "aiohttp", "httpx", "HeadlessChrome", "Playwright")
    | summarize Timestamp = max(TimeGenerated), Requests = count(), Paths = dcount(csUriStem), Agents = make_set(csUserAgent, 3) by cIP, Computer, Window = bin(TimeGenerated, 5m)
    | where Requests >= 100 and Paths >= 20
    | project Timestamp, SourceTable = "W3CIISLog", Entity = Computer, Indicator = cIP, Context = strcat(Requests, " requests, ", Paths, " paths in 5m; ", strcat_array(Agents, " | "))),
  (W3CIISLog
    | where TimeGenerated > ago(Lookback)
    | summarize Timestamp = max(TimeGenerated), Requests = count(), Paths = dcount(csUriStem), Methods = dcount(csMethod) by cIP, Computer, Window = bin(TimeGenerated, 30s)
    | where Requests >= 8 and Requests <= 40 and Paths >= 3
    | project Timestamp, SourceTable = "W3CIISLog", Entity = Computer, Indicator = cIP, Context = strcat(Requests, " requests, ", Paths, " paths in 30s")),
  (W3CIISLog
    | where TimeGenerated > ago(Lookback)
    | where toint(scStatus) between (200 .. 299)
    | summarize Timestamp = max(TimeGenerated), Methods = make_set(csMethod, 5), Hits = count() by cIP, Computer, csUriStem, Window = bin(TimeGenerated, 5m)
    | where (Methods has "PUT" or Methods has "POST" or Methods has "DELETE") and Methods has "GET"
    | project Timestamp, SourceTable = "W3CIISLog", Entity = Computer, Indicator = cIP, Context = strcat(csUriStem, " ", strcat_array(Methods, ", "), " in 5m")),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where Application == "Amazon Web Services" and ActionType has_any ("PutObject", "DeleteObject", "CreateBucket", "DeleteBucket")
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(RawEventData.userIdentity.arn), Indicator = tostring(ActionType), Context = tostring(strcat(ActionType, " ", IPAddress, " ", tostring(RawEventData.requestParameters)))),
  (DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FolderPath has @"\Windows\Temp" and (FileName startswith "artx" or FileName matches regex @"^i[0-9]+_.*\.ps1$")
    | project Timestamp, SourceTable = "DeviceFileEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(ActionType, " ", FolderPath, "\\", FileName))),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where ProcessCommandLine has_any ("MARKER123", "ARTX123")
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(ProcessCommandLine), Context = tostring(strcat(FileName, " ", ProcessCommandLine))),
  (AuditLogs
    | where TimeGenerated > ago(Lookback)
    | where OperationName has_any ("Add application", "Update application", "Add service principal", "Add app role assignment", "Add member to role", "Add service principal credentials", "Certificates and secrets management")
    | where InitiatedBy has "application" or tostring(InitiatedBy) has "app"
    | project Timestamp=TimeGenerated, OperationName, Identity=tostring(InitiatedBy), Target=tostring(TargetResources), CorrelationId, AdditionalDetails)
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Hits = count(), Context = take_any(Context) by SourceTable, Entity, Indicator
| order by LastSeen desc
