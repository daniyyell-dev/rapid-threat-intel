``` Threat: MSP Process GDAP Breach: Entra Token Abuse in Partner Tenants
    Author: Daniel Jeremiah | Date: 2026-11-10
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-10/MSP-Process-GDAP-Breach-Entra-Token-Abuse ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("172.169.63.30", "64.236.54.139", "172.169.207.227", "172.169.187.35", "172.169.63.29", "172.169.63.35", "172.169.29.166", "172.169.58.181", "172.169.206.55", "172.168.41.166", "172.168.117.170", "172.168.253.63", "64.236.112.134", "64.236.112.237", "64.236.112.251", "64.236.112.221", "64.236.112.120", "64.236.112.111", "64.236.113.15", "64.236.113.23", "64.236.113.32", "52.230.237.27", "52.230.237.16", "52.230.237.18", "52.230.237.21", "52.230.237.13", "52.230.237.9", "52.228.167.149", "52.228.167.121", "52.154.255.0", "40.89.240.243", "40.89.240.113", "40.83.16.22", "13.89.111.197", "20.84.171.92", "130.131.144.244", "135.233.107.143", "172.215.180.155", "143.198.68.206", "187.15.92.123", "178.61.224.154", "46.148.159.8", "109.171.38.144", "213.5.16.40", "91.210.236.74", "202.44.193.79", "24.220.57.81", "188.137.78.112", "188.25.140.193", "193.188.198.233", "46.151.219.60", "178.205.170.18", "188.137.76.53", "213.226.214.89", "177.52.113.45", "46.253.235.237", "138.118.86.78")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("172.169.63.30", "64.236.54.139", "172.169.207.227", "172.169.187.35", "172.169.63.29", "172.169.63.35", "172.169.29.166", "172.169.58.181", "172.169.206.55", "172.168.41.166", "172.168.117.170", "172.168.253.63", "64.236.112.134", "64.236.112.237", "64.236.112.251", "64.236.112.221", "64.236.112.120", "64.236.112.111", "64.236.113.15", "64.236.113.23", "64.236.113.32", "52.230.237.27", "52.230.237.16", "52.230.237.18", "52.230.237.21", "52.230.237.13", "52.230.237.9", "52.228.167.149", "52.228.167.121", "52.154.255.0", "40.89.240.243", "40.89.240.113", "40.83.16.22", "13.89.111.197", "20.84.171.92", "130.131.144.244", "135.233.107.143", "172.215.180.155", "143.198.68.206", "187.15.92.123", "178.61.224.154", "46.148.159.8", "109.171.38.144", "213.5.16.40", "91.210.236.74", "202.44.193.79", "24.220.57.81", "188.137.78.112", "188.25.140.193", "193.188.198.233", "46.151.219.60", "178.205.170.18", "188.137.76.53", "213.226.214.89", "177.52.113.45", "46.253.235.237", "138.118.86.78")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]

| append [
    search index=* (sourcetype="azure:monitor:aad" OR sourcetype="mscs:azure:eventhub" OR sourcetype="azure:aad:signin" OR sourcetype="azure:aad:audit" OR sourcetype="ms:aad:signin" OR sourcetype="ms:aad:audit") "MSP Process" ("ServicePrincipalSignInLogs" OR "servicePrincipal") NOT "64.236.54.139"
        | where _time >= 1794045360
    | eval host="-", user=coalesce('properties.servicePrincipalName', servicePrincipalName, 'properties.appDisplayName', appDisplayName, "MSP Process"), src=coalesce('properties.ipAddress', ipAddress, src_ip, src), dest=coalesce('properties.resourceDisplayName', resourceDisplayName, "-"), detail="service principal sign-in, result ".coalesce('properties.status.errorCode', 'status.errorCode', "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="Entra sign-in logs"
    | eval ioc="App sign-ins from outside the MSP Process address", ioc_type="behaviour (alert)"
]

| append [
    search index=* (sourcetype="azure:monitor:aad" OR sourcetype="mscs:azure:eventhub" OR sourcetype="azure:aad:signin" OR sourcetype="azure:aad:audit" OR sourcetype="ms:aad:signin" OR sourcetype="ms:aad:audit") "MSP Process" ("credentials" OR "Certificates and secrets" OR "app role assignment" OR "Add member to group" OR "Add user")
    | where _time >= 1793923200
    | eval host="-", user=coalesce('properties.initiatedBy.app.displayName', "MSP Process"), src="-", dest=coalesce('properties.operationName', operationName, activityDisplayName, "-"), detail="Entra audit change initiated by MSP Process"
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="Entra audit logs"
    | eval ioc="Tenant changes made by the MSP Process app", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
