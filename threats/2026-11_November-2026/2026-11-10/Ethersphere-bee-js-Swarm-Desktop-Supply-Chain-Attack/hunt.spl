        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>api\.frameworkmetrics\.xyz/v1/analytics|api\.frameworkmetrics\.xyz/v1/electron|api\.frameworkmetrics\.xyz/v1/assets/|api\.frameworkmetrics\.xyz/v1/swarm/report|107\.189\.27\.46:3000/app\.js|webhook\.site/fdc222d5\-2e6c\-4122\-801d\-93099f3fe827|webhook\.site/46358b99\-9cff\-4f14\-97bc\-4a436086e826|webhook\.site/c05b53d9\-c3b6\-4a90\-94dc\-b86a0a4e905f|pastebin\.com/raw/q1p9qH2w|frameworkmetrics\.xyz|api\.frameworkmetrics\.xyz)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
