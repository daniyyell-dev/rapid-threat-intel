``` Threat: Ethersphere bee-js and Swarm Desktop Supply-Chain Attack (SleepyDuck / evjawbreaker)
    Author: Daniel Jeremiah | Date: 2026-11-10
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-10/Ethersphere-bee-js-Swarm-Desktop-Supply-Chain-Attack ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("193.57.9.155", "193.57.9.17", "178.16.54.222", "107.189.27.223", "107.189.27.46", "91.108.240.156", "107.189.16.215", "185.232.84.169")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("193.57.9.155", "193.57.9.17", "178.16.54.222", "107.189.27.223", "107.189.27.46", "91.108.240.156", "107.189.16.215", "185.232.84.169")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Resolution.DNS
        WHERE DNS.query IN ("frameworkmetrics.xyz", "*.frameworkmetrics.xyz", "api.frameworkmetrics.xyz", "*.api.frameworkmetrics.xyz")
        BY DNS.src DNS.dest DNS.query DNS.reply_code
    | rename "DNS.*" AS *
    | rex field=query "(?i)(?<ioc>(?:frameworkmetrics\.xyz|api\.frameworkmetrics\.xyz))\.?$"
    | eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
]
