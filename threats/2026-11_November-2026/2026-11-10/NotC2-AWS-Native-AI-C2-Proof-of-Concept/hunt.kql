// Threat: NotC2: AWS-Native AI C2 Proof of Concept
// Author: Daniel Jeremiah | Date: 2026-11-10
// Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-10/NotC2-AWS-Native-AI-C2-Proof-of-Concept
let Lookback = 30d;
union isfuzzy=true
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where Application == "Amazon Web Services" and ActionType == "Subscribe" and tostring(RawEventData.eventSource) == "sns.amazonaws.com" and tolower(tostring(RawEventData.requestParameters.protocol)) in ("http", "https")
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(RawEventData.userIdentity.arn), Indicator = tostring(RawEventData.requestParameters.endpoint), Context = tostring(strcat("SNS Subscribe ", tostring(RawEventData.requestParameters.topicArn), " | ", tostring(RawEventData.userAgent)))),
  (AWSCloudTrail
    | where TimeGenerated > ago(Lookback)
    | where EventSource == "sns.amazonaws.com" and EventName == "Subscribe" and tolower(tostring(parse_json(RequestParameters).protocol)) in ("http", "https")
    | project Timestamp = TimeGenerated, SourceTable = "AWSCloudTrail", Entity = tostring(UserIdentityArn), Indicator = tostring(parse_json(RequestParameters).endpoint), Context = tostring(strcat("SNS Subscribe ", tostring(parse_json(RequestParameters).topicArn), " | ", UserAgent))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where Application == "Amazon Web Services" and ActionType == "ConfirmSubscription" and tostring(RawEventData.eventSource) == "sns.amazonaws.com"
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(RawEventData.userIdentity.arn), Indicator = tostring(RawEventData.sourceIPAddress), Context = tostring(strcat("SNS ConfirmSubscription ", tostring(RawEventData.requestParameters.topicArn)))),
  (AWSCloudTrail
    | where TimeGenerated > ago(Lookback)
    | where EventSource == "sns.amazonaws.com" and EventName == "ConfirmSubscription"
    | project Timestamp = TimeGenerated, SourceTable = "AWSCloudTrail", Entity = tostring(UserIdentityArn), Indicator = tostring(SourceIpAddress), Context = tostring(strcat("SNS ConfirmSubscription ", tostring(parse_json(RequestParameters).topicArn)))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where Application == "Amazon Web Services" and ActionType == "CreateTopic" and tostring(RawEventData.eventSource) == "sns.amazonaws.com" and tostring(RawEventData.userAgent) has "exec-env/AWS_Lambda"
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(RawEventData.userIdentity.arn), Indicator = tostring(RawEventData.requestParameters.name), Context = tostring(strcat("SNS CreateTopic from Lambda | ", tostring(RawEventData.userAgent)))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where Application == "Amazon Web Services" and ActionType startswith "CreateEventSourceMapping" and tostring(RawEventData.requestParameters.eventSourceArn) has ":sqs:"
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(RawEventData.userIdentity.arn), Indicator = tostring(RawEventData.requestParameters.eventSourceArn), Context = tostring(strcat("Lambda mapping to ", tostring(RawEventData.requestParameters.functionName)))),
  (AWSCloudTrail
    | where TimeGenerated > ago(Lookback)
    | where EventSource == "lambda.amazonaws.com" and EventName startswith "CreateEventSourceMapping" and tostring(parse_json(RequestParameters).eventSourceArn) has ":sqs:"
    | project Timestamp = TimeGenerated, SourceTable = "AWSCloudTrail", Entity = tostring(UserIdentityArn), Indicator = tostring(parse_json(RequestParameters).eventSourceArn), Context = tostring(strcat("Lambda mapping to ", tostring(parse_json(RequestParameters).functionName)))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where Application == "Amazon Web Services" and (ActionType == "CreateQueue" or ActionType startswith "CreateFunction" or ActionType startswith "CreateEventSourceMapping")
    | extend Actor = tostring(RawEventData.userIdentity.arn), Step = case(ActionType == "CreateQueue", "queue", ActionType startswith "CreateFunction", "function", "mapping")
    | summarize Timestamp = max(Timestamp), Steps = make_set(Step) by Actor, Window = bin(Timestamp, 1h)
    | where array_length(Steps) == 3
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = Actor, Indicator = "CreateQueue + CreateFunction + CreateEventSourceMapping", Context = strcat("Same identity within 1h: ", strcat_array(Steps, ", "))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where Application == "Amazon Web Services" and tostring(RawEventData.requestParameters) has "NotC2"
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = tostring(RawEventData.userIdentity.arn), Indicator = tostring(ActionType), Context = tostring(RawEventData.requestParameters)),
  (DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where ProcessCommandLine has "NotC2" or (ProcessCommandLine has "create-event-source-mapping" and ProcessCommandLine has "sqs") or (ProcessCommandLine has "sns" and ProcessCommandLine has "subscribe" and ProcessCommandLine has_any ("--protocol https", "--protocol http"))
    | project Timestamp, SourceTable = "DeviceProcessEvents", Entity = tostring(DeviceName), Indicator = tostring(FileName), Context = tostring(strcat(AccountName, " ", ProcessCommandLine))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where Application == "Amazon Web Services" and ActionType in ("InvokeModel", "InvokeModelWithResponseStream", "Converse", "ConverseStream") and tostring(RawEventData.userIdentity.type) == "AssumedRole"
    | extend Role = tostring(RawEventData.userIdentity.sessionContext.sessionIssuer.arn), Lambda = tostring(RawEventData.userAgent) has "exec-env/AWS_Lambda"
    | summarize FirstSeen = min(Timestamp), Timestamp = max(Timestamp), Calls = count(), Models = make_set(tostring(RawEventData.requestParameters.modelId), 5) by Role, Lambda
    | where FirstSeen > ago(7d)
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = Role, Indicator = "First Bedrock use by role in 30 days", Context = strcat(iff(Lambda, "Lambda user agent; ", ""), Calls, " calls; models ", strcat_array(Models, ", "))),
  (CloudAppEvents
    | where Timestamp > ago(Lookback)
    | where Application == "Amazon Web Services" and tostring(RawEventData.userIdentity.type) == "AssumedRole"
    | where ActionType in ("InvokeModel", "Converse", "ConverseStream", "DescribeInstances", "ListTables", "DescribeDBInstances", "ListBuckets") or ActionType startswith "ListFunctions"
    | extend Role = tostring(RawEventData.userIdentity.sessionContext.sessionIssuer.arn), IsModel = ActionType in ("InvokeModel", "Converse", "ConverseStream")
    | summarize Timestamp = max(Timestamp), ModelCalls = countif(IsModel), Discovery = make_set_if(ActionType, not(IsModel)) by Role, Window = bin(Timestamp, 1h)
    | where ModelCalls > 0 and array_length(Discovery) >= 2
    | project Timestamp, SourceTable = "CloudAppEvents", Entity = Role, Indicator = "Bedrock plus discovery APIs", Context = strcat(ModelCalls, " model calls; ", strcat_array(Discovery, ", ")))
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Hits = count(), Context = take_any(Context) by SourceTable, Entity, Indicator
| order by LastSeen desc
