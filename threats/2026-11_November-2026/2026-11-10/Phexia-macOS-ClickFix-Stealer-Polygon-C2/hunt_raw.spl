``` Phexia: macOS ClickFix Stealer with Polygon C2
    Field names follow CIM/UDM conventions and have not been tested against live data; adjust them to your environment.
    Splunk hunt over raw events, for data not mapped to CIM. Author: daniyyell-dev. https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-10/Phexia-macOS-ClickFix-Stealer-Polygon-C2
    Sources: https://www.withsecure.com/en/resources-hub/w-labs/phexia-macos-malware/
    Define the rti_network, rti_dns, rti_web and rti_endpoint macros once (example: all/splunk_macros.conf).
    Each macro takes one argument, a list of search terms used to pre-filter the raw events, and must only use
    streaming commands (search, eval, rename, rex, fields, spath) so it can run inside multisearch.
    Set the time picker to at least the last 30 days. The indicators below are live and malicious.
    Output: first_seen, last_seen, ioc, ioc_type, data_model, host, user, src, dest, detail, count ```
| multisearch
  [ search `rti_network(62.60.226.50)`
    | search dest_ip IN ("62.60.226.50")
    | eval data_model="network", ioc_type="ipv4", ioc=dest_ip, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
  ]
  [ search `rti_network(62.60.226.50)`
    | search src_ip IN ("62.60.226.50")
    | eval data_model="network", ioc_type="ipv4", ioc=src_ip, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
  ]
  [ search `rti_dns(hf98x4d.site OR apdhlhs3.xyz OR j9af4sr.guru OR 67sixcebeh.surf OR stv4ec5.shop OR vg5sgxv.lol OR d9mjs.sbs OR jse8x92s.me OR couhe79.xyz OR xzttyt.xyz OR secdarvin2026.icu OR oreshnik.top OR svo-zv.pro OR dhsbdgs.icu OR hackersteersman.digital OR coeuzgoq.bahisbiz.com OR kefavkd.nextbahis.sex OR d9j.everunningshoes.com OR nox.usa-synadentix.com OR zwa8.meritbethizligir.com OR 355uz90z.bolnhurstrally.site OR 7ulk.irvinaurus.fit OR pool.hashvault.sh OR pool.supportxmr.com)`
    | search query IN ("hf98x4d.site", "*.hf98x4d.site", "apdhlhs3.xyz", "*.apdhlhs3.xyz", "j9af4sr.guru", "*.j9af4sr.guru", "67sixcebeh.surf", "*.67sixcebeh.surf", "stv4ec5.shop", "*.stv4ec5.shop", "vg5sgxv.lol", "*.vg5sgxv.lol", "d9mjs.sbs", "*.d9mjs.sbs", "jse8x92s.me", "*.jse8x92s.me", "couhe79.xyz", "*.couhe79.xyz", "xzttyt.xyz", "*.xzttyt.xyz", "secdarvin2026.icu", "*.secdarvin2026.icu", "oreshnik.top", "*.oreshnik.top", "svo-zv.pro", "*.svo-zv.pro", "dhsbdgs.icu", "*.dhsbdgs.icu", "hackersteersman.digital", "*.hackersteersman.digital", "coeuzgoq.bahisbiz.com", "*.coeuzgoq.bahisbiz.com", "kefavkd.nextbahis.sex", "*.kefavkd.nextbahis.sex", "d9j.everunningshoes.com", "*.d9j.everunningshoes.com", "nox.usa-synadentix.com", "*.nox.usa-synadentix.com", "zwa8.meritbethizligir.com", "*.zwa8.meritbethizligir.com", "355uz90z.bolnhurstrally.site", "*.355uz90z.bolnhurstrally.site", "7ulk.irvinaurus.fit", "*.7ulk.irvinaurus.fit", "pool.hashvault.sh", "*.pool.hashvault.sh", "pool.supportxmr.com", "*.pool.supportxmr.com")
    | rex field=query "(?i)(?<ioc>(?:hf98x4d\.site|apdhlhs3\.xyz|j9af4sr\.guru|67sixcebeh\.surf|stv4ec5\.shop|vg5sgxv\.lol|d9mjs\.sbs|jse8x92s\.me|couhe79\.xyz|xzttyt\.xyz|secdarvin2026\.icu|oreshnik\.top|svo\-zv\.pro|dhsbdgs\.icu|hackersteersman\.digital|coeuzgoq\.bahisbiz\.com|kefavkd\.nextbahis\.sex|d9j\.everunningshoes\.com|nox\.usa\-synadentix\.com|zwa8\.meritbethizligir\.com|355uz90z\.bolnhurstrally\.site|7ulk\.irvinaurus\.fit|pool\.hashvault\.sh|pool\.supportxmr\.com))\.?$"
    | eval data_model="dns", ioc_type="domain", host=src, detail="DNS query ".query
