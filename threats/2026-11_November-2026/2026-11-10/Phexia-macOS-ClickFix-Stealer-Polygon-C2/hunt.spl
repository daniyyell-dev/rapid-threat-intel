``` Phexia: macOS ClickFix Stealer with Polygon C2
    Field names follow CIM/UDM conventions and have not been tested against live data; adjust them to your environment.
    Splunk hunt, CIM data models (tstats). Author: daniyyell-dev. https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-10/Phexia-macOS-ClickFix-Stealer-Polygon-C2
    Sources: https://www.withsecure.com/en/resources-hub/w-labs/phexia-macos-malware/
    Published 2026-11-04. Set the time picker to at least the last 30 days, or back to the earliest activity in the sources.
    The indicators below are live and malicious: do not browse to them.
    Needs these CIM data models populated: Network_Traffic, Network_Resolution, Web, Email. A model with no data simply returns nothing.
    summariesonly=false also reads events the acceleration has not summarised yet. If these data models are
    accelerated, summariesonly=true is much faster but only sees the summary range.
    No CIM? Use hunt_raw.spl with the rti_* macros from all/splunk_macros.conf.
    Output: first_seen, last_seen, ioc, ioc_type, data_model, host, user, src, dest, detail, count ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE All_Traffic.dest_ip IN ("62.60.226.50")
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc_type="ipv4", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE All_Traffic.src_ip IN ("62.60.226.50")
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc_type="ipv4", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Resolution.DNS
        WHERE DNS.query IN ("hf98x4d.site", "*.hf98x4d.site", "apdhlhs3.xyz", "*.apdhlhs3.xyz", "j9af4sr.guru", "*.j9af4sr.guru", "67sixcebeh.surf", "*.67sixcebeh.surf", "stv4ec5.shop", "*.stv4ec5.shop", "vg5sgxv.lol", "*.vg5sgxv.lol", "d9mjs.sbs", "*.d9mjs.sbs", "jse8x92s.me", "*.jse8x92s.me", "couhe79.xyz", "*.couhe79.xyz", "xzttyt.xyz", "*.xzttyt.xyz", "secdarvin2026.icu", "*.secdarvin2026.icu", "oreshnik.top", "*.oreshnik.top", "svo-zv.pro", "*.svo-zv.pro", "dhsbdgs.icu", "*.dhsbdgs.icu", "hackersteersman.digital", "*.hackersteersman.digital", "coeuzgoq.bahisbiz.com", "*.coeuzgoq.bahisbiz.com", "kefavkd.nextbahis.sex", "*.kefavkd.nextbahis.sex", "d9j.everunningshoes.com", "*.d9j.everunningshoes.com", "nox.usa-synadentix.com", "*.nox.usa-synadentix.com", "zwa8.meritbethizligir.com", "*.zwa8.meritbethizligir.com", "355uz90z.bolnhurstrally.site", "*.355uz90z.bolnhurstrally.site", "7ulk.irvinaurus.fit", "*.7ulk.irvinaurus.fit", "pool.hashvault.sh", "*.pool.hashvault.sh", "pool.supportxmr.com", "*.pool.supportxmr.com")
        BY DNS.src DNS.dest DNS.query DNS.reply_code
    | rename "DNS.*" AS *
    | rex field=query "(?i)(?<ioc>(?:hf98x4d\.site|apdhlhs3\.xyz|j9af4sr\.guru|67sixcebeh\.surf|stv4ec5\.shop|vg5sgxv\.lol|d9mjs\.sbs|jse8x92s\.me|couhe79\.xyz|xzttyt\.xyz|secdarvin2026\.icu|oreshnik\.top|svo\-zv\.pro|dhsbdgs\.icu|hackersteersman\.digital|coeuzgoq\.bahisbiz\.com|kefavkd\.nextbahis\.sex|d9j\.everunningshoes\.com|nox\.usa\-synadentix\.com|zwa8\.meritbethizligir\.com|355uz90z\.bolnhurstrally\.site|7ulk\.irvinaurus\.fit|pool\.hashvault\.sh|pool\.supportxmr\.com))\.?$"
    | eval data_model="Network_Resolution", ioc_type="domain", host=src, user="-", detail="DNS query ".query." (".reply_code.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE (Web.url IN ("*://hf98x4d.site*", "*.hf98x4d.site*", "hf98x4d.site*", "*://apdhlhs3.xyz*", "*.apdhlhs3.xyz*", "apdhlhs3.xyz*", "*://j9af4sr.guru*", "*.j9af4sr.guru*", "j9af4sr.guru*", "*://67sixcebeh.surf*", "*.67sixcebeh.surf*", "67sixcebeh.surf*", "*://stv4ec5.shop*", "*.stv4ec5.shop*", "stv4ec5.shop*", "*://vg5sgxv.lol*", "*.vg5sgxv.lol*", "vg5sgxv.lol*", "*://d9mjs.sbs*", "*.d9mjs.sbs*", "d9mjs.sbs*", "*://jse8x92s.me*", "*.jse8x92s.me*", "jse8x92s.me*", "*://couhe79.xyz*", "*.couhe79.xyz*", "couhe79.xyz*", "*://xzttyt.xyz*", "*.xzttyt.xyz*", "xzttyt.xyz*", "*://secdarvin2026.icu*", "*.secdarvin2026.icu*", "secdarvin2026.icu*", "*://oreshnik.top*", "*.oreshnik.top*", "oreshnik.top*", "*://svo-zv.pro*", "*.svo-zv.pro*", "svo-zv.pro*", "*://dhsbdgs.icu*", "*.dhsbdgs.icu*", "dhsbdgs.icu*", "*://hackersteersman.digital*", "*.hackersteersman.digital*", "hackersteersman.digital*", "*://coeuzgoq.bahisbiz.com*", "*.coeuzgoq.bahisbiz.com*", "coeuzgoq.bahisbiz.com*", "*://kefavkd.nextbahis.sex*", "*.kefavkd.nextbahis.sex*", "kefavkd.nextbahis.sex*", "*://d9j.everunningshoes.com*", "*.d9j.everunningshoes.com*", "d9j.everunningshoes.com*", "*://nox.usa-synadentix.com*", "*.nox.usa-synadentix.com*", "nox.usa-synadentix.com*", "*://zwa8.meritbethizligir.com*", "*.zwa8.meritbethizligir.com*", "zwa8.meritbethizligir.com*", "*://355uz90z.bolnhurstrally.site*", "*.355uz90z.bolnhurstrally.site*", "355uz90z.bolnhurstrally.site*", "*://7ulk.irvinaurus.fit*", "*.7ulk.irvinaurus.fit*", "7ulk.irvinaurus.fit*", "*://pool.hashvault.sh*", "*.pool.hashvault.sh*", "pool.hashvault.sh*", "*://pool.supportxmr.com*", "*.pool.supportxmr.com*", "pool.supportxmr.com*") OR Web.dest IN ("hf98x4d.site", "*.hf98x4d.site", "apdhlhs3.xyz", "*.apdhlhs3.xyz", "j9af4sr.guru", "*.j9af4sr.guru", "67sixcebeh.surf", "*.67sixcebeh.surf", "stv4ec5.shop", "*.stv4ec5.shop", "vg5sgxv.lol", "*.vg5sgxv.lol", "d9mjs.sbs", "*.d9mjs.sbs", "jse8x92s.me", "*.jse8x92s.me", "couhe79.xyz", "*.couhe79.xyz", "xzt