        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | rex field=url "(?i)(?<ioc>coeuzgoq\.bahisbiz\.com//update\.sh|62\.60\.226\.50/upload\.php|hf98x4d\.site|apdhlhs3\.xyz|j9af4sr\.guru|67sixcebeh\.surf|stv4ec5\.shop|vg5sgxv\.lol|d9mjs\.sbs|jse8x92s\.me|couhe79\.xyz|xzttyt\.xyz|secdarvin2026\.icu|oreshnik\.top|svo\-zv\.pro|dhsbdgs\.icu|hackersteersman\.digital|coeuzgoq\.bahisbiz\.com|kefavkd\.nextbahis\.sex|d9j\.everunningshoes\.com|nox\.usa\-synadentix\.com|zwa8\.meritbethizligir\.com|355uz90z\.bolnhurstrally\.site|7ulk\.irvinaurus\.fit|pool\.hashvault\.sh|pool\.supportxmr\.com)"
    | eval ioc=coalesce(ioc, dest), data_model="Web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Email.All_Email
        WHERE (All_Email.url IN ("*coeuzgoq.bahisbiz.com//update.sh*", "*62.60.226.50/upload.php*", "*://hf98x4d.site*", "*.hf98x4d.site*", "hf98x4d.site*", "*://apdhlhs3.xyz*", "*.apdhlhs3.xyz*", "apdhlhs3.xyz*", "*://j9af4sr.guru*", "*.j9af4sr.guru*", "j9af4sr.guru*", "*://67sixcebeh.surf*", "*.67sixcebeh.surf*", "67sixcebeh.surf*", "*://stv4ec5.shop*", "*.stv4ec5.shop*", "stv4ec5.shop*", "*://vg5sgxv.lol*", "*.vg5sgxv.lol*", "vg5sgxv.lol*", "*://d9mjs.sbs*", "*.d9mjs.sbs*", "d9mjs.sbs*", "*://jse8x92s.me*", "*.jse8x92s.me*", "jse8x92s.me*", "*://couhe79.xyz*", "*.couhe79.xyz*", "couhe79.xyz*", "*://xzttyt.xyz*", "*.xzttyt.xyz*", "xzttyt.xyz*", "*://secdarvin2026.icu*", "*.secdarvin2026.icu*", "secdarvin2026.icu*", "*://oreshnik.top*", "*.oreshnik.top*", "oreshnik.top*", "*://svo-zv.pro*", "*.svo-zv.pro*", "svo-zv.pro*", "*://dhsbdgs.icu*", "*.dhsbdgs.icu*", "dhsbdgs.icu*", "*://hackersteersman.digital*", "*.hackersteersman.digital*", "hackersteersman.digital*", "*://coeuzgoq.bahisbiz.com*", "*.coeuzgoq.bahisbiz.com*", "coeuzgoq.bahisbiz.com*", "*://kefavkd.nextbahis.sex*", "*.kefavkd.nextbahis.sex*", "kefavkd.nextbahis.sex*", "*://d9j.everunningshoes.com*", "*.d9j.everunningshoes.com*", "d9j.everunningshoes.com*", "*://nox.usa-synadentix.com*", "*.nox.usa-synadentix.com*", "nox.usa-synadentix.com*", "*://zwa8.meritbethizligir.com*", "*.zwa8.meritbethizligir.com*", "zwa8.meritbethizligir.com*", "*://355uz90z.bolnhurstrally.site*", "*.355uz90z.bolnhurstrally.site*", "355uz90z.bolnhurstrally.site*", "*://7ulk.irvinaurus.fit*", "*.7ulk.irvinaurus.fit*", "7ulk.irvinaurus.fit*", "*://pool.hashvault.sh*", "*.pool.hashvault.sh*", "pool.hashvault.sh*", "*://pool.supportxmr.com*", "*.pool.supportxmr.com*", "pool.supportxmr.com*"))
        BY All_Email.src_user All_Email.recipient All_Email.subject All_Email.file_name All_Email.file_hash All_Email.url
    | rename "All_Email.*" AS *
    | eval matched=file_hash." ".url
    | rex field=matched "(?i)(?<ioc>coeuzgoq\.bahisbiz\.com//update\.sh|62\.60\.226\.50/upload\.php|hf98x4d\.site|apdhlhs3\.xyz|j9af4sr\.guru|67sixcebeh\.surf|stv4ec5\.shop|vg5sgxv\.lol|d9mjs\.sbs|jse8x92s\.me|couhe79\.xyz|xzttyt\.xyz|secdarvin2026\.icu|oreshnik\.top|svo\-zv\.pro|dhsbdgs\.icu|hackersteersman\.digital|coeuzgoq\.bahisbiz\.com|kefavkd\.nextbahis\.sex|d9j\.everunningshoes\.com|nox\.usa\-synadentix\.com|zwa8\.meritbethizligir\.com|355uz90z\.bolnhurstrally\.site|7ulk\.irvinaurus\.fit|pool\.hashvault\.sh|pool\.supportxmr\.com)"
    | eval data_model="Email", ioc_type=case(match(ioc, "^[0-9a-fA-F]{64}$"), "sha256", match(ioc, "^[0-9a-fA-F]{40}$"), "sha1", match(ioc, "^[0-9a-fA-F]{32}$"), "md5", match(ioc, "/"), "url", 1==1, "domain"), host="-", user=recipient, src=src_user, dest=recipient, detail="email '".subject."' ".file_name
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count

