``` Threat: BYOD Ransomware and Extortion: Vanderbilt University Attack
    Author: Daniel Jeremiah | Date: 2026-11-10
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel/tree/main/threats/2026-11_November-2026/2026-11-10/BYOD-Ransomware-Vanderbilt-University-Attack ```
| multisearch
  [ search `rti_dns(byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad.onion)`
    | search query IN ("byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad.onion", "*.byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad.onion")
    | rex field=query "(?i)(?<ioc>(?:byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad\.onion))\.?$"
    | eval data_model="dns", ioc_type="domain", host=src, detail="DNS query ".query
  ]
  [ search `rti_web(byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad.onion)`
    | search url IN ("*://byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad.onion*", "*.byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad.onion*", "byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad.onion*") OR dest IN ("byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad.onion", "*.byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad.onion")
    | rex field=url "(?i)(?<ioc>byodxn5s7sua6oyyjj74rycgn6afncfckprt5ezskt3cni6lg3wdrgad\.onion)"
    | eval ioc=coalesce(ioc, dest), data_model="web", ioc_type=if(match(ioc, "/"), "url", "domain"), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
  ]
| fillnull value="-" host user src dest detail
| stats count min(_time) AS first_seen max(_time) AS last_seen BY ioc ioc_type data_model host user src dest detail

| append [
    search `rti_endpoint(README_BYOD_*)`
    | where match(coalesce(file_path, file_name), "(?i)README_BYOD_\d+\.txt$")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="README_BYOD ransom notes", ioc_type="behaviour (alert)"
]

| append [
    search `rti_endpoint(*.byod)`
    | where match(coalesce(file_path, file_name), "(?i)\.byod$")
    | eval host=dest, user=user, src="-", dest=dest, detail=coalesce(file_path, file_name, "-")
    | fillnull value="-" host user src dest detail
    | stats count min(_time) AS first_seen max(_time) AS last_seen BY host user src dest detail
    | eval data_model="endpoint"
    | eval ioc="Mass renames to the .byod extension", ioc_type="behaviour (alert)"
]
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type data_model host user src dest detail count
