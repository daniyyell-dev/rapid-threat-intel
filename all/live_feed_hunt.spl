``` Threat: AI Rapid Threat Intel live feed
    Author: Daniel Jeremiah | Date: 2026-11-11
    Ref: https://github.com/daniyyell-dev/rapid-threat-intel ```
| tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
    FROM datamodel=Network_Traffic.All_Traffic
    WHERE [| inputlookup rti_iocs.csv where type="ipv4" | rename indicator AS All_Traffic.dest_ip | fields All_Traffic.dest_ip]
    BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
| rename "All_Traffic.*" AS *
| eval data_model="Network_Traffic", ioc=dest_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection to IOC, port ".dest_port.", ".action
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Traffic.All_Traffic
        WHERE [| inputlookup rti_iocs.csv where type="ipv4" | rename indicator AS All_Traffic.src_ip | fields All_Traffic.src_ip]
        BY All_Traffic.src_ip All_Traffic.dest_ip All_Traffic.dest_port All_Traffic.action All_Traffic.dvc All_Traffic.user
    | rename "All_Traffic.*" AS *
    | eval data_model="Network_Traffic", ioc=src_ip, host=dvc, src=src_ip, dest=dest_ip, detail="connection from IOC, port ".dest_port.", ".action
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Network_Resolution.DNS
        WHERE [| inputlookup rti_iocs.csv where type="domain" | eval DNS.query=mvappend(indicator, "*.".indicator) | fields DNS.query]
        BY DNS.src DNS.dest DNS.query DNS.reply_code
    | rename "DNS.*" AS *
    | eval data_model="Network_Resolution", ioc=lower(query), host=src, user="-", detail="DNS query ".query." (".reply_code.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Web.Web
        WHERE [| inputlookup rti_iocs.csv where type="domain" OR type="url" | eval Web.url="*".replace(indicator, "^[a-zA-Z][a-zA-Z0-9+.-]*://", "")."*" | fields Web.url]
        BY Web.src Web.user Web.dest Web.url Web.http_user_agent Web.status
    | rename "Web.*" AS *
    | eval data_model="Web", ioc=lower(dest), host=src, detail="HTTP ".status." ".url." UA: ".http_user_agent
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Processes
        WHERE [| inputlookup rti_iocs.csv where type="sha256" OR type="sha1" | eval Processes.process_hash="*".indicator."*" | fields Processes.process_hash]
        BY Processes.dest Processes.user Processes.process_name Processes.process_path Processes.parent_process_name Processes.process_hash
    | rename "Processes.*" AS *
    | eval data_model="Endpoint.Processes", ioc=split(replace(lower(process_hash), "(md5|sha1|sha256|sha512|imphash)=", ""), ","), host=dest, src="-", detail="process ".process_path." (parent ".parent_process_name.")"
]
| append [
    | tstats summariesonly=false fillnull_value="-" count min(_time) AS first_seen max(_time) AS last_seen
        FROM datamodel=Endpoint.Filesystem
        WHERE [| inputlookup rti_iocs.csv where type="sha256" OR type="sha1" | eval Filesystem.file_hash="*".indicator."*" | fields Filesystem.file_hash]
        BY Filesystem.dest Filesystem.user Filesystem.file_path Filesystem.action Filesystem.file_hash
    | rename "Filesystem.*" AS *
    | eval data_model="Endpoint.Filesystem", ioc=split(replace(lower(file_hash), "(md5|sha1|sha256|sha512|imphash)=", ""), ","), host=dest, src="-", detail="file ".action." ".file_path
]
| mvexpand ioc
| eval ioc=trim(ioc)
| lookup rti_iocs.csv indicator AS ioc OUTPUT type AS ioc_type threat
| eval ioc_type=coalesce(ioc_type, if(data_model="Web" OR data_model="Network_Resolution", "domain (subdomain or URL match)", null()))
| where isnotnull(ioc_type)
| eval threat=coalesce(threat, "see all/iocs.csv")
| stats sum(count) AS count min(first_seen) AS first_seen max(last_seen) AS last_seen BY ioc ioc_type threat data_model host user src dest detail
| sort 0 - last_seen
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| table first_seen last_seen ioc ioc_type threat data_model host user src dest detail count
